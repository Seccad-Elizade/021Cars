    /// <summary>
    /// Əvəz maşın seçildikdə dəyərini avtomatik doldurur.
    /// <para>
    /// <b>MAYA DƏYƏRİ</b> götürülür (alış qiyməti + əlavə xərclər) —
    /// satış qiyməti DEYİL. Barter-də maşın əldən çıxır, ona görə düzgün
    /// uçot üçün maşının sizə başa gəldiyi dəyər istifadə olunur.
    /// </para>
    /// </summary>
    private Task OnBarterCarChangedAsync()
    {
        if (_editing?.BarterCarId is not { } id)
        {
            return Task.CompletedTask;
        }

        var candidate = _barterCandidates.FirstOrDefault(c => c.Id == id);
        if (candidate is null)
        {
            return Task.CompletedTask;
        }

        // Həmişə maya dəyəri təklif olunur (istifadəçi istəsə əl ilə dəyişə bilər).
        _editing.BarterDeyeri = candidate.MayaDeyeri;

        return Task.CompletedTask;
    }

    // ------------------------------------------------- ƏVƏZ MAŞIN SEÇİCİSİ ---

    /// <summary>Axtarış mətni dəyişdikcə siyahını süzür (bir-bir azalan variantlar).</summary>
    private void OnBarterSearch(ChangeEventArgs e)
    {
        _barterSearch = e.Value?.ToString() ?? string.Empty;
        ApplyBarterFilter();
    }

    /// <summary>
    /// Yazılan mətnə uyğun maşınları süzür.
    /// <para>
    /// <b>Yalnız</b> marka, dövlət nömrəsi və buraxılış ili üzrə axtarılır.
    /// Uyğun olmayan variantlar siyahıdan <b>tamamilə çıxarılır</b> —
    /// məsələn «lexus» yazıldıqda BMW, Mercedes göstərilmir.
    /// </para>
    /// <para>
    /// Bir neçə söz yazmaq olar («lexus 2015») — hamısı uyğun gəlməlidir.
    /// </para>
    /// </summary>
    private void ApplyBarterFilter()
    {
        var term = (_barterSearch ?? string.Empty).Trim();

        if (term.Length == 0)
        {
            _barterMatches = _barterCandidates.Take(8).ToList();
            return;
        }

        // «lexus 2015», «90-AB-123» kimi girişləri hissələrə ayırır.
        var parts = term
            .Split(new[] { ' ', ',', '-', '/', '.', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Trim())
            .Where(p => p.Length > 0)
            .ToList();

        _barterMatches = _barterCandidates
            // HƏR hissə uyğun gəlməlidir (AND məntiqi).
            .Where(c => parts.All(p => MatchesTerm(c, p)))
            // Əvvəlcə adı yazılan mətnlə BAŞLAYANLAR.
            .OrderByDescending(c => c.DisplayName.StartsWith(term, StringComparison.OrdinalIgnoreCase))
            .ThenBy(c => c.Marka.StartsWith(term, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(c => c.SiraNomresi)
            .ThenBy(c => c.Id)
            .Take(12)
            .ToList();
    }

    /// <summary>
    /// Bu maşın verilmiş sözü ehtiva edirmi?
    /// Yalnız marka, dövlət nömrəsi və il — VIN və yanacaq axtarılmır
    /// (təsadüfi uyğunluqların qarşısını alır).
    /// </summary>
    private static bool MatchesTerm(CarItem car, string part)
        => HasText(car.Marka, part)
           || HasText(car.QeydiyyatNisani, part)
           || car.Il.ToString().Contains(part, StringComparison.Ordinal);

    /// <summary>Əvəz maşını seçir və dəyərini avtomatik doldurur.</summary>
    private async Task PickBarterCarAsync(CarItem candidate)
    {
        if (_editing is null)
        {
            return;
        }

        _editing.BarterCarId = candidate.Id;
        _barterSearch = candidate.DisplayName;

        await OnBarterCarChangedAsync();
        ApplyBarterFilter();
    }

    /// <summary>Seçimi ləğv edir.</summary>
    private void ClearBarterCar()
    {
        if (_editing is null)
        {
            return;
        }

        _editing.BarterCarId = null;
        _barterSearch = string.Empty;
        ApplyBarterFilter();
    }

    /// <summary>
    /// Hesablama panelində bir sətir: əməliyyat işarəsi + ad + dəyər.
    /// </summary>
    /// <param name="op">«+», «−» və ya «=».</param>
    private static MarkupString CalcRow(string label, string value, string op, bool strong = false)
    {
        var open = strong ? "<b>" : string.Empty;
        var close = strong ? "</b>" : string.Empty;

        var color = op switch
        {
            "−" => "#f87171",
            "=" => "#f59e0b",
            _ => "#94a3b8"
        };

        return new MarkupString(
            "<div style=\"display:flex;align-items:baseline;gap:10px;padding:6px 0;font-size:12.5px\">" +
            "<span style=\"color:" + color + ";font-weight:700;width:14px;text-align:center\">" +
            System.Net.WebUtility.HtmlEncode(op) + "</span>" +
            "<span style=\"color:#94a3b8;flex:1\">" + System.Net.WebUtility.HtmlEncode(label) + "</span>" +
            "<span style=\"text-align:right;white-space:nowrap\">" + open +
            System.Net.WebUtility.HtmlEncode(value) + close + "</span></div>");
    }

    /// <summary>Hesablama panelində ayırıcı xətt (cəm xətti).</summary>
    private static MarkupString CalcDivider()
        => new("<div style=\"height:1px;background:rgba(148,163,184,.35);margin:6px 0 6px 24px\"></div>");

    private static bool HasText(string? value, string term)
        => !string.IsNullOrEmpty(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Barter üçün seçilə bilən maşınları yükləyir. Hazırda seçilmiş maşın
    /// siyahıda yoxdursa (məs. artıq başqa alışda verilibsə) yenə əlavə olunur ki,
    /// mövcud seçim itməsin.
    /// </summary>
    private async Task LoadBarterCandidatesAsync()
    {
        if (_editing is null)
        {
            _barterCandidates = new List<CarItem>();
            return;
        }

        var excludeId = _editing.Id > 0 ? _editing.Id : (int?)null;
        var list = (await CarService.GetBarterCandidatesAsync(excludeId)).ToList();

        if (_editing.BarterCarId is { } current && list.All(c => c.Id != current))
        {
            var all = await CarService.GetAllCarsAsync();
            var existing = all.FirstOrDefault(c => c.Id == current);
            if (existing is not null)
            {
                list.Insert(0, existing);
            }
        }

        _barterCandidates = list;
        _barterSearch = SelectedBarterCar?.DisplayName ?? string.Empty;
        ApplyBarterFilter();
    }

    private void AskDelete(CarItem car) => _deleting = car;

    private async Task SaveAsync()
    {
        if (_editing is null)
        {
            return;
        }

        _saving = true;
        _formError = null;

        try
        {
            var registration = _editing.QeydiyyatNisani.Trim();

            var duplicate = await CarService.RegistrationExistsAsync(
                registration,
                _editing.Id == 0 ? null : _editing.Id);

            if (duplicate)
            {
                _formError = $"\"{registration}\" nömrəli avtomobil artıq sistemdə mövcuddur.";
                return;
            }

            var payload = BuildCar(_editing);

            if (_editing.Id == 0)
            {
                await CarService.AddCarAsync(payload);
                Ui.Success($"\"{payload.Marka}\" avtomobili əlavə edildi.");
            }
            else
            {
                await CarService.UpdateCarAsync(payload);
                Ui.Success($"\"{payload.Marka}\" məlumatları yeniləndi.");
            }

            _editing = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
            Ui.Error("Yadda saxlana bilmədi: " + ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Formadan <see cref="CarItem"/> yaradır (xidmət yalnız skalyar sahələri oxuyur).</summary>
    private static CarItem BuildCar(CarForm form) => new()
    {
        Id = form.Id,
        Marka = form.Marka.Trim(),
        QeydiyyatNisani = form.QeydiyyatNisani.Trim(),
        Vin = form.Vin?.Trim() ?? string.Empty,
        Il = form.Il,
        Yurus = form.Yurus,
        Yanacaq = form.Yanacaq,
        AlisTarixi = form.AlisTarixi,
        AlisSaati = form.AlisSaati?.Trim() ?? string.Empty,
        AlisUsulu = form.AlisUsulu,
        BarterTesviri = form.BarterTesviri?.Trim() ?? string.Empty,
        BarterCarId = form.BarterCarId,
        BarterDeyeri = form.BarterDeyeri,
        BarterSaleId = form.BarterSaleId,
        AlisQiymeti = form.AlisQiymeti,
        SatisQiymeti = form.SatisQiymeti,
        Status = form.Status,
        KreditNomresi = form.KreditNomresi?.Trim() ?? string.Empty,
        SiraNomresi = form.SiraNomresi
    };

    private async Task DeleteAsync()
    {
        if (_deleting is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var name = _deleting.DisplayName;
            await CarService.DeleteCarAsync(_deleting.Id);
            _deleting = null;
            Ui.Success($"\"{name}\" silindi.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Ui.Error("Silinə bilmədi: " + ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Redaktə forması — DataAnnotations ilə doğrulanan müvəqqəti model.</summary>
    private sealed class CarForm
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Marka / model tələb olunur.")]
        [MaxLength(120, ErrorMessage = "Marka 120 simvoldan çox ola bilməz.")]
        public string Marka { get; set; } = string.Empty;

        [Required(ErrorMessage = "Dövlət nömrəsi tələb olunur.")]
        [MaxLength(20, ErrorMessage = "Nömrə 20 simvoldan çox ola bilməz.")]
        public string QeydiyyatNisani { get; set; } = string.Empty;

        [MaxLength(30, ErrorMessage = "VIN 30 simvoldan çox ola bilməz.")]
        public string? Vin { get; set; } = string.Empty;

        [Range(1900, 2100, ErrorMessage = "İl 1900–2100 aralığında olmalıdır.")]
        public int Il { get; set; } = DateTime.Today.Year;

        [Range(0, 9_999_999, ErrorMessage = "Yürüş mənfi ola bilməz.")]
        public int Yurus { get; set; }

        public string Yanacaq { get; set; } = "Benzin";

        public DateTime? AlisTarixi { get; set; } = DateTime.Today;

        [MaxLength(10)]
        public string? AlisSaati { get; set; } = "12:00";

        public string AlisUsulu { get; set; } = "Nağd";

        [MaxLength(300, ErrorMessage = "Barter təsviri 300 simvoldan çox ola bilməz.")]
        public string? BarterTesviri { get; set; } = string.Empty;

        /// <summary>Barter üçün avto parkdan verilən avtomobilin Id-si.</summary>
        public int? BarterCarId { get; set; }

        /// <summary>Barter satışından gələn maşındırsa, həmin satışın Id-si.</summary>
        public int? BarterSaleId { get; set; }

        [Range(typeof(decimal), "0", "999999999", ErrorMessage = "Barter dəyəri mənfi ola bilməz.")]
        public decimal BarterDeyeri { get; set; }

        [Range(typeof(decimal), "0", "999999999", ErrorMessage = "Alış qiyməti mənfi ola bilməz.")]
        public decimal AlisQiymeti { get; set; }

        [Range(typeof(decimal), "0", "999999999", ErrorMessage = "Satış qiyməti mənfi ola bilməz.")]
        public decimal SatisQiymeti { get; set; }

        public string Status { get; set; } = "Stokda";

        [MaxLength(60)]
        public string? KreditNomresi { get; set; } = string.Empty;

        [Range(0, 9999, ErrorMessage = "Sıra nömrəsi 0–9999 aralığında olmalıdır.")]
        public int SiraNomresi { get; set; }
    }


