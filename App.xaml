<Application x:Class="EnterpriseAeroStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EnterpriseAeroStudio.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:StringToVisibilityConverter x:Key="StrToVis"/>
            <conv:AzCurrencyConverter x:Key="Currency"/>
            <conv:InverseBooleanConverter x:Key="InverseBool"/>

            <!-- ============================================================
                 🌊 ÜMUMİ SMOOTH SCROLL + 👆 TOUCH (barmaq) SÜRÜŞDÜRMƏ
                 ============================================================
                 ⚠⚠ MÜHÜM DÜZƏLİŞ (PERFORMANS — «DONMA» XƏSTƏLİYİNİN KÖKÜ) ⚠⚠
                 ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
                 ƏVVƏL burada `<Setter Property="CanContentScroll" Value="False"/>`
                 var idi ✗ → bu QAYDA CƏDVƏLLƏRİN (DataGrid) DAXİLİ
                 ScrollViewer-inə də tətbiq olunurdu ✗ →
                 WPF sətir virtualizasiyası SÖNÜRDÜ ✗ →
                 10 000+ sətirli cədvəldə proqram DONURDU ✗✓✓

                 ✅ İNDİ: setter SİLİNDİ ✓
                 • Adi ScrollViewer-lər üçün `CanContentScroll` onsuz da
                   default olaraq `False`-dur ✓ → piksel-piksel hamar sürüşmə
                   DAVAM EDİR ✓ (heç nə dəyişmədi ✓)
                 • DataGrid-in daxili ScrollViewer-i isə öz default dəyərini
                   (`True`) saxlayır ✓ → VİRTUALİZASİYA İŞLƏYİR ✓✓✓
                 ============================================================ -->
            <Style TargetType="ScrollViewer">
                <Setter Property="PanningMode" Value="Both"/>
                <Setter Property="PanningDeceleration" Value="0.001"/>
                <Setter Property="PanningRatio" Value="1"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="IsManipulationEnabled" Value="True"/>
            </Style>

            <!-- ============================================================
                 👆 CƏDVƏLLƏR (DataGrid / ListView) — TOUCH ilə TAM sürüşmə
                 DataGrid öz daxilində ScrollViewer saxlayır; bu stil həmin
                 daxili ScrollViewer-ə də tətbiq olunur.
                 ============================================================ -->
            <Style x:Key="TouchScrollViewer" TargetType="ScrollViewer">
                <Setter Property="CanContentScroll" Value="False"/>
                <Setter Property="PanningMode" Value="Both"/>
                <Setter Property="PanningDeceleration" Value="0.001"/>
                <Setter Property="PanningRatio" Value="1"/>
                <Setter Property="IsManipulationEnabled" Value="True"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
