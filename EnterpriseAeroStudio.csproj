<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>EnterpriseAeroStudio</RootNamespace>
    <AssemblyName>EnterpriseAeroStudio</AssemblyName>
    <ApplicationTitle>Avtomobil Parkı v6.2</ApplicationTitle>
    <Version>6.2.82</Version>

    <!-- ======================================================================
         🖼️ PROQRAM İKONU (021 CARS ✓✓✓)
         → Resources\021Cars.ico  (çoxölçülü: 16·24·32·48·64·128·256 ✓)
         Bu ikon EnterpriseAeroStudio.exe faylının İÇİNƏ yazılır ✓ →
         masaüstü qısayolu · tapşırıq paneli · Alt+Tab · Explorer
         hamısı 021 CARS logosunu göstərir ✓✓✓
         ====================================================================== -->
    <ApplicationIcon>Resources\021Cars.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- ======================================================================
       🖼️ LOQO — WPF RESURS KİMİ ✓✓✓
       → «Giriş» pəncərəsində loqo göstərilir ✓
         (Source="/Resources/021Cars.png" ✓)
       ⚠ Element <ItemGroup> İÇİNDƏDİR ✗ — PropertyGroup-da olsa MSB4066 xətası ✗✓
       ====================================================================== -->
  <ItemGroup>
    <Resource Include="Resources\021Cars.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!--
    ============================================================================
    VEB ALTLAYİHƏSİ XARİC EDİLİR
    ============================================================================
    "Web" qovluğunda ayrıca ASP.NET Core layihəsi (Autocode.Web) yerləşir.
    SDK-nın avtomatik fayl qlobları onu da bu layihəyə daxil edərdi —
    ona görə açıq şəkildə çıxarılır.
  -->
  <ItemGroup>
    <Compile Remove="Web\**" />
    <None Remove="Web\**" />
    <Content Remove="Web\**" />
    <EmbeddedResource Remove="Web\**" />
    <Page Remove="Web\**" />
    <ApplicationDefinition Remove="Web\**" />
    <Resource Remove="Web\**" />
  </ItemGroup>

  <!--
    ============================================================================
    VEB LAYİHƏSİ İLƏ ƏLAQƏ  —  ⛔ v6.2.86: AYRILDI ✓✓✓
    ============================================================================
    ⚠ ƏVVƏL: `<ProjectReference Include="Web\Autocode.Web.csproj">` var idi ✗ →
      masaüstü tətbiqi build olunanda VEB layihəsi də build olunurdu ✗ →
      **veb server işləyərkən** (`EnterpriseAeroStudio.Web.exe` prosesi açıq ✓)
      onun .exe faylı KİLİDLƏNİRDİ ✗ →
      `dotnet run` / `dotnet build` belə XƏTA verirdi:
        «MSB3027: Could not copy … EnterpriseAeroStudio.Web.exe …
         The file is locked by: EnterpriseAeroStudio.Web (33132)» ✗✓✓

    ✅ İNDİ: MASAÜSTÜ LAYİHƏSİ VEB LAYİHƏSİNƏ **HEÇ BİR ASILI DEYİL** ✗✓✓
      • `dotnet run`      → YALNIZ masaüstü tətbiqini build edir ✓ (kilid problemi YOX ✗)
      • Veb tətbiq AYRICA build/publish olunur ✓:
            dotnet build  Web\Autocode.Web.csproj
            (və ya quraşdırıcı: Docs\Qurasdirma\Installer\Yig-Installer.ps1 ✓
             — o, veb layihəsini ÖZÜ ayrıca publish edir ✓)

    ℹ️ Veb server prosesi masaüstü tətbiq tərəfindən avtomatik işə salınır ✓
       (`WebServerService` → `Web\bin\...\EnterpriseAeroStudio.Web.exe`) —
       bu əlaqə RUNTIME-dadır ✓, build asılılığı DEYİL ✓

    🔧 LAZIM OLARSA veb layihəni DƏ BİR BUILD-DƏ yığmaq üçün (könüllü ✓):
          dotnet build -p:BuildWebApp=true
       (yalnız o halda aşağıdaki ProjectReference işə düşür ✓ —
        veb server BAĞLI deyilsə işləyir ✓, bağlıdırsa əvvəlcə proqramı bağlayın ✗)
    ============================================================================
  -->

  <ItemGroup Condition="'$(BuildWebApp)' == 'true'">
    <ProjectReference Include="Web\Autocode.Web.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>


  <!-- 📦 Quraşdırıcı layihəsi ƏSAS TƏTBİQƏ DAXİL EDİLMİR ✗ (ayrı .exe-dir ✓) -->
  <ItemGroup>
    <Compile Remove="Docs\Qurasdirma\**" />
    <Page Remove="Docs\Qurasdirma\**" />
    <ApplicationDefinition Remove="Docs\Qurasdirma\**" />
    <None Remove="Docs\Qurasdirma\**" />
  </ItemGroup>

</Project>
