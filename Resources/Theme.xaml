<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================== -->
    <!--  🎨 DİZAYN SİSTEMİ — «Graphite & Indigo»  (v6.2.44)                   -->
    <!--  Yalnız GÖRÜNÜŞ: rəng · şrift · forma · kölgə ✓                       -->
    <!--  Funksiya · məntiq · element adları DƏYİŞMİR ✗✓                       -->
    <!-- ==================================================================== -->

    <!-- 🔤 ŞRİFTLƏR — Windows 11: «Segoe UI Variable» · köhnə sistem: «Segoe UI» ✓
         (hər ikisi ekranda yumşaq və yorucu olmayan oxunuş verir ✓) -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- 🌫️ KÖLGƏLƏR — daha yumşaq, daha dərin ✓ (sərt qara kənar YOX ✗) -->
    <DropShadowEffect x:Key="GlassShadow" BlurRadius="30" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.42"/>
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.30"/>
    <DropShadowEffect x:Key="ActiveGlow" BlurRadius="18" ShadowDepth="0" Color="#4C7DFF" Opacity="0.34"/>

    <!-- ==================== KART ==================== -->
    <!-- Zərif qradiyent fon + yumşaq kölgə (düz rəng yerinə ✗→✓ «dərinlik» ✓) -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="#202D3C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#182230" Offset="0"/>
                    <GradientStop Color="#131C26" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!--  🌿 ZƏRİF STATİSTİKA KARTLARI — v6.2.46 ✓✓✓                          -->
    <!--  ⚠ ƏVVƏL: 46 kartın ətrafında TAM DOYĞUN rəngli haşiyə ✗             -->
    <!--     («yol nişanı» effekti ✗ → göz yorulur ✗)                          -->
    <!--  ✅ İNDİ: çox zəif rəngli fon tonu + yumşaq tonlu haşiyə ✓            -->
    <!--     → rəng kimliyi QALIR ✓ (yaşıl · mavi · qızılı · bənövşəyi ✓)      -->
    <!--     → sakit, dərin, peşəkar görünüş ✓✓✓                               -->
    <!-- ==================================================================== -->
    <Style x:Key="KartYasil" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#1E4634"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#12251C" Offset="0"/>
                    <GradientStop Color="#101B19" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KartMavi" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#24406F"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#141F33" Offset="0"/>
                    <GradientStop Color="#101823" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KartQizili" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#4A3A16"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#241E10" Offset="0"/>
                    <GradientStop Color="#1A1712" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KartQiziliAc" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#4A3F16"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#241F10" Offset="0"/>
                    <GradientStop Color="#1A1812" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KartFiruzeyi" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#1B4451"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#10232A" Offset="0"/>
                    <GradientStop Color="#0F1A20" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KartGoyAc" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#1F4459"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#12202A" Offset="0"/>
                    <GradientStop Color="#101A20" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!--  🌿 CƏDVƏL KƏNAR ZOLAĞI + SCROLLBAR — v6.2.46 ✓✓✓                    -->
    <!--  ⚠ ƏVVƏL: sətir başlığı zolağı və scrollbar AÇIQ RƏNGLİ idi ✗        -->
    <!--     (qaranlıq interfeysdə ağ zolaq ✗ → gözü yorur ✗)                  -->
    <!--  ✅ İNDİ: tünd, nazik, temaya uyğun ✓✓✓                               -->
    <!-- ==================================================================== -->
    <Style TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="#141D28"/>
        <Setter Property="Foreground" Value="#8798AD"/>
        <Setter Property="BorderBrush" Value="#2B3949"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumb" CornerRadius="4" Background="#33455A" Margin="3,2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="#46607D"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="#5C8CFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== İPUCU (TOOLTIP) ==================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#1B2634"/>
        <Setter Property="Foreground" Value="#DFE7F0"/>
        <Setter Property="BorderBrush" Value="#2E3D4E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
    </Style>

    <Style x:Key="KartBenovseyi" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#382A5C"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1D1730" Offset="0"/>
                    <GradientStop Color="#15121F" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KartQirmizi" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#4C2226"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#261314" Offset="0"/>
                    <GradientStop Color="#1B1113" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KartCehrayi" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#48222B"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#241318" Offset="0"/>
                    <GradientStop Color="#1A1114" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KartPembe" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#4E2140"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#26131E" Offset="0"/>
                    <GradientStop Color="#1B1116" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KartNarinci" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#4A3018"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#241A10" Offset="0"/>
                    <GradientStop Color="#1A1512" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KartYasilAc" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="#1E4631"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#12251A" Offset="0"/>
                    <GradientStop Color="#101B17" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SEÇİM QUTUSU (CHECKBOX) ==================== -->
    <!-- Peşəkar, temaya uyğun ✓ (əvvəl Windows-un açıq rəngli default-u idi ✗) -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#C6D2E0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="qutu" Width="18" Height="18" CornerRadius="5"
                                Background="#202D3C" BorderBrush="#3A4A5C" BorderThickness="1.2"
                                VerticalAlignment="Center">
                            <Path x:Name="isare" Data="M 3.2 8.2 L 6.6 11.6 L 12.8 4.6"
                                  Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" Margin="1"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="qutu" Property="Background" Value="#4C7DFF"/>
                            <Setter TargetName="qutu" Property="BorderBrush" Value="#6E97FF"/>
                            <Setter TargetName="isare" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="qutu" Property="BorderBrush" Value="#5C8CFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== COMBOBOX ITEM ==================== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#DCE5EF"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3B66E8"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4C7DFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== COMBOBOX ==================== -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#F3F7FB"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="MainGrid">
                        <Border x:Name="border" Background="#202D3C" BorderBrush="#2E3D4E" BorderThickness="1" CornerRadius="8"/>

                        <ToggleButton x:Name="toggleButton" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Məzmun qatı toggle düyməsinin ÜSTÜNDƏ yerləşir.
                             PART_EditableTextBox mütləqdir: yoxdursa IsEditable=True olan
                             ComboBox düzgün render olunmur (qara görünür). -->
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextBlock.Foreground="#F3F7FB"/>
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed"
                                     Background="Transparent" BorderThickness="0" Foreground="#F3F7FB"
                                     CaretBrush="#5C8CFF" VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     Style="{x:Null}"/>
                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A6B4C4" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                        </Grid>

                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <!-- Popup üzərində DropShadowEffect/PopupAnimation istifadə edilmir —
                                 bəzi GPU/driver kombinasiyalarında şəffaf popup "qara" render olunur. -->
                            <Border x:Name="DropDown" Background="#1B2634" BorderBrush="#5C8CFF" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <ScrollViewer SnapsToDevicePixels="True" MaxHeight="280">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#5C8CFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TEXTBOX ==================== -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Foreground" Value="#F3F7FB"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="#5C8CFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="#202D3C" BorderBrush="#2E3D4E" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="2,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#5C8CFF"/>
                            <Setter TargetName="bd" Property="Background" Value="#121A26"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#F05E5E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== DATEPICKER ==================== -->
    <!-- ==================================================================== -->
    <!--  📅 TARİX SAHƏSİ — v6.2.46 ✓✓✓                                      -->
    <!--  ⚠ ƏVVƏL: DatePicker-in İÇİNDƏKİ qutu AÇIQ RƏNGLİ haşiyə çəkirdi ✗   -->
    <!--     (qaranlıq interfeysdə ağ çərçivə ✗ → çox gözə batır ✗)            -->
    <!--  ✅ İNDİ: öz şablonu ✓ — tam şəffaf, haşiyəsiz, temaya uyğun ✓✓✓      -->
    <!-- ==================================================================== -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F3F7FB"/>
        <Setter Property="CaretBrush" Value="#5C8CFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                                      BorderThickness="0" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Background="#202D3C" BorderBrush="#2E3D4E" BorderThickness="1" CornerRadius="10" Padding="6,0">
                        <DatePickerTextBox x:Name="PART_TextBox" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Focusable="{TemplateBinding Focusable}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== DÜYMƏ ==================== -->
    <Style TargetType="Button" x:Key="iOSButton">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Standart fon/mətn ✓ — Background yazılmayan düymələr də temaya uyğun olsun ✓ -->
        <Setter Property="Background" Value="#1B2634"/>
        <Setter Property="Foreground" Value="#DFE7F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- ============================================================
                         🌿 YUMŞAQ DÜYMƏ («soft») — v6.2.46 ✓✓✓
                         ⚠ ƏVVƏL: rəng TAM gücdə doldurulurdu ✗
                            → ekranda 5-6 neon rəngli düymə yan-yana ✗
                            → göz yorulurdu ✗ və «yol nişanı» effekti yaranırdı ✗
                         ✅ İNDİ: tünd baza + rəngin ~20% tonu + həmin rəngdə 1px haşiyə ✓
                            → rəng kimliyi QALIR ✓ (yaşıl = əlavə et · qırmızı = sil ✓)
                            → parıltı YOX ✗ → sakit, peşəkar görünüş ✓✓✓
                         ============================================================ -->
                    <Grid>
                        <Border x:Name="btnBorder" Background="#141E29" CornerRadius="10"
                                BorderBrush="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="tint" Background="{TemplateBinding Background}"
                                Opacity="0.20" CornerRadius="10"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tint" Property="Opacity" Value="0.34"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tint" Property="Opacity" Value="0.46"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.40"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!--  🚀 ƏSAS DÜYMƏ («primary») — v6.2.46 ✓✓✓                             -->
    <!--  ⚠ MÜTLƏQ «iOSButton»-dan SONRA olmalıdır ✗✓ — BasedOn irəli         -->
    <!--     istinad edə BİLMƏZ ✗ (yoxsa proqram açılarkən çökür ✗✓✓)           -->
    <!-- ==================================================================== -->
    <Style x:Key="iOSButtonEsas" TargetType="Button" BasedOn="{StaticResource iOSButton}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="btnBorder" Background="#12251C" CornerRadius="10"
                                BorderBrush="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#22B981" Opacity="0.22"/>
                            </Border.Effect>
                        </Border>
                        <Border Background="{TemplateBinding Background}" Opacity="0.34" CornerRadius="10"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#16301F"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.40"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TABITEM ==================== -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#AFC0D2"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- ============================================================
                         💧 «LIQUID GLASS» TAB — v6.2.50 ✓✓✓
                         ✅ ŞƏFFAF şüşə qatı (alpha qradiyent ✓) + 1px işıq haşiyə ✓
                            + üstdə şüşə əksi (specular) xətti ✓
                            + seçilmişdə mavi şüşə + yumşaq parıltı ✓✓✓
                         ============================================================ -->
                    <Grid Margin="3,2">
                        <!-- 🫧 ŞÜŞƏ QATI -->
                        <Border x:Name="Suse" CornerRadius="12" BorderThickness="1"
                                BorderBrush="#26FFFFFF" Padding="14,8.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#14FFFFFF" Offset="0"/>
                                    <GradientStop Color="#05000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center"
                                              HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>

                        <!-- ✨ ÜST İŞIQ XƏTTİ (şüşə əksi ✓ — yalnız seçilmiş/hover ✓) -->
                        <Border x:Name="Isiq" Height="1" Margin="15,1.6" VerticalAlignment="Top"
                                CornerRadius="1" Background="#6EFFFFFF" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Suse" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#24FFFFFF" Offset="0"/>
                                        <GradientStop Color="#0AFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Suse" Property="BorderBrush" Value="#3DFFFFFF"/>
                            <Setter TargetName="Isiq" Property="Opacity" Value="0.35"/>
                            <Setter Property="Foreground" Value="#E8EFF7"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Suse" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6B5C8CFF" Offset="0"/>
                                        <GradientStop Color="#405C8CFF" Offset="0.45"/>
                                        <GradientStop Color="#303B66E8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Suse" Property="BorderBrush" Value="#8CBFD3FF"/>
                            <Setter TargetName="Suse" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                                      Color="#4C7DFF" Opacity="0.50"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Isiq" Property="Opacity" Value="0.75"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== DATAGRID ==================== -->
    <!--
        🚀 PERFORMANS (MİLYON SƏTİR) ✓✓✓
        ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
        ⚠ ƏVVƏL: cədvəllər XARİCİ bir ScrollViewer (CanContentScroll=False)
        içində idi ✗ → DataGrid sonsuz hündürlük alırdı ✗ → WPF
        virtualizasiyanı SÖNDÜRÜRDÜ ✗ → 10 000+ sətirdə proqram DONURDU ✗✓✓

        ✅ İNDİ: virtualizasiya AÇIQDIR ✓ — ekranda görünən ~30 sətir çəkilir,
        qalan minlərlə/milyonlarla sətir yalnız scroll edildikcə yaranır ✓
        (VirtualizationMode=Recycling → hüceyrələr təkrar istifadə olunur ✓)
        ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
    -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="#141D28"/>
        <!-- Zərif zebra ✓ — cədvəl sətirləri arasında fərq azdır (göz yorulmasın ✓) -->
        <Setter Property="AlternatingRowBackground" Value="#19232F"/>
        <Setter Property="Foreground" Value="#E8EFF7"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#2E3D4E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>

        <!-- ================================================================ -->
        <!--  📐 v6.2.51 — OXUNAQLIQ: sütunlar ƏN AZI 85px ✓✓✓                -->
        <!--  ⚠ ƏVVƏL: MinColumnWidth yox idi ✗ → sütunlar 10px-ə daralırdı ✗  -->
        <!--     → başlıqlar və mətn GÖRÜNMÜRDÜ ✗✓✓                            -->
        <!--  ✅ İNDİ: dar sütun yoxdur ✓ · sığmayan → üfüqi scrollbar ✓       -->
        <!-- ================================================================ -->
        <Setter Property="MinColumnWidth" Value="34"/>
        <!-- ================================================================ -->
        <!--  ↔️ v6.2.52 — SÜTUN ÖLÇÜSÜ DƏYİŞMƏ ✓✓✓                            -->
        <!--  ⚠ ƏVVƏL: RowHeight/ColumnHeaderHeight SABİT idi ✗ → başlıqlar     -->
        <!--     avtomatik uzanmırdı ✗ və sütun sürüşdürmə işləmirdi ✗         -->
        <!--  ✅ İNDİ: hündürlük AVTOMATİK ✓ (qısa başlıq → kiçik ✓,            -->
        <!--     uzun başlıq → 2 sətir ✓) · sütun kənarından TUTUB DƏYİŞMƏK ✓  -->
        <!-- ================================================================ -->
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserResizeRows" Value="True"/>
        <!-- ✅ v6.2.52 — Sütun eni AVTOMATİK: başlıq + ən uzun məzmuna görə ✓✓✓
             ⚠ Ulduzlu (Width="*") sütunlar NƏ avtomatik uyğunlaşır ✗,
             NƏ də siçanla ölçüsü dəyişir ✗ → hamısı Auto edildi ✓ -->
        <Setter Property="ColumnWidth" Value="Auto"/>
        <!-- ⚠ ColumnWidth (Auto/*) QLOBAL verilmir ✗ — versək DataGrid hər
             layout-da enləri yenidən hesablayır ✗ və istifadəçinin sürüşdürdüyü
             en LƏĞV OLUNUR ✗✓✓ → sütun ölçüsü dəyişmirdi ✗ -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

        <!-- 🚀 VİRTUALİZASİYA ✓ (donmanın qarşısı ✓) -->
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="VirtualizingPanel.CacheLength" Value="1"/>
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <!-- Zərif qradiyent başlıq ✓ — düz rəng yerinə (peşəkar «panel» görünüşü ✓) -->
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E2A38" Offset="0"/>
                    <GradientStop Color="#18222E" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#C7D4E2"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="BorderBrush" Value="#2B3949"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <!-- Başlıqlar sıxıldıqda kəsilməsin, sətirə keçsin -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="12.5" FontWeight="Bold" LineHeight="15"
                               TextOptions.TextFormattingMode="Display"
                               VerticalAlignment="Center" Foreground="#C7D4E2"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ==================================================================== -->
    <!--  📊 SƏTİR ÜSLUBU (DataGridRow) — v6.2.51 ✓                           -->
    <!--  ⚠ ƏVVƏL: sətir hündürlüyü yox idi ✗ → mətn şaquli kəsilirdi ✗       -->
    <!-- ==================================================================== -->
    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1F2C3A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="#E8EFF7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#3B66E8"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Cədvəl hüceyrələrində mətnin ortalanması üçün -->
    <Style x:Key="GridCellText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0"/>
        <!-- 🔢 Rəqəmlər alt-alta TAM DÜZ ✓ (məbləğ/tarix sütunları səliqəli görünür ✓) -->
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="GridCellTextBox" TargetType="TextBox">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
