<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DropShadowEffect x:Key="GlassShadow" BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
    <DropShadowEffect x:Key="ActiveGlow" BlurRadius="12" ShadowDepth="0" Color="#2563EB" Opacity="0.3"/>

    <!-- ==================== KART ==================== -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="#111827"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="#1F2937"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
    </Style>

    <!-- ==================== COMBOBOX ITEM ==================== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#E2E8F0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== COMBOBOX ==================== -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="MainGrid">
                        <Border x:Name="border" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8"/>

                        <ToggleButton x:Name="toggleButton" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Məzmun qatı toggle düyməsinin ÜSTÜNDƏ yerləşir.
                             PART_EditableTextBox mütləqdir: yoxdursa IsEditable=True olan
                             ComboBox düzgün render olunmur (qara görünür). -->
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextBlock.Foreground="#F8FAFC"/>
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed"
                                     Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                                     CaretBrush="#3B82F6" VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     Style="{x:Null}"/>
                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#9CA3AF" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                        </Grid>

                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <!-- Popup üzərində DropShadowEffect/PopupAnimation istifadə edilmir —
                                 bəzi GPU/driver kombinasiyalarında şəffaf popup "qara" render olunur. -->
                            <Border x:Name="DropDown" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <ScrollViewer SnapsToDevicePixels="True" MaxHeight="280">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TEXTBOX ==================== -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="#3B82F6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="2,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                            <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#EF4444"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== DATEPICKER ==================== -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="6,0">
                        <DatePickerTextBox x:Name="PART_TextBox" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Focusable="{TemplateBinding Focusable}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== DÜYMƏ ==================== -->
    <Style TargetType="Button" x:Key="iOSButton">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TABITEM ==================== -->
    <Style TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Border" CornerRadius="8" Background="Transparent" Padding="16,10" Margin="3,0">
                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Border" Property="Effect" Value="{StaticResource ActiveGlow}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== DATAGRID ==================== -->
    <!--
        🚀 PERFORMANS (MİLYON SƏTİR) ✓✓✓
        ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
        ⚠ ƏVVƏL: cədvəllər XARİCİ bir ScrollViewer (CanContentScroll=False)
        içində idi ✗ → DataGrid sonsuz hündürlük alırdı ✗ → WPF
        virtualizasiyanı SÖNDÜRÜRDÜ ✗ → 10 000+ sətirdə proqram DONURDU ✗✓✓

        ✅ İNDİ: virtualizasiya AÇIQDIR ✓ — ekranda görünən ~30 sətir çəkilir,
        qalan minlərlə/milyonlarla sətir yalnız scroll edildikcə yaranır ✓
        (VirtualizationMode=Recycling → hüceyrələr təkrar istifadə olunur ✓)
        ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
    -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="#111827"/>
        <Setter Property="AlternatingRowBackground" Value="#1F2937"/>
        <Setter Property="Foreground" Value="#F9FAFB"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#374151"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>

        <!-- 🚀 VİRTUALİZASİYA ✓ (donmanın qarşısı ✓) -->
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="VirtualizingPanel.CacheLength" Value="1"/>
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#1F2937"/>
        <Setter Property="Foreground" Value="#9CA3AF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Başlıqlar sıxıldıqda kəsilməsin, sətirə keçsin -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="#F9FAFB"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1D4ED8"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Cədvəl hüceyrələrində mətnin ortalanması üçün -->
    <Style x:Key="GridCellText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0"/>
    </Style>
    <Style x:Key="GridCellTextBox" TargetType="TextBox">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GridCellComboBox" TargetType="ComboBox">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ==================== KÖMƏKÇİ STİLLƏR ==================== -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#9CA3AF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,0,0,4"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>

    <Style x:Key="ValidationText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F87171"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="2,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="220"/>
    </Style>

    <!-- Ödəniş tarixi: gecikmə varsa qırmızı -->
    <Style x:Key="PaymentDateText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Gecikmis}" Value="True">
                <Setter Property="Foreground" Value="#F43F5E"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Ödəniş tarixləri: gecikmə varsa qırmızı, çox tarix olsa sətirə keçir -->
    <Style x:Key="PaymentDatesText" TargetType="TextBlock" BasedOn="{StaticResource PaymentDateText}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="32"/>
        <!-- Üzərinə gələndə hər ödənişin tarixi və məbləği göstərilir -->
        <Setter Property="ToolTip" Value="{Binding OdenisDetali}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
    </Style>

    <!-- ==================== MÜDDƏTDƏN KƏNAR ÖDƏNİŞLƏR (NARINCI) ==================== -->
    <!-- Kredit müddətindən əvvəl və ya sonra edilən ödənişlər narıncı göstərilir. -->
    <Style x:Key="OutOfRangeCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding XaricindeHedd}" Value="True">
                <Setter Property="Foreground" Value="#FB923C"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OutOfRangeAmountText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="ToolTip" Value="{Binding OdenisDetali}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding XaricindeHedd}" Value="True">
                <Setter Property="Foreground" Value="#FB923C"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OutOfRangeDateText" TargetType="TextBlock" BasedOn="{StaticResource PaymentDatesText}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding XaricindeHedd}" Value="True">
                <Setter Property="Foreground" Value="#FB923C"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Möhlət (ödəniş gecikdirməsi) — sarı vurğu -->
    <Style x:Key="MohletCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="30"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding MohletVar}" Value="True">
                <Setter Property="Foreground" Value="#FACC15"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MohletAmountText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="ToolTip" Value="{Binding OdenisDetali}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding MohletVar}" Value="True">
                <Setter Property="Foreground" Value="#FACC15"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Sənəd göstəricisi: fayl varsa yaşıl, yoxdursa boz -->
    <Style x:Key="SenedCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="Foreground" Value="#34D399"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SenedSayi}" Value="0">
                <Setter Property="Foreground" Value="#6B7280"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Növ hüceyrəsi: möhlət sarı, gecikmə qırmızı -->
    <Style x:Key="NovCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Nov}" Value="Möhlət">
                <Setter Property="Foreground" Value="#FACC15"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nov}" Value="Gecikmə">
                <Setter Property="Foreground" Value="#FB7185"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Gecikmə (gecikmiş ödəniş) — qırmızı vurğu -->
    <Style x:Key="GecikmeCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="30"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding GecikmeVar}" Value="True">
                <Setter Property="Foreground" Value="#FB7185"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GecikmeAmountText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="ToolTip" Value="{Binding OdenisDetali}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding GecikmeVar}" Value="True">
                <Setter Property="Foreground" Value="#FB7185"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================================================================== -->
    <!--  ⚠ AZ ÖDƏNİŞ  (plan məbləğindən az ödənilib) — QIRMIZI vurğu          -->
    <!-- ==================================================================== -->
    <Style x:Key="AzOdenisCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding AzOdenilib}" Value="True">
                <Setter Property="Foreground" Value="#F87171"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================================================================== -->
    <!--  ➕ ARTIQ ÖDƏNİŞ  (plan məbləğindən çox ödənilib) — YAŞIL vurğu       -->
    <!-- ==================================================================== -->
    <Style x:Key="ArtiqOdenisCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding CoxOdenilib}" Value="True">
                <Setter Property="Foreground" Value="#4ADE80"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================================================================== -->
    <!--  ⬇ SON AYLARDAN ÇIXILAN  (artıq ödənişin keçdiyi hissə) — MAVİ vurğu  -->
    <!-- ==================================================================== -->
    <Style x:Key="ArtiqKecenCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ArtiqKecenVar}" Value="True">
                <Setter Property="Foreground" Value="#38BDF8"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================================================================== -->
    <!--  ÖDƏNİŞ MƏBLƏĞİ — BÜTÜN VƏZİYYƏTLƏRİN RƏNGİ BİR YERDƏ                -->
    <!--  Trigger sırası VACİBDİR: sonuncu uyğun gələn qalib gəlir, ona görə   -->
    <!--  ən AĞIR vəziyyət (gecikmə) SONDA dayanır.                            -->
    <!--     🟠 müddətdən kənar → 🟡 möhlət → 🔴 az ödəniş →                   -->
    <!--     🟢 artıq ödəniş   → ⚠ gecikmə (ən ağır)                           -->
    <!-- ==================================================================== -->
    <Style x:Key="PaymentAmountCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="ToolTip" Value="{Binding OdenisDetali}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding XaricindeHedd}" Value="True">
                <Setter Property="Foreground" Value="#FB923C"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding MohletVar}" Value="True">
                <Setter Property="Foreground" Value="#FACC15"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding AzOdenilib}" Value="True">
                <Setter Property="Foreground" Value="#F87171"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CoxOdenilib}" Value="True">
                <Setter Property="Foreground" Value="#4ADE80"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding GecikmeVar}" Value="True">
                <Setter Property="Foreground" Value="#FB7185"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding GecikmeAktiv}" Value="True">
                <Setter Property="Foreground" Value="#FB7185"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Ödəniş qrafiki sətri: müddətdən kənar sətir narıncı fonla vurğulanır -->
    <Style x:Key="ScheduleRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <!-- 🟠 müddətdən kənar (əvvəl/sonra) -->
            <DataTrigger Binding="{Binding XaricindeHedd}" Value="True">
                <Setter Property="Background" Value="#2A1B0A"/>
            </DataTrigger>
            <!-- 🟡 möhlət verilmiş ay -->
            <DataTrigger Binding="{Binding MohletVar}" Value="True">
                <Setter Property="Background" Value="#2B2405"/>
            </DataTrigger>
            <!-- 🟢 ARTIQ ÖDƏNİŞ — yaşılımtıl fon -->
            <DataTrigger Binding="{Binding CoxOdenilib}" Value="True">
                <Setter Property="Background" Value="#0B2B1B"/>
            </DataTrigger>
            <!-- 🔴 AZ ÖDƏNİŞ — qırmızımtıl fon -->
            <DataTrigger Binding="{Binding AzOdenilib}" Value="True">
                <Setter Property="Background" Value="#2B1418"/>
            </DataTrigger>
            <!-- ⚠ AKTİV GECİKMƏ — ən ağır vəziyyət, ən sonda -->
            <DataTrigger Binding="{Binding GecikmeAktiv}" Value="True">
                <Setter Property="Background" Value="#3B1A1F"/>
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1E3A8A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Kredit ödənişinin tamamlanma faizi (irəliləyiş zolağı) -->
    <Style x:Key="CreditProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Background" Value="#1F2937"/>
        <Setter Property="Foreground" Value="#34D399"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Məlumat kartı: bölmə başlığı (MÜQAVİLƏ / MALİYYƏ) -->
    <Style x:Key="CardSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#60A5FA"/>
        <Setter Property="Margin" Value="0,2,0,6"/>
    </Style>

    <!-- ==================================================================== -->
    <!--  📊 PEŞƏKAR CƏDVƏL BAŞLIĞI (DataGridColumnHeader)                     -->
    <!--  Uzun başlıqlar SIFIR ÜST-ÜSTƏ DÜŞMƏ olmadan sətrə sığır ✓            -->
    <!-- ==================================================================== -->
    <Style x:Key="ProfessionalHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#1E293B"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#334155"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"
                               LineHeight="13" VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Başlıq: mətn ORTADA (checkbox / dar sütunlar üçün) -->
    <Style x:Key="ProfessionalHeaderCenter" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource ProfessionalHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Məlumat kartı: sahə adı (sol sütun) -->
    <Style x:Key="CardLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#9CA3AF"/>
        <Setter Property="Margin" Value="0,0,12,7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Məlumat kartı: sahə dəyəri (sağ sütun) -->
    <Style x:Key="CardValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#E5E7EB"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Ödənilən məbləğ: az ödənilibsə qırmızı, artıq ödənilibsə yaşıl -->
    <Style x:Key="PaymentAmountText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
        <Setter Property="ToolTip" Value="{Binding OdenisDetali}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding AzOdenilib}" Value="True">
                <Setter Property="Foreground" Value="#F43F5E"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CoxOdenilib}" Value="True">
                <Setter Property="Foreground" Value="#34D399"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#9CA3AF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

</ResourceDictionary>
