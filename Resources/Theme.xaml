        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Margin" Value="2,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="220"/>
    </Style>

