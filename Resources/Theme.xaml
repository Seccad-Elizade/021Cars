        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Foreground" Value="#7C8CA0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding CoxOdenilib}" Value="True">
                <Setter Property="Foreground" Value="#5ADF90"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
