        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="32"/>
        <!-- Üzərinə gələndə hər ödənişin tarixi və məbləği göstərilir -->
        <Setter Property="ToolTip" Value="{Binding OdenisDetali}"/>
