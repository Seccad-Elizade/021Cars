                <Setter Property="Foreground" Value="#EFC93F"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nov}" Value="Gecikmə">
                <Setter Property="Foreground" Value="#FA8A9E"/>
                <Setter Property="FontWeight" Value="Bold"/>
