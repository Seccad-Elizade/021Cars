<Window x:Class="EnterpriseAeroStudio.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔐 Proqrama Giriş" Height="580" Width="470"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" Foreground="#F3F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None" AllowsTransparency="True">

    <!-- ======================================================================
         🔐 GİRİŞ PƏNCƏRƏSİ — peşəkar dizayn (v6.2.44)
         ⚠ Funksiya dəyişməyib ✗ — element adları və hadisələr EYNİDİR ✓✓✓
         ====================================================================== -->
    <Border Margin="16" CornerRadius="20" BorderBrush="#2B3949" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#121A26" Offset="0"/>
                <GradientStop Color="#0C131C" Offset="0.58"/>
                <GradientStop Color="#151E29" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <!-- Üst nazik «brend» zolağı ✓ (qızılı → göy qradiyent ✓) -->
            <Border Height="3" VerticalAlignment="Top" CornerRadius="20,20,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F3C24B" Offset="0"/>
                        <GradientStop Color="#E5A62E" Offset="0.5"/>
                        <GradientStop Color="#4C7DFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="34,34,34,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ==================== ① LOQO + BREND ==================== -->
                <StackPanel Grid.Row="0">
                    <Border Width="86" Height="86" CornerRadius="22" HorizontalAlignment="Center"
                            BorderBrush="#2E3D4E" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/021Cars.png" Stretch="UniformToFill"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270"
                                              Color="#000000" Opacity="0.5"/>
                        </Border.Effect>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="021" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="27" FontWeight="Bold" Foreground="#F3C24B"/>
                        <TextBlock Text=" CARS" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="27" FontWeight="Bold" Foreground="#F3F7FB"/>
                    </StackPanel>

                    <TextBlock Text="AVTOMOBİL PARKI  ·  İDARƏETMƏ SİSTEMİ" FontSize="10.5"
                               Foreground="#8798AD" HorizontalAlignment="Center" Margin="0,7,0,0"/>

                    <Border Height="1" Margin="0,22,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#202D3C" Offset="0"/>
                                <GradientStop Color="#2E3D4E" Offset="0.5"/>
                                <GradientStop Color="#202D3C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>
                <!-- ==================== ② İSTİFADƏÇİ ADI ==================== -->
                <TextBlock Grid.Row="1" Text="👤  İSTİFADƏÇİ ADI" FontSize="11" FontWeight="Bold"
                           Foreground="#A6B4C4" Margin="2,22,0,7"/>
                <Border Grid.Row="2" Background="#131C26" CornerRadius="12" Padding="14,2"
                        BorderBrush="#2B3949" BorderThickness="1">
                    <TextBox x:Name="IstifadeciAdi" Background="Transparent" BorderThickness="0"
                             Foreground="#F3F7FB" CaretBrush="#5C8CFF" FontSize="15"
                             VerticalContentAlignment="Center" Height="36"
                             ToolTip="Sahil · Asif · Seccad"/>
                </Border>

                <!-- ==================== ③ ŞİFRƏ ==================== -->
                <TextBlock Grid.Row="3" Text="🔑  ŞİFRƏ" FontSize="11" FontWeight="Bold"
                           Foreground="#A6B4C4" Margin="2,16,0,7"/>
                <Border Grid.Row="4" Background="#131C26" CornerRadius="12" Padding="14,2"
                        BorderBrush="#2B3949" BorderThickness="1">
                    <Grid>
                        <PasswordBox x:Name="SifreQutusu" Background="Transparent" BorderThickness="0"
                                     Foreground="#F3F7FB" CaretBrush="#5C8CFF" FontSize="15"
                                     VerticalContentAlignment="Center" Height="36"
                                     KeyDown="Sifre_KeyDown"/>
                        <TextBox x:Name="SifreAciq" Background="Transparent" BorderThickness="0"
                                 Foreground="#F3F7FB" CaretBrush="#5C8CFF" FontSize="15"
                                 VerticalContentAlignment="Center" Height="36"
                                 Visibility="Collapsed" KeyDown="Sifre_KeyDown"/>
                    </Grid>
                </Border>

                <!-- ==================== ④ XƏTA + GÖSTƏR ==================== -->
                <DockPanel Grid.Row="5" Margin="0,12,0,0" VerticalAlignment="Top">
                    <CheckBox DockPanel.Dock="Right" x:Name="SifreGoster" Content="👁 Göstər"
                              FontSize="11.5" VerticalAlignment="Center"
                              Checked="SifreGoster_Changed" Unchecked="SifreGoster_Changed"/>
                    <TextBlock x:Name="XetaMetni" Foreground="#FF9090" FontSize="12"
                               FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- ==================== ⑤ DÜYMƏLƏR ==================== -->
                <StackPanel Grid.Row="6" Margin="0,14,0,0">
                    <Button Content="🔓  D A X İ L   O L" Height="46" FontSize="14" FontWeight="Bold"
                            Foreground="#FFFFFF" BorderThickness="0"
                            Cursor="Hand" IsDefault="True" Click="Giris_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#5C8CFF" Offset="0"/>
                                <GradientStop Color="#3B66E8" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="✖  Çıxış" Height="36" Margin="0,10,0,0" FontSize="12"
                            Background="#1B2634" Foreground="#A6B4C4" BorderThickness="0"
                            Cursor="Hand" Click="Cixis_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock Text="🔐 Giriş məlumatları yalnız proqramın içinə aiddir ✓"
                               FontSize="10" Foreground="#8798AD" HorizontalAlignment="Center"
                               Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

