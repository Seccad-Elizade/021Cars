                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" FontSize="11" FontWeight="Bold"
                                                           Foreground="#F59E0B" VerticalAlignment="Center"
                                                           Text="{Binding Finance.PortfolioDelayBreakdown}"/>
                                                <TextBlock Text="📋 HANSI MAŞINLARA GECİKMƏ YAZILIB"
                                                           FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0"/>
