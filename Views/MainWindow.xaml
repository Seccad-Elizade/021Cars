                                            <TextBlock Text="🔄 BARTER (seçilmiş dövr)" FontSize="10.5" Foreground="#94A3B8"/>
                                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#C084FC"
                                                       Text="{Binding Finance.RangeBarterCount, StringFormat={}{0} satış}"/>
                                            <TextBlock FontSize="10.5" Foreground="#64748B"
                                                       Text="{Binding Finance.RangeBarterTotal, Converter={StaticResource Currency}}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <UniformGrid Columns="3">
                                    <Border Background="#0B1220" CornerRadius="8" Padding="12,10" Margin="0,0,6,0"
                                            BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📤 TRANSFER (dövr üzrə)" FontSize="10.5" Foreground="#94A3B8"/>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#38BDF8"
                                                       Text="{Binding Finance.RangeTransferCount, StringFormat={}{0} transfer}"/>
                                            <TextBlock FontSize="10.5" Foreground="#64748B"
                                                       Text="{Binding Finance.RangeTransferRevenue, Converter={StaticResource Currency}}"/>
                                        </StackPanel>
                                    </Border>

