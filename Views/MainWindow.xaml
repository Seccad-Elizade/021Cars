                                        <DataGridTemplateColumn Header="📅 TARİX" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TarixMetni}" FontSize="11.5"
                                                               Foreground="#E2E8F0"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
