                <TabItem Header="📊 Maliyyə Paneli">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
                        <StackPanel>

                        <!-- ===================== DÖVR FİLTRİ ===================== -->
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Dövr" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="170" ItemsSource="{Binding Finance.RangeOptions}" SelectedItem="{Binding Finance.SelectedRange}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Başlanğıc tarix" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker Width="130" SelectedDate="{Binding Finance.CustomFrom}" IsEnabled="{Binding Finance.IsCustomRange}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Son tarix" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker Width="130" SelectedDate="{Binding Finance.CustomTo}" IsEnabled="{Binding Finance.IsCustomRange}"/>
                                </StackPanel>
                                <StackPanel Margin="20,20,4,0" Orientation="Horizontal">
                                    <CheckBox Content="🟢 Gəlir" IsChecked="{Binding Finance.ShowIncome}" Foreground="#34D399" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <CheckBox Content="🔴 Xərclər" IsChecked="{Binding Finance.ShowExpense}" Foreground="#F43F5E" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <CheckBox Content="🟣 Kassa axını" IsChecked="{Binding Finance.ShowProfit}" Foreground="#C084FC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="↻ Yenilə" Style="{StaticResource iOSButton}" Background="#2563EB" Foreground="White" Margin="16,20,4,0"
                                        Command="{Binding Finance.LoadCommand}"/>
