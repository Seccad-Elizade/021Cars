                                        <StackPanel>
                                            <TextBlock Text="💰 TRANSFER XEYİRİ — BİZDƏ QALIR" FontSize="10.5" Foreground="#94A3B8"/>
                                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#34D399"
