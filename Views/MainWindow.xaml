                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Son ödəniş" Style="{StaticResource CardLabel}"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#34D399" FontWeight="Bold" FontSize="12.5"
                                                               Text="{Binding Credits.SelectedOdenilen, Converter={StaticResource Currency}}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#F87171" FontWeight="Bold" FontSize="12.5"
                                                               Text="{Binding Credits.SelectedQaliq, Converter={StaticResource Currency}}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Foreground="#E5E7EB" FontWeight="Bold" FontSize="12.5"
                                                               Text="{Binding Credits.SelectedSonOdenis}"/>
                                                </Grid>

                                                <ProgressBar Margin="0,8,0,4"
                                                             Value="{Binding Credits.SelectedOdenisFaizi, Mode=OneWay}"
                                                             Style="{StaticResource CreditProgressBar}"/>

                                                <TextBlock Text="{Binding Credits.SelectedOdenisYekunu}" FontSize="11"
                                                           Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                                <!-- ================================================ -->
                                                <!-- ⏳ İLKİN ÖDƏNİŞƏ MÖHLƏT (seçilmiş kredit ✓✓✓)     -->
