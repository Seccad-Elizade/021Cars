                                                </TextBlock>
                                                <TextBlock Text="aktiv  /  bağlanmış müqavilə" FontSize="9.5"
                                                           Foreground="#64748B" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#111827" CornerRadius="8" Padding="12,9" Margin="5,5,0,0">
                                            <StackPanel>
                                                <TextBlock Text="KREDİT FAİZ MƏNFƏƏTİ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
