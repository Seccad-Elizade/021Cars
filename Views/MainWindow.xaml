                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Müddət (ay)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CalcMuddet" Width="100" Text="{Binding Calculator.MuddetAy, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CalcMuddet}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="10,18,4,0" Orientation="Horizontal">
