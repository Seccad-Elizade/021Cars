                                    <StackPanel>
                                        <TextBlock Text="Kredit Məbləği" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Calculator.KreditMeblegi, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#60A5FA"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#10B981">
                                    <StackPanel>
                                        <TextBlock Text="Aylıq Ödəniş" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Calculator.AylıqOdenis, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#34D399"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#F59E0B">
                                    <StackPanel>
                                        <TextBlock Text="Ümumi Ödəniş" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Calculator.UmumiOdenis, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#FBBF24"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#EF4444">
                                    <StackPanel>
                                        <TextBlock Text="Ümumi Faiz" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Calculator.UmumiFaiz, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#F43F5E"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================================================ -->
                <!-- TAB: SATIŞ                                                    -->
                <!-- ============================================================ -->
                <TabItem Header="💰 Satış">
                    <!-- 🌊 SƏHİFƏ SCROLL-U ✓ — statistika + satış forması + satış cədvəli BİRLİKDƏ sürüşür ✓
                         (cədvəl `MaxHeight` ilə pəncərə hündürlüyünə məhduddur ✓ → virtualizasiya ✓✓✓)
                         ⚠ `FallbackValue=700` vacibdir ✓ — izah: «💳 Ümumi Xərclər» tabı ✓ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Padding="0,0,6,0">

                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#3B82F6">
                                <StackPanel>
                                    <TextBlock Text="💰 Satılan Avtomobil" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding Sales.TotalSales}" Style="{StaticResource StatValue}" Foreground="#60A5FA"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#10B981">
                                <StackPanel>
                                    <TextBlock Text="💵 Ümumi Gəlir" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding Sales.TotalRevenue, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#34D399"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#A855F7">
                                <StackPanel>
                                    <TextBlock Text="📈 Ümumi Mənfəət" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding Sales.TotalProfit, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#C084FC"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#F59E0B">
                                <StackPanel>
                                    <TextBlock Text="📅 Cari Ay Gəliri" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding Sales.MonthRevenue, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#FBBF24"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Avtomobil" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="250" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                              ItemsSource="{Binding Sales.FilteredCars}" SelectedItem="{Binding Sales.SelectedCar}"
                                              Text="{Binding Sales.CarSearchText, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Alıcı" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SaleBuyer" Width="150" Text="{Binding Sales.Musteri, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=SaleBuyer}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Müqavilə №" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="110" Text="{Binding Sales.MuqavileNomresi, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Satış Qiyməti (AZN)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SalePrice" Width="120" Text="{Binding Sales.SatisQiymeti, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=SalePrice}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Tarix" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker Width="130" SelectedDate="{Binding Sales.SatisTarixi}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Ödəniş Üsulu" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="130" ItemsSource="{Binding Sales.PaymentMethods}" SelectedItem="{Binding Sales.OdenisUsulu}"/>
                                </StackPanel>
                                <!-- ==================================================== -->
                                <!-- ⏳ MÖHLƏTLİ (NİSYƏ) SATIŞ ✓✓✓                       -->
                                <!--  Ödəniş üsulu «Möhlət (nisyə)» seçildikdə panel      -->
                                <!--  AVTOMATİK açılır: nə vaxt → nə qədər ödəniləcək ✓   -->
                                <!--  ➕ ilə BİRDƏN ÇOX ödəniş yazıla bilər ✓✓✓           -->
                                <!-- ==================================================== -->
                                <Border Margin="4" Width="368" CornerRadius="10" Background="#0B1220"
                                        BorderBrush="#F59E0B" BorderThickness="1"
                                        Visibility="{Binding Sales.MohletPanelGorunur, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="11,8">
                                            <TextBlock Text="⏳ NİSYƏ ÖDƏNİŞ PLANI (möhlət)" FontWeight="Bold"
                                                       FontSize="12" Foreground="#E2E8F0"/>
                                        </Border>

                                        <TextBlock Margin="11,8,11,0" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap"
                                                   Text="Maşın nisyə satılır: müştəri nə vaxt, nə qədər ödəyəcək? Hər ödənişi ayrı sətirdə yazın ✓ ➕ ilə BİRDƏN ÇOX əlavə edin ✓"/>

                                        <ItemsControl ItemsSource="{Binding Sales.Mohletler}" Margin="11,7,11,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="116"/>
                                                            <ColumnDefinition Width="84"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="30"/>
                                                        </Grid.ColumnDefinitions>
                                                        <DatePicker Grid.Column="0" Height="24" FontSize="11"
                                                                    ToolTip="Ödənişin GƏLƏCƏYİ tarix ✓"
                                                                    SelectedDate="{Binding Tarix, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBox Grid.Column="1" Height="24" FontSize="11.5" Margin="4,0"
                                                                 ToolTip="Nə qədər ödəniləcək (₼) ✓"
                                                                 Text="{Binding Mebleg, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <ComboBox Grid.Column="2" Height="24" FontSize="11"
                                                                  ToolTip="Gözlənilən ödəniş üsulu ✓"
                                                                  ItemsSource="{Binding DataContext.Sales.PaymentMethods, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                  SelectedItem="{Binding OdenisUsulu}"/>
                                                        <Button Grid.Column="3" Content="✖" Height="24" Padding="0"
                                                                Style="{StaticResource iOSButton}" Background="#7F1D1D" Foreground="White"
                                                                ToolTip="Bu ödənişi sil ✓"
                                                                Command="{Binding DataContext.Sales.MohletSilCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Margin="11,5,11,0" Content="➕ Nisyə ödəniş əlavə et" Style="{StaticResource iOSButton}"
                                                FontSize="11" Background="#D97706" Foreground="White" HorizontalAlignment="Left"
                                                ToolTip="Yeni ödəniş sətri: «nə vaxt → nə qədər» ✓ (birdən çox ola bilər ✓✓✓)"
                                                Command="{Binding Sales.MohletElaveEtCommand}"/>

                                        <Border Margin="11,8,11,9" CornerRadius="6" Background="#111827" Padding="9,6">
                                            <StackPanel>
                                                <TextBlock Text="DƏRHAL ÖDƏNİLƏN (kassaya daxil olan ✓)" FontSize="9.5"
                                                           FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#34D399"
                                                           Text="{Binding Sales.DerhalOdenilen, Converter={StaticResource Currency}}"/>
                                                <TextBlock Margin="0,3,0,0" FontSize="10.5" TextWrapping="Wrap"
                                                           Foreground="{Binding Sales.MohletRengi}"
                                                           Text="{Binding Sales.MohletXulase}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="4" Visibility="{Binding Sales.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Barter Hissəsi (AZN)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="110" Text="{Binding Sales.BarterMebleg, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Alıcının verdiyi maşının dəyəri"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding Sales.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Alıcının Verdiyi Maşın" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="190" Text="{Binding Sales.BarterTesviri, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Məs. 2013 Kia Rio 90AB123"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding Sales.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Nağd / Köçürmə (AZN)" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Sales.BarterCashPart, Converter={StaticResource Currency}}"
                                               Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding Sales.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Hesablaşma" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Sales.BarterSummary}" Foreground="#F59E0B" FontWeight="SemiBold"
                                               VerticalAlignment="Center" MaxWidth="270" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- ============ ALICININ VERDİYİ MAŞIN → AVTO PARKA ============
                                     Marka doldurulsa maşın avtomatik parka əlavə edilir və
                                     MAYA DƏYƏRİ = barter payı təyin olunur. -->
                                <StackPanel Margin="4" Visibility="{Binding Sales.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="🚗 Alıcının Maşını (marka)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="140" Text="{Binding Sales.ReceivedMarka, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Boş = parka əlavə edilmir. Doldurulsa maşın avto parka düşür və maya dəyəri barter payına bərabər olur"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding Sales.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Nömrə" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="100" Text="{Binding Sales.ReceivedNisan, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding Sales.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="İl" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="60" Text="{Binding Sales.ReceivedIl, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding Sales.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Yürüş (km)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="80" Text="{Binding Sales.ReceivedYurus, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding Sales.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Yanacaq" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="120" ItemsSource="{Binding Sales.FuelTypes}" SelectedItem="{Binding Sales.ReceivedYanacaq}"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding Sales.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Nəzərdə Tutulan Satış (AZN)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="110" Text="{Binding Sales.ReceivedSatisQiymeti, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Qeyd" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="140" Text="{Binding Sales.Qeyd, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="10,18,4,0" Orientation="Horizontal">
                                    <Button Content="+ Satışı Qeyd Et" Style="{StaticResource iOSButton}" Background="#10B981" Foreground="White" Margin="0,0,6,0"
                                            Command="{Binding Sales.AddSaleCommand}" IsEnabled="{Binding Sales.IsBusy, Converter={StaticResource InverseBool}}"/>
                                    <Button Content="🗑️ Sil" Style="{StaticResource iOSButton}" Background="#EF4444" Foreground="White" Margin="0,0,6,0"
                                            Command="{Binding Sales.DeleteSaleCommand}"/>
                                    <Button Content="↺ Təmizlə" Style="{StaticResource iOSButton}" Background="#374151" Foreground="#F9FAFB"
                                            Command="{Binding Sales.ClearFormCommand}"/>
                                </StackPanel>

                                <!-- ==================================================== -->
                                <!-- 👥 SATIŞIN TƏRƏFDAŞ MƏNFƏƏT BÖLGÜSÜ                 -->
                                <!-- XEYİR = Satış qiyməti − Maya dəyəri                -->
                                <!-- Nümunə: 22 014 − 20 420 = 1 594 ₼  → bölünür      -->
                                <!-- ☑ işarəli tərəfdaşlar hesablanır, işarəsizlər yox  -->
                                <!-- ==================================================== -->
                                <Border Margin="4" Width="392" CornerRadius="10"
                                        Background="#0B1220" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>

                                        <!-- ===== BAŞLIQ ZOLAĞI ===== -->
                                        <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="11,8">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center"
                                                          FontSize="11.5" FontWeight="SemiBold" Foreground="#34D399"
                                                          ToolTip="Bölgünü tətbiq et / ləğv et"
                                                          Content="{Binding Sales.SatisBolguVeziyyet}"
                                                          IsChecked="{Binding Sales.SatisBolguTetbiq}"/>
                                                <TextBlock Text="👥 Satışın tərəfdaş bölgüsü" FontWeight="Bold"
                                                           FontSize="12.5" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- ===== XEYİR (baza) ===== -->
                                        <TextBlock Margin="11,9,11,4" FontSize="11" Foreground="#FBBF24"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Sales.SatisXeyirMetni}"/>

                                        <TextBlock Margin="11,0,11,9" FontSize="11" Foreground="#38BDF8"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Sales.SatisBolguXulase}"/>

                                        <!-- ===== DÜYMƏLƏR ===== -->
                                        <UniformGrid Columns="2" Margin="11,0,11,9">
                                            <Button Content="🔄 Xeyiri hesabla" Style="{StaticResource iOSButton}" FontSize="11"
                                                    Background="#2563EB" Foreground="White" Margin="0,0,3,0"
                                                    ToolTip="Xeyiri (Satış − Maya) hesablayır və payları bölür"
                                                    Command="{Binding Sales.SatisBolguHesablaCommand}"/>
                                            <Button Content="♻️ Default faizlər" Style="{StaticResource iOSButton}" FontSize="11"
                                                    Background="#475569" Foreground="White" Margin="3,0,0,0"
                                                    ToolTip="Zaur %6 · Eşqin %5 · Asiman %5 · Asif &amp; Musa qalıq"
                                                    Command="{Binding Sales.SatisBolguDefaultCommand}"/>
                                        </UniformGrid>
                                        <!-- ===== CƏDVƏL ===== -->
                                        <Border Margin="11,0,11,0" CornerRadius="7"
                                                Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                                            <DataGrid ItemsSource="{Binding Sales.SatisTerefdaslari}"
                                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                                      HeadersVisibility="Column" RowHeight="31" ColumnHeaderHeight="31"
                                                      Background="Transparent" BorderThickness="0"
                                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                                                      Foreground="#E2E8F0" FontSize="11.5" RowBackground="#111827"
                                                      AlternatingRowBackground="#0D1526">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="TƏTBİQ" Width="66"
                                                                            Binding="{Binding Aktiv, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <DataGridTextColumn Header="TƏRƏFDAŞ" Width="*" IsReadOnly="True"
                                                                        Binding="{Binding Terefdas}"/>
                                                    <DataGridTextColumn Header="FAİZ %" Width="62"
                                                                        Binding="{Binding Faiz, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <DataGridTextColumn Header="MƏBLƏĞ (₼)" Width="94" IsReadOnly="True"
                                                                        Binding="{Binding Mebleg, StringFormat=N2}"/>
                                                    <DataGridTextColumn Header="QALIQ" Width="48" IsReadOnly="True"
                                                                        Binding="{Binding QaligPayi}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>

                                        <!-- ===== YEKUN ===== -->
                                        <TextBlock Margin="11,8,11,2" FontSize="12" FontWeight="Bold" Foreground="#F9FAFB"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Sales.SatisBolguCemi, StringFormat='PAYLARIN CƏMİ: {0:N2} ₼'}"/>

                                        <TextBlock Margin="11,0,11,10" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{Binding Sales.SatisBolguFergReng}"
                                                   Text="{Binding Sales.SatisBolguFergMetni}"/>

                                    </StackPanel>
                                </Border>

                            </WrapPanel>
                        </Border>
                        <Border Grid.Row="2" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="6" Effect="{StaticResource GlassShadow}">
                            <DataGrid ItemsSource="{Binding Sales.Sales}" SelectedItem="{Binding Sales.SelectedSale}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      SelectionMode="Single" RowHeight="40" ColumnHeaderHeight="42"
                                      MinHeight="380"
                                      MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Avtomobil" Binding="{Binding CarInfo}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Alıcı" Binding="{Binding Mustəri}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Müqavilə №" Binding="{Binding MuqavileNomresi}" Width="110" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Satış Qiyməti" Binding="{Binding SatisQiymeti, Converter={StaticResource Currency}}" Width="150" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Maya Dəyəri" Binding="{Binding MayaDeyeri, Converter={StaticResource Currency}}" Width="150" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Mənfəət" Binding="{Binding Menfeet, Converter={StaticResource Currency}}" Width="140" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Tarix" Binding="{Binding SatisTarixi, StringFormat=dd.MM.yyyy}" Width="110" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Ödəniş Üsulu" Binding="{Binding OdenisMetni}" Width="200" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Qeyd" Binding="{Binding Qeyd}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                    </ScrollViewer>

                </TabItem>

                <!-- ============================================================ -->
                <!-- TAB 4: KREDİTLƏR                                              -->
                <!-- ============================================================ -->
                <TabItem Header="💳 Kreditlər">
                    <!-- 🌊 SƏHİFƏ SCROLL-U ✓ — uzun kredit forması + müqavilə cədvəli + kredit detalları
                         BİRLİKDƏ sürüşür ✓ (cədvəl `MaxHeight` ilə məhduddur ✓ → virtualizasiya ✓✓✓)
                         ⚠ `FallbackValue=700` vacibdir ✓ — izah: «💳 Ümumi Xərclər» tabı ✓ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Padding="0,0,6,0">

                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Müqavilə № (boş = avtomatik)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="120" Text="{Binding Credits.MuqavileNomresi, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Müştəri" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CreditMusteri" Width="150" Text="{Binding Credits.Musteri, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CreditMusteri}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Avtomobil" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="250" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                              ItemsSource="{Binding Credits.FilteredCars}" SelectedItem="{Binding Credits.SelectedCar}"
                                              Text="{Binding Credits.CarSearchText, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <!-- 🔄 SATICI DEYİR → SATIŞ QİYMƏTİ AVTOMATİK YAZILIR -->
                                <StackPanel Margin="4">
                                    <TextBlock Text="🔄 Aylıq Ödəniş (AZN)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="120" FontWeight="SemiBold" Foreground="#34D399"
                                             ToolTip="Satıcının dediyi AYLIQ ödəniş — yazdıqda Satış Qiyməti avtomatik hesablanır"
                                             Text="{Binding Credits.SatisAylıq, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="↑ yazın → qiymət avtomatik" FontSize="10" Foreground="#34D399" Margin="2,3,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Qrafik bölgüsü (əmsal)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="100" FontWeight="SemiBold" Foreground="#FACC15"
                                             ToolTip="Müddətə görə AVTOMATİK yazılır (6→1.2 · 12→1.4 · 24→1.8 · 36→2.2 · 42→2.4 · 48→2.6 · 60→3.0 ✓). Əl ilə də dəyişə bilərsiniz."
                                             Text="{Binding Credits.SatisEmsal, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="10,18,4,0" Orientation="Horizontal">
                                    <Button Content="📐 Qiyməti hesabla" Style="{StaticResource iOSButton}" Background="#0EA5E9" Foreground="White"
                                            ToolTip="(Aylıq × Ay) ÷ Əmsal + İlkin ödəniş = MAŞININ QİYMƏTİ"
                                            Command="{Binding Credits.SatisQiymetiHesablaCommand}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Əmsal cədvəli" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Credits.SatisEmsalCedveli}" FontSize="10" Foreground="#64748B"
                                               Margin="2,4,0,0" MaxWidth="240" TextWrapping="Wrap"/>
                                </StackPanel>

