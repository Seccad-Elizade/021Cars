                                            <TextBlock Text="Müddət (ay)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="90" Text="{Binding Calculator.SatisciAy, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="Aylıq Ödəniş (₼)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="120" FontWeight="SemiBold" Foreground="#34D399"
                                                     Text="{Binding Calculator.SatisciAylıq, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="İlkin Ödəniş (₼)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="120" Text="{Binding Calculator.SatisciIlkin, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="Qrafik bölgüsü (əmsal)" Style="{StaticResource FieldLabel}"/>
