                                                                                   FontSize="11" FontWeight="Bold"
                                                                                   Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                                    </DockPanel>

                                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,3">
                                                                        <TextBlock Text="Ödəniş:" FontSize="10" Foreground="#64748B"/>
                                                                        <TextBlock Text="{Binding OdenisMetni}" FontSize="10"
                                                                                   Foreground="#94A3B8" Margin="3,0,0,0"/>
                                                                        <TextBlock Text="   ·   Baza:" FontSize="10" Foreground="#64748B"/>
                                                                        <TextBlock Text="{Binding BazaMetni}" FontSize="10"
                                                                                   Foreground="#FBBF24" Margin="3,0,0,0"/>
                                                                    </StackPanel>

                                                                    <TextBlock Text="{Binding PaylarMetni}" FontSize="11"
                                                                               Foreground="#E2E8F0" TextWrapping="Wrap"
                                                                               LineHeight="16"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="Bold"
                                                               Foreground="#F9FAFB"
                                                               Text="{Binding Credits.SelectedMonthlySharesTotalMetni}"/>
                                                    <TextBlock FontSize="11" Foreground="#94A3B8" Text="AYLIK BÖLGÜLƏRİN CƏMİ"/>
