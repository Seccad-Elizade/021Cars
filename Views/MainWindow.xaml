                                            BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="💰 DÖVR ÜZRƏ TRANSFER XEYİRİ" FontSize="10.5" Foreground="#94A3B8"/>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#34D399"
                                                       Text="{Binding Finance.RangeTransferProfit, Converter={StaticResource Currency}}"/>
                                            <TextBlock FontSize="10.5" Foreground="#64748B" Text="xeyir bizdə qalır ✓"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#111827" CornerRadius="8" Padding="12,10" Margin="6,0,0,0"
                                            BorderBrush="#1F2937" BorderThickness="1">
