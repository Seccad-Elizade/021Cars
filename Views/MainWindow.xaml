                                            </StackPanel>
                                        </Border>
                                        <Border Background="#111827" CornerRadius="8" Padding="12,9" Margin="5,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="ANBAR MAYA DƏYƏRİ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
