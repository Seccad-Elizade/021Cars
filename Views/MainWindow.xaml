                                                           Foreground="#64748B" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <!-- ................ 🏦 KREDİT PORTFELİ ................ -->
                            <Border Grid.Column="1" Background="#0B1220" CornerRadius="10" Margin="7,0,0,0"
                                    BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="14,9">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="#94A3B8" Text="{Binding Finance.PortfolioProgressMetni}"/>
                                            <TextBlock Text="🏦 KREDİT PORTFELİ" FontWeight="Bold" FontSize="12.5" Foreground="#E2E8F0"/>
                                        </DockPanel>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="10,10,10,4">
                                        <Border Background="#111827" CornerRadius="8" Padding="12,9" Margin="0,0,5,5">
                                            <StackPanel>
                                                <TextBlock Text="QALIQ BORC (PORTFEL)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding Finance.PortfolioRemaining, Converter={StaticResource Currency}}"
                                                           FontSize="17" FontWeight="Bold" Foreground="#FBBF24"/>
