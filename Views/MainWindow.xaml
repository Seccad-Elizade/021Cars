                                                               Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding GelirMetni}" FontSize="12.5"
                                                               FontWeight="Bold" Foreground="#34D399"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding XercMetni}" FontSize="12.5"
                                                               FontWeight="Bold" Foreground="#FB7185"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
