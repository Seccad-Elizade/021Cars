                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <TextBox Grid.Column="2" Height="24" FontSize="12"
                                                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
