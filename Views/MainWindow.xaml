                                                <TextBlock Text="📅 AYLIK KREDİT ÖDƏNİŞİ BÖLGÜSÜ"
                                                           Style="{StaticResource CardSectionHeader}"/>
                                                <TextBlock Text="{Binding Credits.SelectedMonthlySharesXulase}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"
                                                           TextWrapping="Wrap" Margin="0,2,0,6"
                                                           ToolTip="Hər ay kredit ödənişi edildikdə bölünən məbləğ — tərəfdaşlar arasında."/>

                                                <ItemsControl ItemsSource="{Binding Credits.SelectedMonthlyShares}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#111827" CornerRadius="6" Padding="8,6"
                                                                    Margin="0,0,0,5" BorderBrush="#1F2937" BorderThickness="1">
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Right"
                                                                                   Text="{Binding PaylarCemiMetni}"
                                                                                   FontSize="11.5" FontWeight="Bold"
                                                                                   Foreground="#34D399" VerticalAlignment="Center"/>
