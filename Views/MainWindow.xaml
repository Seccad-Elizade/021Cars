                                                           ToolTip="Barter edilən maşının maya dəyəri kreditin NİSYƏ məbləğindən çıxılır və qrafik yenidən qurulur."/>
                                                <Border Background="#0F172A" CornerRadius="7" Padding="9"
                                                        BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <StackPanel Margin="0,0,8,6" Width="120">
                                                                <TextBlock Text="📄 SƏNƏD ADI" FontSize="9.5" Foreground="#94A3B8"/>
                                                                <TextBox Text="{Binding Credits.BarterSenedAdi, UpdateSourceTrigger=PropertyChanged}"
