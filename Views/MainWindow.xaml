                            <!-- ============ 🔄 TƏRS HESABLAMA (satıcıdan → maşının qiyməti) ============ -->
                            <Border Background="#0B1220" CornerRadius="10" Margin="0,0,0,18" Padding="16"
                                    BorderBrush="#38BDF8" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🔄 SATICI DEYİR → MAŞININ QİYMƏTİ HESABLANIR"
                                               FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"
                                               Text="Satıcı deyir: «Necə aylıq kredit olacaq, aylıq nə qədər ödəniş veriləcək, ilkin nə qədər olacaq» → maşının qiyməti buradan hesablanır."/>

                                    <WrapPanel>
