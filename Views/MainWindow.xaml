                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="📤 TRANSFER  &amp;  🔄 BARTER" FontWeight="Bold" FontSize="13"
                                               Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="11" Foreground="#94A3B8" Text="{Binding Finance.RangeText}"/>
                                </DockPanel>

                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Border Background="#0B1220" CornerRadius="8" Padding="12,10" Margin="0,0,6,0"
                                            BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📤 TRANSFER SAYI (bütün vaxt)" FontSize="10.5" Foreground="#94A3B8"/>
                                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#38BDF8"
                                                       Text="{Binding Finance.TransferCount, StringFormat={}{0} transfer}"/>
                                            <TextBlock FontSize="10.5" Foreground="#64748B"
                                                       Text="{Binding Finance.TransferRevenue, Converter={StaticResource Currency}}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0B1220" CornerRadius="8" Padding="12,10" Margin="6,0,6,0"
