                                        </Border>
                                        <Border Background="#111827" CornerRadius="8" Padding="12,9" Margin="5,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="✅ ÖDƏNİLMİŞ (ÜMUMİ)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding Finance.PortfolioPaidTumu, Converter={StaticResource Currency}}"
                                                           FontSize="17" FontWeight="Bold" Foreground="#34D399"/>
                                                <TextBlock Text="{Binding Finance.PortfolioPaidTumuText}" FontSize="9.5"
                                                           Foreground="#64748B" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Finance.PortfolioPaidText}" FontSize="9.5"
                                                           Foreground="#64748B" TextWrapping="Wrap"/>
                                                <TextBlock Text="= Portfel borcu − Ödənilmiş" FontSize="9.5"
                                                           Foreground="#FB923C" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           ToolTip="Qalıq borc = (Əsas borc + Faiz mənfəəti + Ödənilməmiş gecikmə) − ÖDƏNİLMİŞ (aktiv portfel) kredit ödənişləri ✓"/>
                                                <!-- 🔒 BAĞLI / VAXTINDAN TEZ BAĞLANMIŞ KREDİTLƏR ✓ -->
                                                <TextBlock Text="{Binding Finance.PortfolioClosedText}" FontSize="9.5"
                                                           Foreground="#C084FC" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           ToolTip="Vaxtından tez bağlanmış kreditlər portfeldən çıxır ✓ AMMA ödənilmiş pulları və mənfəətləri BURADA görünür ✓ (itmir ✗)."/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#111827" CornerRadius="8" Padding="12,9" Margin="0,5,5,0">
                                            <StackPanel>
                                                <TextBlock Text="AKTİV / BİTMİŞ KREDİT" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
