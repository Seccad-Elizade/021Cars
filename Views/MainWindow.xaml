                                                          SelectedValuePath="Id"
                                                          IsDropDownOpen="True">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Məbləğ" Width="150" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Mebleg, Converter={StaticResource Currency}}" Style="{StaticResource GridCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellTextBox}" Text="{Binding Mebleg, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Ödəniş Üsulu" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding OdenisUsulu}" Style="{StaticResource GridCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource GridCellComboBox}"
                                                          ItemsSource="{x:Static svc:Catalog.PaymentMethods}"
                                                          SelectedItem="{Binding OdenisUsulu, UpdateSourceTrigger=PropertyChanged}"
                                                          IsDropDownOpen="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Qeyd" Binding="{Binding Qeyd, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource GridCellText}" EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- ==================================================== -->
                        <!-- 🚀 SƏHİFƏ FOOTER-İ  (MİLYON SƏTİR ÜÇÜN ✓✓✓)          -->
