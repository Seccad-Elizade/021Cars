                                                                     ToolTip="Məsələn: Tural"/>
                                                            <Button Content="➕ İNSAN ƏLAVƏ ET"
                                                                    Command="{Binding Credits.TransferSexsElaveEtCommand}"
                                                                    Style="{StaticResource iOSButton}" FontSize="11"/>
                                                            <Button Content="🗑️ SEÇİLMİŞ ŞƏXSİ SİL"
                                                                    Command="{Binding Credits.TransferSexsSilCommand}"
                                                                    CommandParameter="{Binding Credits.SelectedTransferSexs}"
                                                                    Style="{StaticResource iOSButton}" FontSize="11"
                                                                    Margin="7,0,0,0"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Credits.Transferler}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#111827" CornerRadius="6" Padding="9,6"
                                                                    Margin="0,0,0,5" BorderBrush="#1F2937" BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="100"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="42"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Tesvir}"
                                                                               FontSize="12" FontWeight="Bold" Foreground="#38BDF8"
                                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Tarix, StringFormat=dd.MM.yyyy}"
                                                                               FontSize="11" Foreground="#94A3B8"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding Mebleg, Converter={StaticResource Currency}}"
                                                                               FontSize="12" FontWeight="Bold" Foreground="#34D399"
                                                                               VerticalAlignment="Center"
                                                                               ToolTip="Şəxsin verdiyi beh ✓"/>
                                                                    <Button Grid.Column="3" Content="🗑️"
                                                                            Command="{Binding DataContext.Credits.TransferSilCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource iOSButton}" FontSize="11"
                                                                            Padding="4,2"
                                                                            ToolTip="Transfer qeydini sil"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- 👥 1) XEYİR BÖLGÜSÜ (maşın mənfəəti)              -->
                                                <!-- Kredit ilk dəfə veriləndə bölünən «xeyir»         -->
                                                <!-- ================================================ -->
                                                <Border Height="1" Background="#1F2937" Margin="0,10,0,10"/>

                                                <TextBlock Text="👥 MAŞIN MƏNFƏƏTİ (XEYİR) BÖLGÜSÜ"
                                                           Style="{StaticResource CardSectionHeader}"/>
                                                <TextBlock Text="{Binding Credits.SelectedCreditXeyirMetni}"
                                                           FontSize="11.5" FontWeight="SemiBold" Foreground="#FBBF24"
                                                           TextWrapping="Wrap" Margin="0,2,0,6"
                                                           ToolTip="Xeyir = Avtomobilin satış qiyməti − maya dəyəri. Bu məbləğ tərəfdaşlar arasında bölünür."/>

                                                <ItemsControl ItemsSource="{Binding Credits.SelectedCreditShares}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="0,3" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="62"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Terefdas}"
                                                                               FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding FaizMetni}"
                                                                               FontSize="11" Foreground="#94A3B8"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding MeblegMetni}"
                                                                               FontSize="12.5" FontWeight="Bold"
                                                                               Foreground="#34D399" MinWidth="105"
                                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="Bold"
                                                               Foreground="#F9FAFB"
                                                               Text="{Binding Credits.SelectedCreditSharesTotalMetni}"/>
                                                    <TextBlock FontSize="11" Foreground="#94A3B8" Text="BÖLGÜNÜN CƏMİ"/>
                                                </DockPanel>

                                                <TextBlock Text="{Binding Credits.SelectedCreditSharesXulase}"
                                                           FontSize="10.5" Foreground="#64748B"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <!-- ================================================ -->
                                                <!-- 📅 2) AYLIK KREDİT BÖLGÜSÜ                        -->
                                                <!-- Hər ayın ödənişində bölünən pullar (Zaur, Asif…)  -->
