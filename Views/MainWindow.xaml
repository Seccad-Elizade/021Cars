                                    <WrapPanel DockPanel.Dock="Top" Margin="2,0,2,8" Orientation="Horizontal">
                                        <Button Content="📎 Əlavə et" Style="{StaticResource iOSButton}" FontSize="11"
                                                Background="#2563EB" Foreground="White" Margin="0,0,6,5" Padding="10,4"
                                                ToolTip="Çek, qaimə, müqavilə (PDF / Word / Excel / JPG / PNG) əlavə edin"
                                                Command="{Binding CreditTransactions.AddFilesCommand}"/>
                                        <Button Content="📂 Qovluq" Style="{StaticResource iOSButton}" FontSize="11"
                                                Background="#7C3AED" Foreground="White" Margin="0,0,6,5" Padding="10,4"
                                                ToolTip="Bu əməliyyatın fayllarının saxlandığı qovluğu birbaşa açır"
                                                Command="{Binding CreditTransactions.OpenFolderCommand}"/>
                                        <Button Content="👁 Aç" Style="{StaticResource iOSButton}" FontSize="11"
                                                Background="#0EA5E9" Foreground="White" Margin="0,0,6,5" Padding="10,4"
                                                ToolTip="Seçilmiş faylı aç"
                                                Command="{Binding CreditTransactions.OpenAttachmentCommand}"/>
                                        <Button Content="🗑 Sil" Style="{StaticResource iOSButton}" FontSize="11"
                                                Background="#EF4444" Foreground="White" Margin="0,0,0,5" Padding="10,4"
                                                ToolTip="Seçilmiş faylı sil"
                                                Command="{Binding CreditTransactions.DeleteAttachmentCommand}"/>
                                    </WrapPanel>

                                    <TextBlock DockPanel.Dock="Top" Text="{Binding CreditTransactions.AttachmentInfo}" FontSize="11"
                                               Foreground="#9CA3AF" Margin="2,0,2,6" TextWrapping="Wrap"/>
                                    <TextBlock DockPanel.Dock="Top" Text="Hər əməliyyata ayrıca çek / sənəd əlavə edilir. Sətirə iki dəfə klikləyərək açın."
                                               FontSize="10" Foreground="#6B7280" Margin="2,0,2,8" TextWrapping="Wrap"/>
                                    <DataGrid ItemsSource="{Binding CreditTransactions.Attachments}"
                                              SelectedItem="{Binding CreditTransactions.SelectedAttachment}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              RowHeight="32" ColumnHeaderHeight="44"
                                              ColumnHeaderStyle="{StaticResource ProfessionalHeader}"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                                              RowBackground="#0F172A" AlternatingRowBackground="#111827"
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.PanningMode="Both"
                                              MinHeight="200"
                                              MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}"
                                              IsManipulationEnabled="True"
                                              MouseDoubleClick="TxAttachmentGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="📎 FAYL ADI" Binding="{Binding DisplayText}"
                                                                Width="*" MinWidth="120" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="NÖV" Binding="{Binding Extension}"
                                                                Width="60" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="ÖLÇÜ" Binding="{Binding SizeText}"
                                                                Width="75" ElementStyle="{StaticResource GridCellText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    </ScrollViewer>

                </TabItem>

                <!-- ============================================================ -->
                <!-- TAB 7: MALİYYƏ PANELİ                                        -->
