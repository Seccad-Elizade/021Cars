                                                       FontSize="22" FontWeight="Bold" Margin="0,4,0,0"
                                                       Foreground="{Binding Finance.RangeProfitReng}"/>
                                            <TextBlock FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Text="{Binding Finance.RangeProfitFormulu}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 📈 REALİZƏ OLUNMUŞ MƏNFƏƏT -->
