                                <TextBlock DockPanel.Dock="Top" Text="{Binding CreditTransactions.TransactionsInfo}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#38BDF8" Margin="6,4,6,8" TextWrapping="Wrap"/>
                                <DataGrid ItemsSource="{Binding CreditTransactions.FilteredTransactions}" SelectedItem="{Binding CreditTransactions.SelectedTransaction}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          SelectionMode="Single" RowHeight="38" ColumnHeaderHeight="46"
                                          ColumnHeaderStyle="{StaticResource ProfessionalHeader}"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                                          HeadersVisibility="Column" RowBackground="#0F172A" AlternatingRowBackground="#111827"
                                          HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.PanningMode="Both"
                                          MinHeight="380"
                                          MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}"
                                          IsManipulationEnabled="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Nov}" Value="Möhlət">
                                                <Setter Property="Background" Value="#2B2405"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Nov}" Value="Gecikmə">
                                                <Setter Property="Background" Value="#3B1A1F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Nov}" Value="Gəlir">
                                                <Setter Property="Background" Value="#0B2B1B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Nov}" Value="Xərc">
                                                <Setter Property="Background" Value="#2B1418"/>
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1E3A8A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- 💳 KREDİT — uzun mətn sətrə sığır, üst-üstə düşmür -->
                                    <DataGridTextColumn Header="💳 KREDİT · MÜŞTƏRİ · AVTOMOBİL"
                                                        Binding="{Binding CreditInfo}"
                                                        Width="*" MinWidth="230"
                                                        ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="📅 TARİX"
                                                        Binding="{Binding GosterilenTarixMetni}"
                                                        Width="105" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="🏷️ NÖV"
                                                        Binding="{Binding Nov}"
                                                        Width="95" ElementStyle="{StaticResource NovCellText}"/>
                                    <DataGridTextColumn Header="⏸ MÖHLƏT — SON TARİX"
                                                        Binding="{Binding MohletTarixi, StringFormat=dd.MM.yyyy}"
                                                        Width="135" ElementStyle="{StaticResource MohletCellText}"/>
                                    <DataGridTextColumn Header="⚠ GECİKMƏ — TARİX"
                                                        Binding="{Binding GecikmeTarixi, StringFormat=dd.MM.yyyy}"
                                                        Width="130" ElementStyle="{StaticResource GecikmeCellText}"/>
                                    <DataGridTextColumn Header="💰 MƏBLƏĞ / CƏRİMƏ" Binding="{Binding Mebleg, Converter={StaticResource Currency}}" Width="140" ElementStyle="{StaticResource GecikmeAmountText}"/>
                                    <DataGridTemplateColumn Header="✅ ÖDƏNİLİB?" Width="100" HeaderStyle="{StaticResource ProfessionalHeaderCenter}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ToolTip="Gecikmiş ödəniş bağlanıb (ödənilib)?"
                                                          Visibility="{Binding IsGecikme, Converter={StaticResource BoolToVis}}"
                                                          IsChecked="{Binding Odenilib, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          Command="{Binding DataContext.CreditTransactions.ToggleTransactionPaidCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                          CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="📝 TƏSVİR" Binding="{Binding Tesvir}" Width="*" MinWidth="170" ElementStyle="{StaticResource GridCellText}"/>
                                </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                            <!-- ===================== FAYLLAR (ÇEK / SƏNƏD) ===================== -->
                            <Border Grid.Column="1" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="6" Effect="{StaticResource GlassShadow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding CreditTransactions.AttachmentTitle}"
                                               FontSize="13" FontWeight="Bold" Margin="6,4,6,6" TextWrapping="Wrap"/>
