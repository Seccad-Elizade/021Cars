                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="92"/>
                                                                        <ColumnDefinition Width="104"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding TarixMetni}" FontSize="11"
                                                                               Foreground="#E5E7EB"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding MeblegMetni}" FontSize="11"
                                                                               FontWeight="Bold" Foreground="#FBBF24"/>
