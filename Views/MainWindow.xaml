                                            <TextBlock Text="⚠ GECİKMİŞ" FontSize="10" FontWeight="Bold" Foreground="#FB7185"/>
                                            <TextBlock Text="{Binding Kassa.GecikmisMohlet, Converter={StaticResource Currency}}"
                                                       FontSize="19" FontWeight="Bold" Foreground="#FB7185" Margin="0,4,0,0"/>
                                            <TextBlock FontSize="9.5" Foreground="#64748B"
                                                       Text="{Binding Kassa.GecikmisSayi, StringFormat={}{0} möhlətin vaxtı keçib ⚠}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0B1220" CornerRadius="10" Padding="13,10" Margin="4,0,5,0"
                                            BorderBrush="#38BDF8" BorderThickness="1.5">
                                        <StackPanel>
                                            <TextBlock Text="📅 YAXIN 7 GÜNƏ GƏLƏCƏK" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <TextBlock Text="{Binding Kassa.YaxinHefteMohlet, Converter={StaticResource Currency}}"
