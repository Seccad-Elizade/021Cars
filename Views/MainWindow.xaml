                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,8,6" Width="130">
                                                                <TextBlock Text="🚗 MARKA" FontSize="9.5" Foreground="#94A3B8"/>
                                                                <TextBox Text="{Binding Credits.BarterMarka, UpdateSourceTrigger=PropertyChanged}"
