                                            <DataTemplate>
                                                <TextBlock Text="{Binding Tarix, StringFormat=dd.MM.yyyy}" Style="{StaticResource GridCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <DatePicker SelectedDate="{Binding Tarix, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Təyinat" Width="165">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
