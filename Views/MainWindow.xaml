                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"
                                                           Text="{Binding Calculator.EmsalCedveli}"/>
                                                <TextBlock Text="📊 ƏMSAL CƏDVƏLİ (müddətə görə avtomatik)" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="#64748B"/>
                                            </DockPanel>
                                            <Grid Margin="0,11,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="2.6*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="MAŞININ QİYMƏTİ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                                    <TextBlock FontSize="21" FontWeight="Bold" Foreground="#34D399"
                                                               Text="{Binding Calculator.MasinQiymeti, Converter={StaticResource Currency}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="KREDİTLƏŞDİRİLƏN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                                    <TextBlock FontSize="15" Foreground="#38BDF8"
                                                               Text="{Binding Calculator.MasinKredit, Converter={StaticResource Currency}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="DÜSTUR" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                                    <TextBlock FontSize="11.5" Foreground="#FACC15" TextWrapping="Wrap"
                                                               Text="Maşının qiyməti = (Aylıq × Ay) ÷ Əmsal + İlkin ödəniş"/>
                                                    <TextBlock FontSize="10.5" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"
                                                               Text="Nümunə: (12 × 1 985) ÷ 1,4 + 5 000 = 17 014,29 + 5 000 = 22 014 ₼"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>



                            <WrapPanel>
                                <StackPanel Margin="4">
