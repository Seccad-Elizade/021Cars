                    </Grid>
                    </ScrollViewer>

                </TabItem>

                <!-- ============================================================ -->
                <!-- TAB 5: KREDİT ÖDƏNİŞ QRAFİKİ                                  -->
                <!-- ============================================================ -->
                <TabItem Header="📅 Kredit Ödəniş Qrafiki">
                    <!-- 🌊 SƏHİFƏ SCROLL-U ✓ — kredit seçimi + ödəniş qrafiki cədvəli BİRLİKDƏ sürüşür ✓
                         (cədvəl `MaxHeight` ilə pəncərə hündürlüyünə məhduddur ✓ → virtualizasiya ✓✓✓)
                         ⚠ `FallbackValue=700` vacibdir ✓ — izah: «💳 Ümumi Xərclər» tabı ✓ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Padding="0,0,6,0">

                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Kredit seçimi -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Ödəniş qrafikinə baxmaq üçün krediti seçin" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Width="520" HorizontalAlignment="Left" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                          ItemsSource="{Binding Credits.FilteredScheduleCredits}"
                                          SelectedItem="{Binding Credits.SelectedCredit}"
                                          Text="{Binding Credits.ScheduleSearchText, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="🔍 Yazaraq axtarın: müqavilə №, müştəri adı, maşın dövlət nömrəsi, marka"
                                           FontSize="10" Foreground="#6B7280" Margin="2,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Seçilmiş kredit üzrə yekun göstəricilər -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <UniformGrid Columns="6">
                                <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#3B82F6">
                                    <StackPanel>
                                        <TextBlock Text="💵 Satış Qiyməti" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Credits.SelectedCredit.Mebleg, Converter={StaticResource Currency}}"
                                                   Style="{StaticResource StatValue}" Foreground="#60A5FA"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#F59E0B">
                                    <StackPanel>
                                        <TextBlock Text="🏦 Kreditləşdirilən" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Credits.SelectedCredit.Kreditlesdirilen, Converter={StaticResource Currency}}"
                                                   Style="{StaticResource StatValue}" Foreground="#FBBF24"/>
                                        <TextBlock Text="{Binding Credits.SelectedFaizVeQiymet}" FontSize="10"
                                                   Foreground="#FB923C" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   ToolTip="Faiz = Kreditləşdirilən × Faiz% ÷ 100 · Qiymət = Kreditləşdirilən + Faiz"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#10B981">
                                    <StackPanel>
                                        <TextBlock Text="✅ Ödənilib" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Credits.SelectedOdenilen, Converter={StaticResource Currency}}"
                                                   Style="{StaticResource StatValue}" Foreground="#34D399"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#EF4444">
                                    <StackPanel>
                                        <TextBlock Text="⏳ Qalıq (kredit + faiz)" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Credits.SelectedQaliq, Converter={StaticResource Currency}}"
                                                   Style="{StaticResource StatValue}" Foreground="#F87171"/>
                                        <TextBlock Text="{Binding Credits.SelectedQaliqIzahi}" FontSize="10"
                                                   Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   ToolTip="Qalıq = Kreditin qiyməti (kreditləşdirilən + faiz) − ödənilmiş"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#A855F7">
                                    <StackPanel>
                                        <TextBlock Text="🔢 Ödəniş Sayı" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Credits.SelectedOdenisSayi}"
                                                   Style="{StaticResource StatValue}" Foreground="#C084FC"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#06B6D4">
                                    <StackPanel>
                                        <TextBlock Text="📆 Son Ödəniş" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Text="{Binding Credits.SelectedSonOdenis}"
                                                   Style="{StaticResource StatValue}" FontSize="18" Foreground="#22D3EE"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="6,10,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ödəniş tamamlanması:" FontSize="11" Foreground="#9CA3AF"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ProgressBar Grid.Column="1" VerticalAlignment="Center"
                                             Value="{Binding Credits.SelectedOdenisFaizi, Mode=OneWay}"
                                             Style="{StaticResource CreditProgressBar}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Credits.SelectedFaizVeMuddet}" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <TextBlock Text="   •   " FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Credits.SelectedMohletYekunu}" FontSize="11" FontWeight="Bold" Foreground="#FACC15" VerticalAlignment="Center"/>
                                    <TextBlock Text="   •   " FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Credits.SelectedGecikmeYekunu}" FontSize="11" FontWeight="Bold" Foreground="#FB7185" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Border Grid.Row="2" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="6" Effect="{StaticResource GlassShadow}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="📅 Ödəniş Qrafiki — hər ayı işarələyin; hissə-hissə ödənişlər avtomatik cəmlənir.  🔴 qırmızı = az ödəniş / aktiv gecikmə,  🟢 yaşıl = artıq ödəniş,  🔵 mavi = artıq ödənişin son aylardan çıxılan hissəsi,  🟠 narıncı = müddətdən kənar,  🟡 sarı = möhlət (rəsmi gecikdirmə),  ⚠️ çəhrayı = gecikmə (cərimə ilə).  Sətir fonu da vəziyyətə uyğun rənglənir." FontSize="13" FontWeight="Bold" Margin="6,4,6,2" TextWrapping="Wrap"/>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Credits.ScheduleInfo}" FontSize="11" Foreground="#38BDF8" Margin="6,0,6,8"/>
                                <DataGrid ItemsSource="{Binding Credits.Schedule}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          ColumnHeaderHeight="46" RowStyle="{StaticResource ScheduleRowStyle}"
                                          ColumnHeaderStyle="{StaticResource ProfessionalHeader}"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                                          RowBackground="#0F172A" AlternatingRowBackground="#111827"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.PanningMode="Both"
                                          ScrollViewer.PanningDeceleration="0.001"
                                          MinHeight="380"
                                          MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}"
                                          IsManipulationEnabled="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="№" Binding="{Binding NoText}" SortMemberPath="No" Width="50" ElementStyle="{StaticResource OutOfRangeCellText}"/>
                                        <DataGridTextColumn Header="Vəziyyət" Binding="{Binding Novu}" Width="130" ElementStyle="{StaticResource OutOfRangeCellText}"/>
                                        <DataGridTextColumn Header="🟡 Möhlət" Binding="{Binding MohletMetni}" Width="150" ElementStyle="{StaticResource MohletCellText}"/>
                                        <DataGridTextColumn Header="⚠️ Gecikmə" Binding="{Binding GecikmeMetni}" Width="165" ElementStyle="{StaticResource GecikmeCellText}"/>
                                        <!-- 🆕 AZ / ARTIQ ÖDƏNİŞ + SON AYLARDAN ÇIXILAN (rəngli) -->
                                        <DataGridTextColumn Header="🔴 Az ödəniş" Binding="{Binding AzOdenisMetni}" Width="150"
                                                            ToolTipService.ToolTip="Plan məbləğindən az ödənilib — çatışmayan məbləğ"
                                                            ElementStyle="{StaticResource AzOdenisCellText}"/>
                                        <DataGridTextColumn Header="🟢 Artıq ödəniş" Binding="{Binding ArtiqOdenisMetni}" Width="160"
                                                            ToolTipService.ToolTip="Plan məbləğindən çox ödənilib"
                                                            ElementStyle="{StaticResource ArtiqOdenisCellText}"/>
                                        <DataGridTextColumn Header="🔵 Son aylardan" Binding="{Binding ArtiqKecenMetni}" Width="160"
                                                            ToolTipService.ToolTip="Artıq ödənişin SONUNCU aylardan çıxılan hissəsi"
                                                            ElementStyle="{StaticResource ArtiqKecenCellText}"/>
                                    <DataGridTextColumn Header="👥 Tərəfdaş bölgüsü" Binding="{Binding TerefdasMetni}" Width="195"
                                                        Visibility="{Binding DataContext.Credits.AnyBolgu, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Converter={StaticResource BoolToVis}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="FontSize" Value="10.5"/>
                                                <Setter Property="Foreground" Value="#34D399"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                        <DataGridTextColumn Header="📅 PLAN TARİXİ" Binding="{Binding Tarix, StringFormat=dd.MM.yyyy}" Width="125"
                                                            ToolTipService.ToolTip="Kredit qrafikinə görə ödənişin EDİLMƏLİ OLDUĞU tarix (başlama tarixi + taksit ayı)"
                                                            ElementStyle="{StaticResource OutOfRangeDateText}"/>
                                        <DataGridTextColumn Header="💰 Aylıq Ödəniş (plan)" Binding="{Binding NetOdenis, Converter={StaticResource Currency}}" Width="150" ElementStyle="{StaticResource PaymentAmountCellText}"/>
                                        <DataGridTextColumn Header="Əsas Borc" Binding="{Binding EsasBorclu, Converter={StaticResource Currency}}" Width="130" ElementStyle="{StaticResource OutOfRangeCellText}"/>
                                        <DataGridTextColumn Header="Faiz" Binding="{Binding Faiz, Converter={StaticResource Currency}}" Width="115" ElementStyle="{StaticResource OutOfRangeCellText}"/>
                                        <DataGridTextColumn Header="Qalıq" Binding="{Binding Qaliq, Converter={StaticResource Currency}}" Width="130" ElementStyle="{StaticResource OutOfRangeCellText}"/>
                                        <DataGridTemplateColumn Header="Ödənilib?" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Odenilib, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Ödəniş sayı" Binding="{Binding OdenisSayi}" Width="90" ElementStyle="{StaticResource OutOfRangeCellText}"/>
                                        <DataGridTextColumn Header="Ödənilən (AZN)" Binding="{Binding OdenilenMebleg, Converter={StaticResource Currency}}" Width="135" ElementStyle="{StaticResource OutOfRangeAmountText}"/>
                                        <DataGridTemplateColumn Header="✅ ÖDƏNİŞ EDİLDİYİ TARİX" Width="215">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding OdenisDetali}">
                                                        <TextBlock Text="{Binding OdenisTarixleri}" FontSize="11"
                                                                   Foreground="#4ADE80" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding TarixFerqMetni}" FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding TarixFerqReng}"
                                                                   Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>

                </TabItem>

                <!-- ============================================================ -->
                <!-- TAB 6: KREDİT ƏLAVƏ GƏLİR/XƏRC                              -->
                <!-- ============================================================ -->
                <TabItem Header="🏷️ Kredit Əlavə Gəlir/Xərc">
                    <!-- 🌊 SƏHİFƏ SCROLL-U ✓ — statistika + əməliyyat forması + cədvəllər BİRLİKDƏ sürüşür ✓
                         (cədvəllər `MaxHeight` ilə pəncərə hündürlüyünə məhduddur ✓ → virtualizasiya ✓✓✓)
                         ⚠ `FallbackValue=700` vacibdir ✓ — izah: «💳 Ümumi Xərclər» tabı ✓ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Padding="0,0,6,0">

                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#10B981">
                                <StackPanel>
                                    <TextBlock Text="Ümumi Gəlir" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding CreditTransactions.TotalIncome, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#34D399"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#EF4444">
                                <StackPanel>
                                    <TextBlock Text="Ümumi Xərc" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding CreditTransactions.TotalExpense, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#F43F5E"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#3B82F6">
                                <StackPanel>
                                    <TextBlock Text="Xalis Nəticə" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding CreditTransactions.Net, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#60A5FA"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#A855F7">
                                <StackPanel>
                                    <TextBlock Text="Əməliyyat Sayı" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding CreditTransactions.Transactions.Count}" Style="{StaticResource StatValue}" Foreground="#C084FC"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Müqavilə" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="360" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                              ItemsSource="{Binding CreditTransactions.FilteredCredits}"
                                              SelectedItem="{Binding CreditTransactions.SelectedCredit}"
                                              Text="{Binding CreditTransactions.CreditSearchText, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Yazaraq axtarın: müqavilə №, ad, maşın nömrəsi, marka"
                                               FontSize="10" Foreground="#6B7280" Margin="2,3,0,0" MaxWidth="360" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Növ" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="110" ItemsSource="{Binding CreditTransactions.Types}" SelectedItem="{Binding CreditTransactions.Nov}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Məbləğ (AZN)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CtMebleg" Width="110" Text="{Binding CreditTransactions.Mebleg, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CtMebleg}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Tarix" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker Width="130" SelectedDate="{Binding CreditTransactions.Tarix}"/>
                                    <TextBlock Text="{Binding CreditTransactions.TaksitInfo}" FontSize="11" Foreground="#38BDF8"
                                               Margin="2,4,0,0" MaxWidth="200" TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- 📤 TRANSFER OLUNMAQ (yalnız bu növ üçün) ✓ -->
                            <StackPanel Margin="4"
                                        Visibility="{Binding CreditTransactions.IsTransferOlunmaq, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="📤 TRANSFER EDİLƏN ŞƏXS (adı yazın — üçbucaqdan seçin ✓)"
                                           FontSize="9.5" Foreground="#38BDF8"/>
                                <ComboBox Width="170" IsEditable="True" IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          ItemsSource="{Binding CreditTransactions.TransferSexsleri}"
                                          Text="{Binding CreditTransactions.TransferSexsAdi, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Adı yazın (məs. Tural) → üçbucağa basanda mövcud şəxslər siyahıda çıxır ✓ · yeni ad yazsanız da qəbul olunur ✓"/>
                            </StackPanel>

                            <!-- 🤝 BARTER · BARTER KÖHNƏ (yalnız bu növlər üçün) ✓ -->
                            <StackPanel Margin="4"
                                        Visibility="{Binding CreditTransactions.IsBarter, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🤝 BARTER MAŞINI (MARKA · MODEL · SƏNƏD)" FontSize="9.5" Foreground="#F59E0B"/>
                                <WrapPanel>
                                    <ComboBox Width="110" IsEditable="True" IsTextSearchEnabled="True"
                                              StaysOpenOnEdit="True"
                                              ItemsSource="{Binding CreditTransactions.BarterMarkalari}"
                                              Text="{Binding CreditTransactions.BarterMarka, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Avto Park formatı — MARKA · üçbucaqdan seçin və ya yazın ✓"/>
                                    <TextBox Width="90" Margin="4,0,0,0" ToolTip="MODEL (məs. 2107)"
                                             Text="{Binding CreditTransactions.BarterModel, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Width="80" Margin="4,0,0,0" ToolTip="Barter sənədinin adı (məs. M188)"
                                             Text="{Binding CreditTransactions.BarterSenedAdi, UpdateSourceTrigger=PropertyChanged}"/>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Margin="4" Visibility="{Binding CreditTransactions.IsMohlet, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="⏸ Möhlət — son tarix" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker Width="130" SelectedDate="{Binding CreditTransactions.MohletTarixi}"/>
                                    <TextBlock Text="Ödəniş bu tarixə qədər gecikdirilir" FontSize="10" Foreground="#FACC15" Margin="2,3,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding CreditTransactions.IsGecikme, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="⚠ Gecikmə — tarix" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker Width="130" SelectedDate="{Binding CreditTransactions.GecikmeTarixi}"/>
                                    <TextBlock Text="Ödəniş bu tarixə qədər gecikmişdir" FontSize="10" Foreground="#FB7185" Margin="2,3,0,0"/>
                                </StackPanel>

                                <!-- 📕 VAXTINDAN TEZ BAĞLAMA (yalnız bu növ üçün) ✓✓✓ -->
                                <StackPanel Margin="4" Visibility="{Binding CreditTransactions.IsErkenBaglama, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="📕 Vaxtından tez bağlama" Style="{StaticResource FieldLabel}"/>
                                    <WrapPanel>
                                        <TextBox Width="110" FontWeight="SemiBold" Foreground="#34D399"
                                                 Text="{Binding CreditTransactions.Mebleg, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="MÜŞTƏRİNİN VERSƏCƏYİ pul (₼) ✓"/>
                                        <TextBox Width="110" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="#FBBF24"
                                                 Text="{Binding CreditTransactions.Guzest, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="💰 GÜZƏŞT — kreditin QALIĞINDAN ÇIXILAN pul (₼) ✓ (salonun endirimi ✓)"/>
                                    </WrapPanel>
                                    <TextBlock FontSize="10" Foreground="#94A3B8" Margin="2,3,0,0" TextWrapping="Wrap"
                                               Text="1️⃣ Məbləğ = müştərinin verəcəyi ✓   2️⃣ Güzəşt = qalıqdan çıxılan ✓"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Təsvir" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="200" Text="{Binding CreditTransactions.Tesvir, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- ==================================================== -->
                                <!-- 👥 TƏRƏFDAŞ MƏNFƏƏT BÖLGÜSÜ                        -->
                                <!--   Zaur %6 · Eşqin %5 · Asiman %5  (faiz payları)     -->
                                <!--   Asif & Musa → qalanı YARI-YARIYA bölürlər          -->
                                <!--   Faizlər də, məbləğlər də manual dəyişdirilə bilər  -->
                                <!-- ==================================================== -->
                                <Border Margin="4" Width="392" CornerRadius="10"
                                        Background="#0B1220" BorderBrush="#334155" BorderThickness="1"
                                        Visibility="{Binding CreditTransactions.IsBolguPaneli, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>

                                        <!-- ===== BAŞLIQ ZOLAĞI ===== -->
                                        <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="11,8">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center"
                                                          FontSize="11.5" FontWeight="SemiBold" Foreground="#34D399"
                                                          ToolTip="Bölgünü tətbiq et / ləğv et"
                                                          Content="{Binding CreditTransactions.BolguVeziyyetMetni}"
                                                          IsChecked="{Binding CreditTransactions.BolguTetbiqOlunub}"/>
                                                <TextBlock Text="👥 Tərəfdaş mənfəət bölgüsü" FontWeight="Bold"
                                                           FontSize="12.5" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- ===== BÖLGÜ BAZASI ===== -->
                                        <Grid Margin="11,9,11,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Bölgü bazası (₼)" FontSize="11.5"
                                                       Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" Height="27" VerticalContentAlignment="Center"
                                                     FontSize="13" FontWeight="SemiBold" Foreground="#34D399"
                                                     HorizontalContentAlignment="Right"
                                                     ToolTip="Bölünən mənfəət («xeyir») — manual dəyişdirilə bilər"
                                                     Text="{Binding CreditTransactions.BolguBazasi, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>

                                        <!-- ===== DÜYMƏLƏR ===== -->
                                        <UniformGrid Columns="3" Margin="11,0,11,9">
                                            <Button Content="📐 Məbləğdən götür" Style="{StaticResource iOSButton}" FontSize="11"
                                                    Background="#334155" Foreground="White" Margin="0,0,3,0"
                                                    ToolTip="Bazanı cari əməliyyat məbləğinə bərabər edir"
                                                    Command="{Binding CreditTransactions.BolguBazaniMeblegdenGotCommand}"/>
                                            <Button Content="🔄 Hesabla" Style="{StaticResource iOSButton}" FontSize="11"
                                                    Background="#2563EB" Foreground="White" Margin="3,0,3,0"
                                                    ToolTip="Payları yenidən hesablayır (faizlər + qalıq)"
                                                    Command="{Binding CreditTransactions.BolguHesablaCommand}"/>
                                            <Button Content="♻️ Default faizlər" Style="{StaticResource iOSButton}" FontSize="11"
                                                    Background="#475569" Foreground="White" Margin="3,0,0,0"
                                                    ToolTip="Zaur %6 · Eşqin %5 · Asiman %5 · Asif &amp; Musa qalıq"
                                                    Command="{Binding CreditTransactions.BolguDefaultFaizlerCommand}"/>
                                        </UniformGrid>

                                        <!-- ===== CƏDVƏL ===== -->
                                        <Border Margin="11,0,11,0" CornerRadius="7"
                                                Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                                            <StackPanel>
                                                <Border Background="#1F2937" CornerRadius="6,6,0,0" Padding="9,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="82"/>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="TƏTBİQ" FontSize="10" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="TƏRƏFDAŞ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                                        <TextBlock Grid.Column="2" Text="FAİZ %" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                                        <TextBlock Grid.Column="3" Text="MƏBLƏĞ (₼)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding CreditTransactions.TerefdasPaylari}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="9,4" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="46"/>
                                                                        <ColumnDefinition Width="82"/>
                                                                        <ColumnDefinition Width="58"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                              ToolTip="TƏTBİQ OLUNUR? — işarə qoyulmayıbsa bu tərəfdaşın faizi HESABLANMIR"
                                                                              IsChecked="{Binding Aktiv}"/>

                                                                    <TextBlock Grid.Column="1" Text="{Binding Terefdas}" FontSize="12.5"
                                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis">
