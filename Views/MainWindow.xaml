<Window x:Class="EnterpriseAeroStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:EnterpriseAeroStudio.Services"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Avtomobil Parkı v6.2.2 - Professional Fleet &amp; Office Edition"
        Height="940" Width="1550" MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#0B0F17" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, sans-serif">

    <!-- ============================================================
         QISA YOLLAR  -  Ctrl+Z silinmişləri geri qaytarır
         (dəfələrlə basmaqla ardıcıl olaraq əvvəlkilər də qaytarılır)
         ============================================================ -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding CarPark.RestoreLastCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding CarPark.ShowTrashCommand}"/>
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" CornerRadius="12" Padding="6" BorderBrush="#1F2937" BorderThickness="1" Effect="{StaticResource GlassShadow}">
            <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">

                    <!-- ============================================================
                         ⚠ MÜHÜM: XARİCİ ScrollViewer SİLİNDİ ✓✓✓  (PERFORMANS)
                         ============================================================
                         ƏVVƏL: hər tabın bütün məzmunu `CanContentScroll="False"`
                         olan bir ScrollViewer içində idi ✗ →
                         • daxildəki cədvəllər SONSUZ hündürlük alırdı ✗
                         • WPF sətir virtualizasiyasını TAMAMİLƏ SÖNDÜRÜRDÜ ✗
                         • 10 000+ sətirli cədvəllərdə proqram DONURDU ✗✓✓

                         İNDİ: hər tab ÖZ daxili scroll-una malikdir ✓
                         (cədvəllər «*» hündürlük alır → virtualizasiya işləyir ✓✓✓)
                         ============================================================ -->


                <!-- ============================================================ -->
                <!-- TAB 1: AVTO PARK & ARXIV                                     -->
                <!-- ============================================================ -->
                <TabItem Header="🚘 Avto Park &amp; Arxiv">
                    <!-- 🌊 SƏHİFƏ SCROLL-U ✓ — statistika + avtomobil forması + avtomobil cədvəli
                         BİRLİKDƏ sürüşür ✓ (cədvəl `MaxHeight` ilə məhduddur ✓ → virtualizasiya İŞLƏYİR ✓✓✓)
                         ⚠ `MaxHeight` bağlantısında `FallbackValue=700` VACİBDİR ✓ — TAM İZAH: «💳 Ümumi Xərclər» tabı ✓ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Padding="0,0,6,0">

                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,16">
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#3B82F6">
                                <StackPanel>
                                    <TextBlock Text="🚘 Ümumi Avto Sayı" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding CarPark.TotalCars}" Style="{StaticResource StatValue}" Foreground="#60A5FA"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#10B981">
                                <StackPanel>
                                    <TextBlock Text="🟢 Satışda / Stokda" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding CarPark.AvailableCars}" Style="{StaticResource StatValue}" Foreground="#34D399"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#F59E0B">
                                <StackPanel>
                                    <TextBlock Text="🟠 Kreditdə" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding CarPark.CreditCars}" Style="{StaticResource StatValue}" Foreground="#FBBF24"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#38BDF8">
                                <StackPanel>
                                    <TextBlock Text="📤 Transfer" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding CarPark.TransferCars}" Style="{StaticResource StatValue}" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#A855F7">
                                <StackPanel>
                                    <TextBlock Text="💎 Toplam Maya Dəyəri" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding CarPark.TotalCost, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#C084FC"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Sıra №" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarSira" Width="60" Text="{Binding CarPark.Editor.SiraNomresi, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarSira}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Marka / Model" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarMarka" Width="140" Text="{Binding CarPark.Editor.Marka, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarMarka}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Dövlət Nömrəsi" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarReg" Width="110" Text="{Binding CarPark.Editor.QeydiyyatNisani, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarReg}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="VIN Kod" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarVin" Width="130" Text="{Binding CarPark.Editor.Vin, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarVin}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="İl" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarIl" Width="60" Text="{Binding CarPark.Editor.Il, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarIl}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Yürüş (km)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarYurus" Width="80" Text="{Binding CarPark.Editor.Yurus, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarYurus}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Yanacaq" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="120" ItemsSource="{Binding CarPark.Editor.FuelTypes}" SelectedItem="{Binding CarPark.Editor.Yanacaq}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Alış Tarixi" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker Width="130" SelectedDate="{Binding CarPark.Editor.AlisTarixi}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Saat" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarSaat" Width="60" Text="{Binding CarPark.Editor.AlisSaati, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarSaat}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Alış Üsulu" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="120" ItemsSource="{Binding CarPark.Editor.PurchaseMethods}" SelectedItem="{Binding CarPark.Editor.AlisUsulu}"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding CarPark.Editor.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Əvəzə Verilən Maşın" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="230"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              StaysOpenOnEdit="True"
                                              TextSearch.TextPath="DisplayName"
                                              ItemsSource="{Binding CarPark.Editor.BarterCandidates}"
                                              SelectedItem="{Binding CarPark.Editor.BarterCar}"
                                              DisplayMemberPath="DisplayName"
                                              ToolTip="Yazmağa başlayın — siyahı avtomatik süzülür. Seçilən maşın «Satıldı» olur və parkdan çıxır"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding CarPark.Editor.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Verilən Maşının Dəyəri" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Width="110" Text="{Binding CarPark.Editor.BarterDeyeri, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding CarPark.Editor.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Barter Təsviri (əvəz)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarBarter" Width="210" Text="{Binding CarPark.Editor.BarterTesviri, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarBarter}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4" Visibility="{Binding CarPark.Editor.IsBarter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Hesablaşma" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding CarPark.Editor.BarterSummary}" Foreground="#F59E0B" FontWeight="SemiBold"
                                               VerticalAlignment="Center" MaxWidth="230" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Alış Qiyməti (AZN)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarQiymet" Width="110" Text="{Binding CarPark.Editor.AlisQiymeti, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarQiymet}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Satış Qiyməti (AZN)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarSatis" Width="110" Text="{Binding CarPark.Editor.SatisQiymeti, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarSatis}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Width="110" ItemsSource="{Binding CarPark.Editor.CarStatuses}" SelectedItem="{Binding CarPark.Editor.Status}"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Kredit №" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CarKredit" Width="90" Text="{Binding CarPark.Editor.KreditNomresi, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource ValidationText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CarKredit}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>

                                <StackPanel Margin="10,18,4,0" Orientation="Horizontal">
                                    <Button Content="✨ Avtomobil Əlavə Et" Style="{StaticResource iOSButton}" Background="#10B981" Foreground="White" Margin="0,0,6,0"
                                            Command="{Binding CarPark.AddCarCommand}" IsEnabled="{Binding CarPark.IsBusy, Converter={StaticResource InverseBool}}"/>
                                    <Button Content="↺ Təmizlə" Style="{StaticResource iOSButton}" Background="#374151" Foreground="#F9FAFB"
                                            Command="{Binding CarPark.ClearFormCommand}"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <DockPanel Grid.Row="2" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📁 Sənəd &amp; Media Arxivi" Style="{StaticResource iOSButton}" Background="#2563EB" Foreground="White" Margin="4,0"
                                        Command="{Binding CarPark.OpenArchiveCommand}"/>
                                <Button Content="📊 Excel İxrac" Style="{StaticResource iOSButton}" Background="#0284C7" Foreground="White" Margin="4,0"
                                        Command="{Binding CarPark.ExportCarsCommand}"/>
                                <Button Content="↩️ Geri Qaytar (Ctrl+Z)" Style="{StaticResource iOSButton}" Background="#D97706" Foreground="White" Margin="4,0"
                                        ToolTip="Ən son silinmiş qeydi geri qaytarır — dəfələrlə basmaqla əvvəlkilər də qaytarılır"
                                        Command="{Binding CarPark.RestoreLastCommand}"/>
                                <Button Content="🗑 Silinənlər" Style="{StaticResource iOSButton}" Background="#7C3AED" Foreground="White" Margin="4,0"
                                        ToolTip="Silinmiş qeydlərin siyahısı (Ctrl+Shift+Z)"
                                        Command="{Binding CarPark.ShowTrashCommand}"/>
                                <Button Content="🗑️ Seçiləni Sil" Style="{StaticResource iOSButton}" Background="#EF4444" Foreground="White" Margin="4,0"
                                        Command="{Binding CarPark.DeleteCarCommand}"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBox Width="240" Text="{Binding CarPark.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="✏️ Redaktə etmək üçün sətrə iki dəfə klikləyin (Status və Yanacaq üçün siyahı açılır)"
                                           Foreground="#6B7280" FontSize="11" Margin="2,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="3" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="6" Effect="{StaticResource GlassShadow}">
                            <DataGrid x:Name="CarGrid" ItemsSource="{Binding CarPark.Cars}" SelectedItem="{Binding CarPark.SelectedCar}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                                      SelectionMode="Single" SelectionUnit="FullRow" RowHeight="40" ColumnHeaderHeight="42"
                                      MinHeight="380"
                                      MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}"
                                      RowEditEnding="CarGrid_RowEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding SiraNomresi, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="SiraNomresi" Width="55" ElementStyle="{StaticResource GridCellText}" EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                    <DataGridTextColumn Header="Marka / Model" Binding="{Binding Marka, UpdateSourceTrigger=PropertyChanged}" Width="150" ElementStyle="{StaticResource GridCellText}" EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                    <DataGridTextColumn Header="Dövlət Nömrəsi" Binding="{Binding QeydiyyatNisani, UpdateSourceTrigger=PropertyChanged}" Width="130" ElementStyle="{StaticResource GridCellText}" EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                    <DataGridTextColumn Header="VIN Kod" Binding="{Binding Vin, UpdateSourceTrigger=PropertyChanged}" Width="130" ElementStyle="{StaticResource GridCellText}" EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                    <DataGridTextColumn Header="İl" Binding="{Binding Il, UpdateSourceTrigger=PropertyChanged}" Width="70" ElementStyle="{StaticResource GridCellText}" EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                    <DataGridTextColumn Header="Yürüş (km)" Binding="{Binding Yurus, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource GridCellText}" EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                    <!-- 🗓️ ALIŞ TARİXİ — forma daxil edir, cədvəldə də görünməlidir -->
                                    <DataGridTextColumn Header="🗓️ Alış Tarixi" Binding="{Binding AlisTarixiMetni}"
                                                        SortMemberPath="AlisTarixi" Width="115" IsReadOnly="True"
                                                        ToolTipService.ToolTip="Avtomobilin alındığı tarix (formada «Alış Tarixi» xanası)"
                                                        ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="🕐 Saat" Binding="{Binding AlisSaati}"
                                                        Width="70" IsReadOnly="True"
                                                        ToolTipService.ToolTip="Alış saatı"
                                                        ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTemplateColumn Header="Yanacaq" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Yanacaq}" Style="{StaticResource GridCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource GridCellComboBox}"
                                                          ItemsSource="{x:Static svc:Catalog.FuelTypes}"
                                                          SelectedItem="{Binding Yanacaq, UpdateSourceTrigger=PropertyChanged}"
                                                          IsDropDownOpen="True" IsEditable="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Alış Qiyməti (AZN)" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AlisQiymeti, Converter={StaticResource Currency}}" Style="{StaticResource GridCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellTextBox}" Text="{Binding AlisQiymeti, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Satış Qiyməti (AZN)" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SatisQiymeti, Converter={StaticResource Currency}}" Style="{StaticResource GridCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource GridCellTextBox}" Text="{Binding SatisQiymeti, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Xərclər" Binding="{Binding Xercler, Converter={StaticResource Currency}}" Width="130" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Maya Dəyəri" Binding="{Binding MayaDeyeri, Converter={StaticResource Currency}}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="📎 Sənəd" Binding="{Binding SenedMetni}" Width="85" IsReadOnly="True"
                                                        SortMemberPath="SenedSayi" ElementStyle="{StaticResource SenedCellText}"/>
                                    <DataGridTemplateColumn Header="Status" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource GridCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource GridCellComboBox}"
                                                          ItemsSource="{x:Static svc:Catalog.CarStatuses}"
                                                          SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                          IsDropDownOpen="True" IsEditable="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Kredit №" Binding="{Binding KreditNomresi, UpdateSourceTrigger=PropertyChanged}" Width="110" ElementStyle="{StaticResource GridCellText}" EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                            <DataGridTextColumn Header="Alış Üsulu" Binding="{Binding AlisUsuluMetni}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="🔄 Barter Əvəzi" Binding="{Binding BarterCarInfo}" Width="190" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTemplateColumn Header="" Width="54" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="ℹ"
                                                        Style="{StaticResource iOSButton}"
                                                        Height="26" Padding="9,0" Margin="2,0"
                                                        Background="#2563EB" Foreground="White"
                                                        ToolTip="Avtomobil haqqında TAM məlumat — alış, barter əvəzi, xərclər, maya dəyəri, satış və kredit"
                                                        Command="{Binding DataContext.CarPark.ShowInfoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                    </ScrollViewer>

                </TabItem>

                <!-- ============================================================ -->
                <!-- TAB 2: ÜMUMİ XƏRCLƏR                                        -->
                <!-- ============================================================ -->
                <TabItem Header="💳 Ümumi Xərclər">
                    <!-- ============================================================
                         🌊 ÜMUMİ SƏHİFƏ SCROLL-U ✓✓✓
                         ============================================================
                         • Yuxarıdakı STATİSTİKA KARTLARI + BÖYÜK FORMA uzundur ✗ →
                           səhifə scroll-u olmasa cədvəl ÇOX AŞAĞIDA qalırdı ✗✓✓
                         • CƏDVƏLİN ÖZÜ `MaxHeight` ilə MƏHDUDLAŞDIRILIR ✓ →
                           VİRTUALİZASİYA İŞLƏYİR ✓ (milyon sətirdə də donma YOXDUR ✓✓✓)
                         ════════════════════════════════════════════════════════════
                         ⚠⚠ `MaxHeight` BAĞLANTISINDA `FallbackValue=700` VACİBDİR ★★★
                         ════════════════════════════════════════════════════════════
                         ① `MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource
                             AncestorType={x:Type ScrollViewer}}, FallbackValue=700,
                             TargetNullValue=700}"` ✓
                         ② ⚠ FallbackValue OLMASA → bağlantı İLK ÖLÇMƏ anında HƏLL
                            OLUNMUR ✗ → cədvəl SONSUZ hündürlüklə ölçülür ✗ →
                            BÜTÜN SƏTİRLƏR yığılır ✗ → 20 000 sətir = 64 SANİYƏ ✗✗✗
                         ③ ✅ FallbackValue=700 ilə İLK ÖLÇMƏ SONLUDUR ✓ →
                            virtualizasiya DƏRHAL işləyir ✓ → 20 000 sətir = 0.4 SANİYƏ ✓
                            (ekranda yalnız ~37 sətir çəkilir ✓✓✓)
                         ④ 📏 Sonra bağlantı REAL hündürlüyü gətirir ✓ → pəncərə ölçüsü
                            dəyişəndə cədvəl avtomatik uyğunlaşır ✓ (virtualizasiya pozulmur ✓)
                         ⑤ Bu qayda AŞAĞIDAKI BÜTÜN səhifə-scroll tablarında EYNİDİR ✓
                            (Avto Park · Satış · Kreditlər · Qrafik · Əlavə Gəlir/Xərc ·
                             Satılan & Bitmiş · Tərəfdaşlar ✓✓✓)
                         ============================================================ -->
                    <ScrollViewer x:Name="XercSehifeScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Padding="0,0,6,0">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <!-- 🚀 PERFORMANS: səhifə sayğacı + «⬇️ Daha çox» düyməsi ✓ -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#EF4444">
                                <StackPanel>
