                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Height="1" Background="#1F2937" Margin="0,4,0,10"/>
                                                <ItemsControl ItemsSource="{Binding Credits.Barterler}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#111827" CornerRadius="6" Padding="9,6"
                                                                    Margin="0,0,0,5" BorderBrush="#1F2937" BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="100"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="42"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Tesvir}"
                                                                               FontSize="11.5" Foreground="#E2E8F0"
                                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                                               Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Tarix, StringFormat=dd.MM.yyyy}"
                                                                               FontSize="11" Foreground="#94A3B8"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding Mebleg, Converter={StaticResource Currency}}"
                                                                               FontSize="12" FontWeight="Bold" Foreground="#F59E0B"
                                                                               VerticalAlignment="Center"
                                                                               ToolTip="Nisyədən çıxılan maya dəyəri ✓"/>
                                                                    <Button Grid.Column="3" Content="🗑️"
                                                                            Command="{Binding DataContext.Credits.BarterSilCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource iOSButton}" FontSize="11"
                                                                            Padding="4,2"
                                                                            ToolTip="Barter qeydini sil — maya yenidən nisyəyə əlavə olunur"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- ================================================ -->
                                                <!-- 📤 0b) KREDİT TRANSFER (maşını şəxsə vermək)      -->
                                                <!-- ================================================ -->
                                                <Border Height="1" Background="#1F2937" Margin="0,10,0,10"/>
                                                <TextBlock Text="📤 KREDİT TRANSFER — MAŞINI ŞƏXSƏ VER"
                                                           Style="{StaticResource CardSectionHeader}"/>
                                                <TextBlock Text="Şəxs seçin (məs. Tural) → «TRANSFER ET» — maşın həmin şəxsə verilir ✓. Yekunlar «📤 Transfer Olunan» tab-ında."
                                                           FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                                <TextBlock Text="{Binding Credits.TransferXulase}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"
                                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <Border Background="#0F172A" CornerRadius="7" Padding="9"
                                                        BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <StackPanel Margin="0,0,8,6" Width="180">
                                                                <TextBlock Text="👤 ŞƏXS SEÇ" FontSize="9.5" Foreground="#94A3B8"/>
                                                                <ComboBox ItemsSource="{Binding Credits.TransferSexsleri}"
                                                                          SelectedItem="{Binding Credits.SelectedTransferSexs}"
                                                                          ToolTip="Maşını kimə transfer edirik"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,8,6" Width="130">
                                                                <TextBlock Text="📅 TARİX" FontSize="9.5" Foreground="#94A3B8"/>
                                                                <DatePicker Width="120"
                                                                            SelectedDate="{Binding Credits.TransferTarixi}"
                                                                            ToolTip="Transfer sənədinin tarixi ✓ — PDF-də qeyd olunur ✓"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,8,6" Width="110">
                                                                <TextBlock Text="💰 PUL (₼)" FontSize="9.5" Foreground="#94A3B8"/>
                                                                <TextBox Text="{Binding Credits.TransferBeh, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="Şəxsin verdiyi PUL — avtomatik = KREDİTLƏŞDİRİLƏN məbləğ ✓ (əl ilə də düzəldə bilərsiniz ✓)"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,8,6" Width="130">
                                                                <TextBlock Text="📤 TRANSFER ET" FontSize="9.5" Foreground="#94A3B8"/>
                                                                <Button Content="📤 TRANSFER ET"
                                                                        Command="{Binding Credits.TransferEtCommand}"
                                                                        Style="{StaticResource iOSButton}" FontSize="11"
                                                                        ToolTip="Seçilmiş maşını seçilmiş şəxsə transfer edir ✓"/>
                                                            </StackPanel>
                                                        </WrapPanel>
                                                        <Border Height="1" Background="#1F2937" Margin="0,2,0,7"/>
