                                                                               Foreground="{Binding VeziyyetRengi}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- ================================================ -->
                                                <!-- ================================================ -->
                                                <!-- 🤝 0) BARTER (nisyədən ÇIXILAN maşın)             -->
                                                <!-- ================================================ -->
