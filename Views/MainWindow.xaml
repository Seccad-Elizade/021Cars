                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <!--BLOK-2-->
                        <!-- ===== BLOK 2 · 🏭 ANBAR & STOK  |  🏦 KREDİT PORTFELİ ===== -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ................ 🏭 ANBAR & STOK ................ -->
                            <Border Grid.Column="0" Background="#0B1220" CornerRadius="10" Margin="0,0,7,0"
                                    BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="14,9">
                                        <TextBlock Text="🏭 ANBAR &amp; STOK" FontWeight="Bold" FontSize="12.5" Foreground="#E2E8F0"/>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="10,10,10,4">
                                        <Border Background="#111827" CornerRadius="8" Padding="12,9" Margin="0,0,5,5">
