                                    <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="12,9">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       Text="{Binding Finance.RangeText}" FontSize="11" Foreground="#94A3B8"/>
                                            <TextBlock Text="👥 TƏRƏFDAŞ MƏNFƏƏT BÖLGÜLƏRİ (dövr üzrə)"
