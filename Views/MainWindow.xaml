                                            <TextBlock Text="{Binding Finance.RangeIncome, Converter={StaticResource Currency}}"
                                                       FontSize="22" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Finance.RangeIncomeFormula}" FontSize="10"
                                                       Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

