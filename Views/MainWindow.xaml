                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontSize="10" FontWeight="Bold"
                                                               Foreground="#F59E0B" VerticalAlignment="Center"
                                                               Text="{Binding Finance.PortfolioDelayProgressMetni}"/>
                                                    <TextBlock Text="⚠️ GECİKMƏ (CƏRİMƏ)" FontSize="10" FontWeight="Bold"
                                                               Foreground="#94A3B8"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Finance.PortfolioDelayRemaining, Converter={StaticResource Currency}}"
                                                           FontSize="17" FontWeight="Bold" Foreground="#F59E0B"/>
                                                <TextBlock Text="QALIQ GECİKMƏ BORCU (hələ ödənilməyib)" FontSize="9.5"
                                                           Foreground="#64748B" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Finance.PortfolioDelayBreakdown}" FontSize="9.5"
                                                           Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           ToolTip="Nə qədər gecikmə olub − nə qədəri ödənilib = nə qədəri qalıb"/>
                                                <TextBlock Text="{Binding Finance.PortfolioDelayYekunu}" FontSize="9.5"
                                                           Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           ToolTip="Ümumi gecikmə sayı və cərimə məbləği"/>
                                                <TextBlock Text="{Binding Finance.DelayTableMetni}" FontSize="9.5"
                                                           FontWeight="SemiBold" Foreground="#38BDF8"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
