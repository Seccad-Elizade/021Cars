                                               qarışdırılmır — tamamilə AYRI göstəricidir ✓
                                             ========================================== -->
                                        <Border Background="#111827" CornerRadius="8" Padding="12,9" Margin="0,5,5,0"
                                                BorderBrush="#8B5CF6" BorderThickness="1"
                                                ToolTip="Müştərilərin kredit götürəndə verdiyi İLKİN ÖDƏNİŞLƏR (avanslar) — portfel borcuna və ödənilmişlərə qarışmır ✓">
                                            <StackPanel>
                                                <TextBlock Text="💰 İLKİN ÖDƏNİŞLƏR (AVANS)" FontSize="10"
                                                           FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding Finance.PortfolioDownPayment, Converter={StaticResource Currency}}"
                                                           FontSize="17" FontWeight="Bold" Foreground="#A78BFA"/>
                                                <TextBlock Text="{Binding Finance.PortfolioDownPaymentText}" FontSize="9.5"
                                                           Foreground="#64748B" TextWrapping="Wrap"/>
                                                <TextBlock Text="müştərinin kredit götürəndə verdiyi pul ✓" FontSize="9.5"
