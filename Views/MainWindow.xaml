                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,8,6" Width="130">
                                                                <TextBlock Text="📅 TARİX" FontSize="9.5" Foreground="#94A3B8"/>
                                                                <DatePicker SelectedDate="{Binding Credits.BarterTarix}"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,8,6" Width="190">
                                                                <TextBlock Text="📝 QEYD" FontSize="9.5" Foreground="#94A3B8"/>
                                                                <TextBox Text="{Binding Credits.BarterQeyd, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </StackPanel>
                                                        </WrapPanel>
