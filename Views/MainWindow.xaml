                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Qrup" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Qrup}" Style="{StaticResource GridCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource GridCellComboBox}"
                                                          ItemsSource="{Binding DataContext.Expenses.AllGroups, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                          SelectedItem="{Binding Qrup, UpdateSourceTrigger=PropertyChanged}"
                                                          IsDropDownOpen="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Kateqoriya" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Kategoriya}" Style="{StaticResource GridCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource GridCellComboBox}" IsEditable="True"
                                                          ItemsSource="{Binding DataContext.Expenses.AllCategories, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                          Text="{Binding Kategoriya, UpdateSourceTrigger=PropertyChanged}"
                                                          IsDropDownOpen="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Avtomobil" Width="*">
