                                            Command="{Binding Calculator.HesablaCommand}"/>
                                    <Button Content="↺ Sıfırla" Style="{StaticResource iOSButton}" Background="#374151" Foreground="#F9FAFB"
                                            Command="{Binding Calculator.SifirlaCommand}"/>
                                </StackPanel>
                            </WrapPanel>

                            <UniformGrid Columns="4" Margin="0,24,0,0" Visibility="{Binding Calculator.Hesablanib, Converter={StaticResource BoolToVis}}">
