                                                           FontSize="17" FontWeight="Bold" Foreground="#0891B2"/>
                                                <TextBlock Text="{Binding Finance.RangeStockAdditionsFormula}" FontSize="9.5"
                                                           Foreground="#64748B" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#111827" CornerRadius="8" Padding="12,9" Margin="5,5,0,0">
                                            <StackPanel>
                                                <TextBlock Text="SATILAN MALIN MAYASI" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding Finance.RangeCostOfSold, Converter={StaticResource Currency}}"
