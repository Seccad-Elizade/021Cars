                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource GridCellComboBox}"
                                                          ItemsSource="{x:Static svc:Catalog.ExpenseDestinations}"
                                                          SelectedItem="{Binding Teyinat, UpdateSourceTrigger=PropertyChanged}"
