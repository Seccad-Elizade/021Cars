                                                                             Text="{Binding Faiz, UpdateSourceTrigger=PropertyChanged}"/>

                                                                    <TextBox Grid.Column="3" Height="24" FontSize="12.5" FontWeight="SemiBold"
                                                                             Foreground="#34D399" Margin="6,0,0,0"
                                                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                                             ToolTip="Məbləğ (₼) — manual düzəliş edilə bilər"
                                                                             IsEnabled="{Binding Aktiv}"
                                                                             Text="{Binding Mebleg, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- ===== YEKUN ===== -->
                                        <Border Margin="11,8,11,11" CornerRadius="7" Background="#111827"
                                                BorderBrush="#1F2937" BorderThickness="1" Padding="10,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontSize="13.5" FontWeight="Bold" Foreground="#FACC15">
                                                        <Run Text="{Binding CreditTransactions.BolguCemi, Mode=OneWay, Converter={StaticResource Currency}}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="PAYLARIN CƏMİ" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding CreditTransactions.BolguXulase}" FontSize="10.5"
                                                           Foreground="#34D399" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CreditTransactions.BolguFergiMetni}" FontSize="10.5"
                                                           Margin="0,3,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                                           Foreground="{Binding CreditTransactions.BolguFergiRengi}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="10,18,4,0" Orientation="Horizontal">
                                    <Button Content="+ Əlavə Et" Style="{StaticResource iOSButton}" Background="#2563EB" Foreground="White" Margin="0,0,6,0"
                                            Command="{Binding CreditTransactions.AddTransactionCommand}"/>
                                    <Button Content="🗑️ Sil" Style="{StaticResource iOSButton}" Background="#EF4444" Foreground="White"
                                            Command="{Binding CreditTransactions.DeleteTransactionCommand}"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="6" Margin="0,0,8,0" Effect="{StaticResource GlassShadow}">
