                                                     ToolTip="Müddətə görə avtomatik yazılır (6→1.2 · 12→1.4 · 24→1.8 · 36→2.2 · 42→2.4 · 48→2.6 · 60→3.0 ✓) — ƏL İLƏ də dəyişdirə bilərsiniz"
                                                     Text="{Binding Calculator.Emsal, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="10,18,4,0" Orientation="Horizontal">
                                            <Button Content="🔄 Hesabla" Style="{StaticResource iOSButton}" Background="#0EA5E9" Foreground="White" Margin="0,0,6,0"
                                                    Command="{Binding Calculator.TersHesablaCommand}"/>
                                            <Button Content="⬅️ Kalkulyatora köçür" Style="{StaticResource iOSButton}" Background="#2563EB" Foreground="White"
                                                    ToolTip="Nəticəni yuxarıdaki kalkulyatora köçürür və aylıq ödənişi yoxlayır"
                                                    Command="{Binding Calculator.TersNeticeKocurCommand}"/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <Border Background="#111827" CornerRadius="8" Padding="14,11" Margin="4,12,4,0"
                                            BorderBrush="#1F2937" BorderThickness="1">
