                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Margin="4,8,4,0" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                                   Text="{Binding Tevim.SecilmisAyVeziyyet}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ============ 📄 SEÇİLMİŞ AYIN BÜTÜN ÖDƏNİŞLƏRİ ============ -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Tevim.SecilmisAyAdi, StringFormat=📄 {0} — bütün ödəniş sətirləri ✓}"
                                               FontSize="12" FontWeight="Bold" Foreground="#F9FAFB" Margin="4,2,4,8"/>
                                    <DataGrid ItemsSource="{Binding Tevim.AySetirleri}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              SelectionMode="Single" RowHeight="30" ColumnHeaderHeight="32"
                                              MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=430, TargetNullValue=430}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="📅 Tarix" Binding="{Binding TarixMetni}" Width="95"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="⏱️ NƏ VAXTDIR?" Binding="{Binding VaxtMetni}" Width="175"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Növ" Binding="{Binding Nov}" Width="175"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Müştəri" Binding="{Binding Mustar}" Width="*" MinWidth="110"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Avtomobil" Binding="{Binding Avtomobil}" Width="*" MinWidth="140"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Müqavilə №" Binding="{Binding Muqavile}" Width="95"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Məbləğ" Binding="{Binding MeblegMetni}" Width="110"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- ============ 🔎 AXTARIŞ NƏTİCƏLƏRİ (bütün aylar üzrə) ============ -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="10"
                                    Visibility="{Binding Tevim.AxtarisVar, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="🔎 AXTARIŞ NƏTİCƏLƏRİ — bütün aylar üzrə ✓" FontSize="12"
                                               FontWeight="Bold" Foreground="#FBBF24" Margin="4,2,4,8"/>
                                    <DataGrid ItemsSource="{Binding Tevim.AxtarisSetirleri}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              SelectionMode="Single" RowHeight="30" ColumnHeaderHeight="32"
                                              MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=330, TargetNullValue=330}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="📅 Tarix" Binding="{Binding TarixMetni}" Width="95"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="⏱️ NƏ VAXTDIR?" Binding="{Binding VaxtMetni}" Width="175"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Müştəri" Binding="{Binding Mustar}" Width="*" MinWidth="110"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Avtomobil" Binding="{Binding Avtomobil}" Width="*" MinWidth="140"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Məbləğ" Binding="{Binding MeblegMetni}" Width="110"
                                                                ElementStyle="{StaticResource GridCellText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="2,0,2,14" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"
                                       Text="ℹ️ Bu cədvəl «🔔 Bildirişlər» tabı ilə EYNİ mənbədən qurulur ✓ (kredit taksitləri ✓ möhlətlər ✓ gecikmə cərimələri ✓) — rəqəmlər həmişə üst-üstə düşür ✓✓✓ · rəsmi/kanonik qrafik: «📅 Kredit Ödəniş Qrafiki» tabı ✓"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>



                <!-- ============================================================ -->
                <!-- TAB: SATILAN & KREDİTİ BİTMİŞ                                -->
                <!-- ============================================================ -->
                <TabItem Header="🗄️ Satılan &amp; Krediti Bitmiş">
                    <!-- 🌊 SƏHİFƏ SCROLL-U ✓ — statistika + İKİ cədvəl (satılan avtomobillər · bitmiş kreditlər)
                         BİRLİKDƏ sürüşür ✓ (cədvəllər `MaxHeight` ilə məhduddur ✓ → virtualizasiya ✓✓✓)
                         ⚠ `FallbackValue=700` vacibdir ✓ — izah: «💳 Ümumi Xərclər» tabı ✓ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Padding="0,0,6,0">

                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#3B82F6">
                                <StackPanel>
                                    <TextBlock Text="🗄️ Satılan Avtomobil" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding SalesArchive.SoldCarsCount}" Style="{StaticResource StatValue}" Foreground="#60A5FA"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#10B981">
                                <StackPanel>
                                    <TextBlock Text="💵 Satış Gəliri" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding SalesArchive.TotalSoldRevenue, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#34D399"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#A855F7">
                                <StackPanel>
                                    <TextBlock Text="📈 Satış Mənfəəti" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding SalesArchive.TotalSoldProfit, Converter={StaticResource Currency}}" Style="{StaticResource StatValue}" Foreground="#C084FC"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#F59E0B">
                                <StackPanel>
                                    <TextBlock Text="✅ Krediti Bitmiş" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding SalesArchive.CompletedCreditsCount}" Style="{StaticResource StatValue}" Foreground="#FBBF24"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <DockPanel Grid.Row="1" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="↩️ Seçilmiş Avtomobili Geri Qaytar" Style="{StaticResource iOSButton}"
                                    Background="#2563EB" Foreground="White" HorizontalAlignment="Right"
                                    Command="{Binding SalesArchive.RestoreCarCommand}"/>
                            <TextBlock Text="Satılan avtomobillər və müddəti bitmiş kreditlər buraya avtomatik düşür."
                                       Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="6" Margin="0,0,8,0" Effect="{StaticResource GlassShadow}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="6,4,6,4">
                                        <TextBlock DockPanel.Dock="Left" Text="🗂️ Satılan Avtomobillər" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding SalesArchive.SoldCarCountText}"
                                                   FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="2,0,2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                                                 ToolTip="Yazaraq axtarın: marka / model, dövlət nömrəsi, VIN"
                                                 Text="{Binding SalesArchive.SoldCarSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Content="✖" Style="{StaticResource iOSButton}" Margin="6,0,0,0" Padding="10,0"
                                                Background="#374151" Foreground="#F9FAFB"
                                                ToolTip="Satılan avtomobil axtarışını təmizlə"
                                                Command="{Binding SalesArchive.ClearSoldCarSearchCommand}"/>
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" Text="🔍 Axtar: marka / model, dövlət nömrəsi, VIN"
                                               FontSize="10" Foreground="#6B7280" Margin="4,0,4,6" TextWrapping="Wrap"/>
                                    <DataGrid ItemsSource="{Binding SalesArchive.FilteredSoldCars}" SelectedItem="{Binding SalesArchive.SelectedSoldCar}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="40" ColumnHeaderHeight="42"
                                              MinHeight="380"
                                              MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}"
                                              ToolTip="🖱️ Sətirə İKİ DƏFƏ KLİK → avtomobilin BÜTÜN məlumatı (xərclər · kredit · paylar) + 📄 PDF ixracı ✓">
                                        <DataGrid.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding SalesArchive.AvtomobilDetayAcCommand}"/>
                                        </DataGrid.InputBindings>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="№" Binding="{Binding SiraNomresi}" SortMemberPath="SiraNomresi" Width="50" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Marka / Model" Binding="{Binding Marka}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Dövlət Nömrəsi" Binding="{Binding QeydiyyatNisani}" Width="130" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Maya Dəyəri" Binding="{Binding MayaDeyeri, Converter={StaticResource Currency}}" Width="150" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="📎 Sənəd" Binding="{Binding SenedMetni}" Width="85" SortMemberPath="SenedSayi" ElementStyle="{StaticResource SenedCellText}"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" ElementStyle="{StaticResource GridCellText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="6" Effect="{StaticResource GlassShadow}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="6,4,6,4">
                                        <TextBlock DockPanel.Dock="Left" Text="✅ Krediti Bitmiş / Bağlı Kreditlər" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding SalesArchive.CompletedCreditCountText}"
                                                   FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="2,0,2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                                                 ToolTip="Yazaraq axtarın: müqavilə №, müştəri, avtomobil markası / nömrəsi, status"
                                                 Text="{Binding SalesArchive.CreditSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Content="✖" Style="{StaticResource iOSButton}" Margin="6,0,0,0" Padding="10,0"
                                                Background="#374151" Foreground="#F9FAFB"
                                                ToolTip="Kredit axtarışını təmizlə"
                                                Command="{Binding SalesArchive.ClearCreditSearchCommand}"/>
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" Text="🔍 Axtar: müqavilə №, müştəri, avtomobil markası / nömrəsi, status"
                                               FontSize="10" Foreground="#6B7280" Margin="4,0,4,6" TextWrapping="Wrap"/>
                                    <DataGrid ItemsSource="{Binding SalesArchive.FilteredCompletedCredits}"
                                              SelectedItem="{Binding SalesArchive.SelectedCompletedCredit}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="40" ColumnHeaderHeight="42"
                                              MinHeight="380"
                                              MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}"
                                              ToolTip="🖱️ Sətirə İKİ DƏFƏ KLİK → kreditin BÜTÜN məlumatı (avtomobil · xərclər · hərəkətlər · paylar) + 📄 PDF ixracı ✓">
                                        <DataGrid.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding SalesArchive.KreditDetayAcCommand}"/>
                                        </DataGrid.InputBindings>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Müqavilə" Binding="{Binding MuqavileNomresi}" Width="110" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Müştəri" Binding="{Binding Mustəri}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Avtomobil" Binding="{Binding Car.DisplayName}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Məbləğ" Binding="{Binding Mebleg, Converter={StaticResource Currency}}" Width="140" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Müddət" Binding="{Binding MuddetAy}" Width="80" ElementStyle="{StaticResource GridCellText}"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" ElementStyle="{StaticResource GridCellText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    </ScrollViewer>

                </TabItem>

                <!-- ============================================================
                     🌐 VEB SAYT  -  veb server idareetmesi + daxili brauzer
                     Proqram acilanda veb server AVTOMATIK ise dusur.
                     ============================================================ -->
                <!-- ============================================================ -->
                <!-- TAB 11: 👥 TƏRƏFDAŞLAR — BÖLGÜ MƏRKƏZİ                      -->
                <!-- Bütün bölgülər (satış + kredit + əlavə gəlir) BURADA toplanır -->
                <!-- ============================================================ -->
                <!-- ===== 🤝 BARTER KEÇMİŞİ ===== -->
                <TabItem Header="🤝 Barter Keçmişi" Visibility="Collapsed">
                    <Border Background="#0B1220" Padding="14">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#111827" CornerRadius="10"
                                    Padding="14,11" BorderBrush="#F59E0B" BorderThickness="1"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🤝 BARTER KEÇMİŞİ" FontSize="15" FontWeight="Bold"
                                               Foreground="#F59E0B"/>
                                    <TextBlock Text="Barter edilən maşınlar — yalnız MAŞIN ADI və QİYMƏTİ ✓ · bu məbləğ kreditin NİSYƏ qiymətindən ÇIXILIR ✓"
                                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                               Margin="0,3,0,8"/>
                                    <TextBlock Text="{Binding Credits.BarterKecmisXulase}" FontSize="13"
                                               FontWeight="Bold" Foreground="#FBBF24" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.PanningMode="Both" IsManipulationEnabled="True">
                                <ItemsControl ItemsSource="{Binding Credits.BarterKecmisi}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" CornerRadius="9" Padding="13,10"
                                                    Margin="0,0,0,8" BorderBrush="#1F2937" BorderThickness="1">
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#E2E8F0"
                                                           TextWrapping="Wrap" LineHeight="19"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- ===== 📤 KREDİT TRANSFER ===== -->
                <TabItem Header="📤 Transfer" Visibility="Collapsed">
                    <Border Background="#0B1220" Padding="14">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#111827" CornerRadius="10"
                                    Padding="14,11" BorderBrush="#38BDF8" BorderThickness="1"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📤 KREDİT TRANSFER — MAŞINI ŞƏXSƏ VER"
                                               FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock Text="Kredit seçin → şəxs seçin (məs. Tural) → «TRANSFER ET» ✓ · insanları özünüz əlavə edib silə bilərsiniz ✓"
                                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                               Margin="0,3,0,8"/>
                                    <TextBlock Text="{Binding Credits.TransferXulase}" FontSize="13"
                                               FontWeight="Bold" Foreground="#34D399" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border DockPanel.Dock="Top" Background="#0F172A" CornerRadius="9" Padding="11"
                                    BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,10">
                                <StackPanel>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,10,7" Width="200">
                                            <TextBlock Text="👤 ŞƏXS SEÇ" FontSize="9.5" Foreground="#94A3B8"/>
                                            <ComboBox ItemsSource="{Binding Credits.TransferSexsleri}"
                                                      SelectedItem="{Binding Credits.SelectedTransferSexs}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,7" Width="150">
                                            <TextBlock Text="📅 TARİX" FontSize="9.5" Foreground="#94A3B8"/>
                                            <DatePicker Width="130"
                                                        SelectedDate="{Binding Credits.TransferTarixi}"
                                                        ToolTip="Transfer sənədinin tarixi ✓ — PDF-də qeyd olunur ✓"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,7" Width="120">
                                            <TextBlock Text="💰 PUL (₼)" FontSize="9.5" Foreground="#94A3B8"/>
                                            <TextBox Text="{Binding Credits.TransferBeh, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Şəxsin verdiyi PUL — avtomatik = KREDİTLƏŞDİRİLƏN məbləğ ✓ (əl ilə də düzəldə bilərsiniz ✓)"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,7" Width="140">
                                            <TextBlock Text="📤 TRANSFER ET" FontSize="9.5" Foreground="#94A3B8"/>
                                            <Button Content="📤 TRANSFER ET"
                                                    Command="{Binding Credits.TransferEtCommand}"
                                                    Style="{StaticResource iOSButton}" FontSize="11.5"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Border Height="1" Background="#1F2937" Margin="0,3,0,8"/>
                                    <TextBlock Text="➕ İNSAN ƏLAVƏ ET / 🗑️ SEÇİLMİŞİ SİL" FontSize="9.5"
                                               Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <WrapPanel>
                                        <TextBox Width="170" Margin="0,0,8,0"
                                                 Text="{Binding Credits.YeniTransferSexs, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Məsələn: Tural"/>
                                        <Button Content="➕ İNSAN ƏLAVƏ ET"
                                                Command="{Binding Credits.TransferSexsElaveEtCommand}"
                                                Style="{StaticResource iOSButton}" FontSize="11.5"/>
                                        <Button Content="🗑️ SEÇİLMİŞ ŞƏXSİ SİL"
                                                Command="{Binding Credits.TransferSexsSilCommand}"
                                                CommandParameter="{Binding Credits.SelectedTransferSexs}"
                                                Style="{StaticResource iOSButton}" FontSize="11.5" Margin="8,0,0,0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.PanningMode="Both" IsManipulationEnabled="True">
                                <ItemsControl ItemsSource="{Binding Credits.Transferler}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" CornerRadius="7" Padding="11,8"
                                                    Margin="0,0,0,6" BorderBrush="#1F2937" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Tesvir}"
                                                               FontSize="13" FontWeight="Bold" Foreground="#38BDF8"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Tarix, StringFormat=dd.MM.yyyy}"
                                                               FontSize="11.5" Foreground="#94A3B8"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Mebleg, Converter={StaticResource Currency}}"
                                                               FontSize="13" FontWeight="Bold" Foreground="#34D399"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Content="🗑️"
                                                            Command="{Binding DataContext.Credits.TransferSilCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource iOSButton}" FontSize="11.5"
                                                            Padding="4,2"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- ===== 📤 TRANSFER OLUNAN SƏHİFƏSİ ===== -->
                <TabItem Header="📤 Transfer">
                    <Border Background="#0B1220" Padding="14">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#111827" CornerRadius="10"
                                    Padding="14,11" BorderBrush="#334155" BorderThickness="1"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📤 TRANSFER OLUNAN MAŞINLAR"
                                               FontSize="15" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    <TextBlock Text="«Nə maşınlar verilib · bizə nə qədər verib» — şəxs üzrə tam yekun ✓"
                                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                               Margin="0,3,0,8"/>
                                    <TextBlock Text="{Binding Credits.TransferUmumiXulase}" FontSize="13"
                                               FontWeight="Bold" Foreground="#34D399" TextWrapping="Wrap"/>

                                    <!-- 🔎 AXTARIŞ + 📅 DÖVR ✓✓✓ -->
                                    <WrapPanel Margin="0,9,0,0">
                                        <TextBlock Text="🔎 Axtarış (maşın · nömrə · şəxs)"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox Width="230" Margin="0,0,10,0"
                                                 Text="{Binding Credits.TransferAxtaris, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Maşının adı, dövlət nömrəsi (məs. 99QE103) və ya şəxsin adı ✓"/>
                                        <TextBlock Text="📅 Dövr" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                        <ComboBox Width="130"
                                                  ItemsSource="{Binding Credits.TransferDovrleri}"
                                                  SelectedItem="{Binding Credits.TransferDovr}"
                                                  ToolTip="«Bu ay» seçsəniz — yalnız BU AY transfer olunan maşınlar ✓"/>
                                    </WrapPanel>

                                    <!-- ============ 📊 TRANSFER STATİSTİKASI ============ -->
                                    <WrapPanel Margin="0,10,0,0">
                                        <Border Background="#0B1220" CornerRadius="8" Padding="11,8" Margin="0,0,8,0"
                                                BorderBrush="#38BDF8" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="👥 ŞƏXS SAYI" FontSize="9.5" Foreground="#94A3B8"/>
                                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="#38BDF8"
                                                           Text="{Binding Credits.TransferOzetleri.Count}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0B1220" CornerRadius="8" Padding="11,8" Margin="0,0,8,0"
                                                BorderBrush="#34D399" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="💰 ÜMUMİ VERİLƏN PUL" FontSize="9.5" Foreground="#94A3B8"/>
                                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="#34D399"
                                                           Text="{Binding Credits.TransferUmumiBeh, Converter={StaticResource Currency}}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0B1220" CornerRadius="8" Padding="11,8"
                                                BorderBrush="#FBBF24" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="🚗 TRANSFER OLUNAN MAŞIN" FontSize="9.5" Foreground="#94A3B8"/>
                                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="#FBBF24"
                                                           Text="{Binding Credits.Transferler.Count}"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    <Border Height="1" Background="#1F2937" Margin="0,10,0,10"/>

                                    <!-- ============ 📤 TRANSFER ET ============ -->
                                    <TextBlock Text="📤 TRANSFER ET" FontSize="10.5" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    <WrapPanel Margin="0,4,0,0">
                                        <StackPanel Margin="0,0,8,6" Width="190">
                                            <TextBlock Text="👤 ŞƏXS SEÇ" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding Credits.TransferSexsleri}"
                                                      SelectedItem="{Binding Credits.SelectedTransferSexs}"
                                                      ToolTip="Müqaviləni hansı şəxsə transfer edirik ✓"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,6" Width="140">
                                            <TextBlock Text="📅 TARİX" Style="{StaticResource FieldLabel}"/>
                                            <DatePicker SelectedDate="{Binding Credits.TransferTarixi}"
                                                        ToolTip="Transfer sənədinin tarixi ✓ — PDF-də qeyd olunur ✓"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,6" Width="130">
                                            <TextBlock Text="💰 PUL (₼)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Credits.TransferBeh, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Avtomatik = KREDİTLƏŞDİRİLƏN məbləğ ✓ (əl ilə də düzəldə bilərsiniz ✓)"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,18,8,6" Width="150">
                                            <Button Content="📤 TRANSFER ET"
                                                    Command="{Binding Credits.TransferEtCommand}"
                                                    Style="{StaticResource iOSButton}" FontSize="11.5"
                                                    Background="#0EA5E9" Foreground="White"/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- ============ ➕ İNSAN ƏLAVƏ ET / 🗑️ SİL ============ -->
                                    <WrapPanel Margin="0,6,0,0">
                                        <StackPanel Margin="0,0,8,0" Width="190">
                                            <TextBlock Text="➕ İNSAN ƏLAVƏ ET / 🗑️ SİL" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Credits.YeniTransferSexs, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Məsələn: Tural ✓"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,18,8,0" Width="160">
                                            <Button Content="➕ İNSAN ƏLAVƏ ET"
                                                    Command="{Binding Credits.TransferSexsElaveEtCommand}"
                                                    Style="{StaticResource iOSButton}" FontSize="11.5"
                                                    Background="#16A34A" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,18,0,0" Width="195">
                                            <Button Content="🗑️ SEÇİLMİŞ ŞƏXSİ SİL"
                                                    Command="{Binding Credits.TransferSexsSilCommand}"
                                                    CommandParameter="{Binding Credits.SelectedTransferSexs}"
                                                    Style="{StaticResource iOSButton}" FontSize="11.5"
                                                    Background="#B91C1C" Foreground="White"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.PanningMode="Both"
                                          IsManipulationEnabled="True">
                                <ItemsControl ItemsSource="{Binding Credits.TransferOzetleri}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" CornerRadius="9" Padding="13,10"
                                                    Margin="0,0,0,8" BorderBrush="#1F2937" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12"
                                                               Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="19"/>
                                                    <Button Grid.Column="1" Content="📄 PDF" VerticalAlignment="Top"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.Credits.TransferOzetPdfCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource iOSButton}"
                                                            Background="#B91C1C" Foreground="White"
                                                            FontSize="11" Padding="4,2"
                                                            ToolTip="Transfer olunan maşının TAM kredit sənədi — cədvəl, maliyyə, bölgü ✓ (çap / PDF)"/>
                                                    <Button Grid.Column="2" Content="🗑️" VerticalAlignment="Top"
                                                            Command="{Binding DataContext.Credits.TransferOzetSilCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource iOSButton}" FontSize="11.5" Padding="4,2"
                                                            ToolTip="Şəxsin bütün transferlərini sil — kredit və avtomobil GERİ qaytarılır ✓"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </TabItem>
                <TabItem Header="👥 Tərəfdaşlar">
                    <!-- 🌊 SƏHİFƏ SCROLL-U ✓ — filtr + tərəfdaş idarəsi + kartlar + bölgü jurnalı BİRLİKDƏ sürüşür ✓
                         (cədvəllər `MaxHeight` ilə pəncərə hündürlüyünə məhdudlaşdırılır ✓ → virtualizasiya İŞLƏYİR ✓✓✓)
                         ⚠ `FallbackValue=700` vacibdir ✓ — izah: «💳 Ümumi Xərclər» tabı ✓ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Padding="0,0,6,0">

                    <Grid Margin="0,16,0,0" DataContext="{Binding Partners}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ============ ROW 0: DÖVR FİLTRİ + GÖSTƏRİCİLƏR ============ -->
                        <Border Grid.Row="0" Background="#111827" CornerRadius="12" Padding="12"
                                BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel>

                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Dövr" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Width="150" ItemsSource="{Binding RangeOptions}"
                                                  SelectedItem="{Binding SelectedRange}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Başlanğıc" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker Width="120" SelectedDate="{Binding CustomFrom}"
                                                    IsEnabled="{Binding IsCustomRange}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Son" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker Width="120" SelectedDate="{Binding CustomTo}"
                                                    IsEnabled="{Binding IsCustomRange}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Tərəfdaş" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Width="130" ItemsSource="{Binding TerefdasAdlari}"
                                                  SelectedItem="{Binding SelectedTerefdas}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Mənbə" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Width="150" ItemsSource="{Binding MenbeSecimleri}"
                                                  SelectedItem="{Binding SelectedMenbe}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Axtarış (maşın / müqavilə)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Width="170" Text="{Binding Axtaris, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="14,18,4,0" Orientation="Horizontal">
                                        <Button Content="↻ Yenilə" Style="{StaticResource iOSButton}" Background="#2563EB"
                                                Foreground="White" Margin="0,0,6,0"
                                                Command="{Binding LoadCommand}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                                        <Button Content="✕ Filtr sıfırla" Style="{StaticResource iOSButton}" Background="#374151"
                                                Foreground="#F9FAFB" Margin="0,0,6,0"
                                                Command="{Binding ResetFiltersCommand}"/>
                                        <Button Content="📊 Excel" Style="{StaticResource iOSButton}" Background="#047857"
                                                Foreground="White" Margin="0,0,6,0"
                                                ToolTip="Kartlar + bölgü jurnalı + ödənişlər bir faylda"
                                                Command="{Binding ExportExcelCommand}"/>
                                        <Button Content="📄 PDF" Style="{StaticResource iOSButton}" Background="#B91C1C"
                                                Foreground="White" Margin="0,0,6,0"
                                                ToolTip="Çap / PDF hesabatı"
                                                Command="{Binding ExportPdfCommand}"/>
                                        <Button Content="🌐 HTML" Style="{StaticResource iOSButton}" Background="#1D4ED8"
                                                Foreground="White"
                                                ToolTip="HTML hesabatı (brauzerdə açılır)"
                                                Command="{Binding ExportHtmlCommand}"/>
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Margin="6,10,0,0" FontSize="11" Foreground="#64748B"
                                           Text="{Binding DonemMetni, StringFormat='Seçilmiş dövr: {0}'}"/>

                                <!-- ===== YEKUN GÖSTƏRİCİLƏR ===== -->
                                <UniformGrid Columns="5" Margin="4,10,4,0">
                                    <Border Background="#0B1220" CornerRadius="9" Padding="12,9" Margin="0,0,8,0"
                                            BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="👥 TƏRƏFDAŞ SAYI" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding TotalTerefdasSayi}" FontSize="22" FontWeight="Bold"
                                                       Foreground="#E2E8F0"/>
                                            <TextBlock Text="dövrdə payı olan" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0B1220" CornerRadius="9" Padding="12,9" Margin="4,0,4,0"
                                            BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📒 BÖLGÜ SAYI" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding TotalBolguSayi}" FontSize="22" FontWeight="Bold"
                                                       Foreground="#38BDF8"/>
                                            <TextBlock Text="bütün mənbələrdən" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0B1220" CornerRadius="9" Padding="12,9" Margin="4,0,4,0"
                                            BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="✅ QAZANILMIŞ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding TotalQazanilmis, Converter={StaticResource Currency}}"
                                                       FontSize="19" FontWeight="Bold" Foreground="#34D399"/>
                                            <TextBlock Text="cəmi bölünən mənfəət" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0B1220" CornerRadius="9" Padding="12,9" Margin="4,0,4,0"
                                            BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="💸 XARİC EDİLƏN" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding TotalVerilmis, Converter={StaticResource Currency}}"
                                                       FontSize="19" FontWeight="Bold" Foreground="#FBBF24"/>
                                            <TextBlock Text="tərəfdaşlara verilən" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0B1220" CornerRadius="9" Padding="12,9" Margin="4,0,0,0"
                                            BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="⚖️ QALIQ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding QaliqMetni}" FontSize="19" FontWeight="Bold"
                                                       Foreground="{Binding QaliqReng}"/>
                                            <TextBlock Text="ödənilməli məbləğ" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                            </StackPanel>
                        </Border>

                        <!-- ============ ROW 1: TƏRƏFDAŞ İDARƏSİ + PUL VERİLMƏSİ ============ -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ===== TƏRƏFDAŞLAR: ƏLAVƏ ET / SİL / FAİZ TƏYİN ET ===== -->
                            <Border Grid.Column="0" Background="#0B1220" CornerRadius="10" Margin="0,0,10,0"
                                    BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="12,9">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="#94A3B8"
                                                       Text="Şəxs əlavə et · sil · standart faiz təyin et"/>
                                            <TextBlock Text="👤 TƏRƏFDAŞ İDARƏSİ" FontWeight="Bold"
                                                       FontSize="12.5" Foreground="#E2E8F0"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Yeni şəxs formu -->
                                    <WrapPanel Margin="11,10,11,6" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Ad" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="130" Text="{Binding NewPartnerAd, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Tərəfdaşın adı (məs. Kamran)"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Faiz %" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="66" Text="{Binding NewPartnerFaiz, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Standart faiz dərəcəsi. Qalıq payçısı üçün əhəmiyyətsizdir"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,18,6,0">
                                            <CheckBox Content="Qalıq payçısı" Foreground="#FBBF24" FontSize="11.5"
                                                      IsChecked="{Binding NewPartnerQalig}"
                                                      ToolTip="İşarələnsə faiz almır — faizlər çıxıldıqdan sonra QALANI digər qalıq payçıları ilə bərabər bölür"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Qeyd" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="110" Text="{Binding NewPartnerQeyd, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <Button Content="➕ Əlavə et" Style="{StaticResource iOSButton}" Background="#10B981"
                                                Foreground="White" Margin="0,18,0,0" FontSize="11"
                                                Command="{Binding AddPartnerCommand}"/>
                                    </WrapPanel>
                                    <!-- Tərəfdaş cədvəli -->
                                    <Border Margin="11,0,11,0" CornerRadius="7"
                                            Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                                        <DataGrid ItemsSource="{Binding Partners}" SelectedItem="{Binding SelectedPartner}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" RowHeight="30" ColumnHeaderHeight="30"
                                                  Background="Transparent" BorderThickness="0"
                                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                                                  Foreground="#E2E8F0" FontSize="11.5" RowBackground="#111827"
                                                  AlternatingRowBackground="#0D1526"
                                                  MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="AKTİV" Width="58"
                                                                        Binding="{Binding Aktiv, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridTextColumn Header="AD" Width="*"
                                                                    Binding="{Binding Ad, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridTextColumn Header="FAİZ %" Width="66"
                                                                    Binding="{Binding Faiz, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="QALIQ" Width="60"
                                                                        Binding="{Binding QaligPayi, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridTextColumn Header="QEYD" Width="1.2*"
                                                                    Binding="{Binding Qeyd, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>

                                    <StackPanel Margin="11,9,11,10" Orientation="Horizontal">
                                        <Button Content="💾 Faizləri yadda saxla" Style="{StaticResource iOSButton}" Background="#2563EB"
                                                Foreground="White" Margin="0,0,6,0" FontSize="11"
                                                ToolTip="Cədvəldə dəyişdirdiyiniz faizləri bütün bölgü panellərinə tətbiq edir"
                                                Command="{Binding SavePartnersCommand}"/>
                                        <Button Content="↺ Ləğv et" Style="{StaticResource iOSButton}" Background="#374151"
                                                Foreground="#F9FAFB" Margin="0,0,6,0" FontSize="11"
                                                Command="{Binding RevertPartnersCommand}"/>
                                        <Button Content="🗑️ Şəxsi sil" Style="{StaticResource iOSButton}" Background="#EF4444"
                                                Foreground="White" FontSize="11"
                                                Command="{Binding DeletePartnerCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- ===== 💸 TƏRƏFDAŞA PUL VERİLMƏSİ ===== -->
                            <Border Grid.Column="1" Background="#0B1220" CornerRadius="10"
                                    BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="12,9">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="#94A3B8"
                                                       Text="xaric edilən pullar"/>
                                            <TextBlock Text="💸 TƏRƏFDAŞA PUL VER" FontWeight="Bold"
                                                       FontSize="12.5" Foreground="#E2E8F0"/>
                                        </DockPanel>
                                    </Border>

                                    <WrapPanel Margin="11,10,11,6" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Tərəfdaş" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Width="130" IsEditable="True"
                                                      ItemsSource="{Binding TerefdasAdlari}"
                                                      Text="{Binding PaymentTerefdas, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Kimə pul verilir"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Məbləğ (₼)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="100" FontWeight="SemiBold" Foreground="#FBBF24"
                                                     Text="{Binding PaymentMebleg, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Tarix" Style="{StaticResource FieldLabel}"/>
                                            <DatePicker Width="120" SelectedDate="{Binding PaymentTarix}"/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <WrapPanel Margin="11,0,11,8" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Ödəniş üsulu" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Width="130" ItemsSource="{Binding OdenisUsullari}"
                                                      SelectedItem="{Binding PaymentUsulu}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Qeyd" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="160" Text="{Binding PaymentQeyd, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Məs. «sentyabr payı», «avans»"/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <StackPanel Margin="11,0,11,10" Orientation="Horizontal">
                                        <Button Content="💸 Ödənişi qeyd et" Style="{StaticResource iOSButton}" Background="#F59E0B"
                                                Foreground="#111827" Margin="0,0,6,0" FontSize="11"
                                                Command="{Binding AddPaymentCommand}"/>
                                        <Button Content="↺ Təmizlə" Style="{StaticResource iOSButton}" Background="#374151"
                                                Foreground="#F9FAFB" Margin="0,0,6,0" FontSize="11"
                                                Command="{Binding ClearPaymentFormCommand}"/>
                                        <Button Content="🗑️ Sil" Style="{StaticResource iOSButton}" Background="#EF4444"
                                                Foreground="White" FontSize="11"
                                                Command="{Binding DeletePaymentCommand}"/>
                                    </StackPanel>
                                    <!-- Ödəniş tarixçəsi -->
                                    <Border Margin="11,0,11,11" CornerRadius="7"
                                            Background="#111827" BorderBrush="#1F2937" BorderThickness="1">
                                        <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" RowHeight="28" ColumnHeaderHeight="28"
                                                  Background="Transparent" BorderThickness="0"
                                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                                                  Foreground="#E2E8F0" FontSize="11" RowBackground="#111827"
                                                  AlternatingRowBackground="#0D1526"
                                                  MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="TARİX" Width="82" IsReadOnly="True"
                                                                    Binding="{Binding TarixMetni}"/>
                                                <DataGridTextColumn Header="TƏRƏFDAŞ" Width="*" IsReadOnly="True"
                                                                    Binding="{Binding Terefdas}"/>
                                                <DataGridTextColumn Header="MƏBLƏĞ (₼)" Width="100" IsReadOnly="True"
                                                                    Binding="{Binding Mebleg, StringFormat=N2}"/>
                                                <DataGridTextColumn Header="ÜSUL" Width="110" IsReadOnly="True"
                                                                    Binding="{Binding OdenisUsulu}"/>
                                                <DataGridTextColumn Header="QEYD" Width="*" IsReadOnly="True"
                                                                    Binding="{Binding Qeyd}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ============ ROW 2: TƏRƏFDAŞ KARTLARI + AYLIK DÖVRİYYƏ ============ -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ===== 👥 TƏRƏFDAŞ KARTLARI (umumi dövriyyə) ===== -->
                            <Border Grid.Column="0" Background="#0B1220" CornerRadius="10" Margin="0,0,10,0"
                                    BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="12,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       FontSize="10.5" Foreground="#FBBF24"
                                                       Text="ÜMUMİ — bütün vaxtın tarixçəsi"/>
                                            <TextBlock Text="👥 TƏRƏFDAŞ KARTLARI" FontWeight="Bold"
                                                       FontSize="12.5" Foreground="#E2E8F0"/>
                                        </DockPanel>
                                    </Border>

                                    <DataGrid ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              HeadersVisibility="Column" RowHeight="52" ColumnHeaderHeight="44"
                                              ColumnHeaderStyle="{StaticResource ProfessionalHeader}"
                                              Background="Transparent" BorderThickness="0" Margin="6"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                                              Foreground="#E2E8F0" FontSize="11.5" RowBackground="#111827"
                                              AlternatingRowBackground="#0D1526"
                                              MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}"
                                              HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.PanningMode="Both"
                                              IsManipulationEnabled="True">
                                        <DataGrid.Columns>
                                            <!-- 🥇 Sıra / medal -->
                                            <DataGridTemplateColumn Header="#" Width="42"
                                                                    HeaderStyle="{StaticResource ProfessionalHeaderCenter}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding SiraNisani}" FontSize="15"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 👤 Ad + irəliləyiş zolağı (ən vacib sütun) -->
                                            <DataGridTemplateColumn Header="👤 TƏRƏFDAŞ  ·  ÖDƏNİŞ VƏZİYYƏTİ" Width="2*" MinWidth="185">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,3">
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1"
                                                                        Background="#1E293B" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FaizMetni}" FontSize="10"
                                                                               FontWeight="Bold" Foreground="#FBBF24"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Terefdas}" FontWeight="Bold"
                                                                           FontSize="13.5" Foreground="#F1F5F9"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                            <ProgressBar Margin="0,5,4,0" Height="6"
                                                                         Style="{StaticResource CreditProgressBar}"
                                                                         Value="{Binding OdenisFaizi, Mode=OneWay}"/>
                                                            <TextBlock Text="{Binding OdenisFaiziMetni}" FontSize="9.5"
                                                                       Foreground="#64748B" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <!-- 💰 Qazanılmış -->
                                            <DataGridTemplateColumn Header="💰 QAZANILMIŞ" Width="1.05*" MinWidth="105">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Qazanilmis, StringFormat=N2}"
                                                                       FontSize="13" FontWeight="Bold" Foreground="#34D399"
                                                                       HorizontalAlignment="Right"/>
                                                            <TextBlock Text="bütün vaxt" FontSize="9" Foreground="#475569"
                                                                       HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 💸 Verilmiş -->
                                            <DataGridTemplateColumn Header="💸 VERİLMİŞ" Width="1.05*" MinWidth="105">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Verilmis, StringFormat=N2}"
                                                                       FontSize="13" FontWeight="Bold" Foreground="#FBBF24"
                                                                       HorizontalAlignment="Right"/>
                                                            <TextBlock Text="xaric edilib" FontSize="9" Foreground="#475569"
                                                                       HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 🏦 Ümumi balans (nişan ilə) -->
                                            <DataGridTemplateColumn Header="🏦 ÜMUMİ BALANS" Width="1.15*" MinWidth="125">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                    ToolTip="Ümumi qazanılmış − ümumi verilmiş (bütün vaxt)">
                                                            <TextBlock Text="{Binding Qaliq, StringFormat=N2}"
                                                                       FontSize="15" FontWeight="Bold"
                                                                       Foreground="{Binding UmumiBalansReng}"
                                                                       HorizontalAlignment="Right"/>
                                                            <Border CornerRadius="3" Padding="5,0" HorizontalAlignment="Right"
                                                                    Margin="0,2,0,0" Background="#111827">
                                                                <TextBlock Text="{Binding BalansNisani}" FontSize="9"
                                                                           Foreground="{Binding UmumiBalansReng}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="📅 ÜMUMİ DÖVRİYYƏ" Width="2.2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DonemMetni}" FontSize="10.5"
                                                                       Foreground="#38BDF8" TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                <TextBlock Text="dövrdə:" FontSize="9.5" Foreground="#64748B"/>
                                                                <TextBlock Text="{Binding DonemQazanilmisYoxsa}" FontSize="9.5"
                                                                           Foreground="#34D399" Margin="3,0,0,0"/>
                                                                <TextBlock Text=" / " FontSize="9.5" Foreground="#475569"/>
                                                                <TextBlock Text="{Binding DonemVerilmisYoxsa}" FontSize="9.5"
                                                                           Foreground="#FBBF24"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <!-- ===== 📅 AYLIK DÖVRİYYƏ ===== -->
                            <Border Grid.Column="1" Background="#0B1220" CornerRadius="10"
                                    BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="12,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="#94A3B8"
                                                       Text="hansı ayda kimə nə qədər"/>
                                            <TextBlock Text="📅 AYLIK DÖVRİYYƏ" FontWeight="Bold"
                                                       FontSize="12.5" Foreground="#E2E8F0"/>
                                        </DockPanel>
                                    </Border>

                                    <DataGrid ItemsSource="{Binding Monthly}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              HeadersVisibility="Column" RowHeight="28" ColumnHeaderHeight="28"
                                              Background="Transparent" BorderThickness="0" Margin="6"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                                              Foreground="#E2E8F0" FontSize="11" RowBackground="#111827"
                                              AlternatingRowBackground="#0D1526"
                                              MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DÖVR" Width="96" Binding="{Binding AyMetni}"/>
                                            <DataGridTextColumn Header="TƏRƏFDAŞ" Width="*" Binding="{Binding Terefdas}"/>
                                            <DataGridTextColumn Header="BÖLGÜ" Width="55" Binding="{Binding BolguSayi}"/>
                                            <DataGridTextColumn Header="QAZANILMIŞ" Width="105"
                                                                Binding="{Binding Qazanilmis, StringFormat=N2}"/>
                                            <DataGridTextColumn Header="VERİLMİŞ" Width="100"
                                                                Binding="{Binding Odenilmis, StringFormat=N2}"/>
                                            <DataGridTextColumn Header="QALIQ" Width="95"
                                                                Binding="{Binding Qaliq, StringFormat=N2}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ============ ROW 3: BÖLGÜ JURNALI (bütün mənbələr) ============ -->
                        <Border Grid.Row="3" Background="#0B1220" CornerRadius="10"
                                BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <Border Background="#1E293B" CornerRadius="9,9,0,0" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   FontSize="11" Foreground="#94A3B8"
                                                   Text="hansı maşından · hansı ayda · kimə nə qədər"/>
                                        <TextBlock Text="📒 BÖLGÜ JURNALI  —  bütün bölmələrdən avtomatik toplanır"
                                                   FontWeight="Bold" FontSize="12.5" Foreground="#E2E8F0"/>
                                    </DockPanel>
                                </Border>

                                <DataGrid ItemsSource="{Binding Ledger}" SelectedItem="{Binding SelectedLedgerRow}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" RowHeight="29" ColumnHeaderHeight="30"
                                          Background="Transparent" BorderThickness="0" Margin="6"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                                          Foreground="#E2E8F0" FontSize="11.5" RowBackground="#111827"
                                          AlternatingRowBackground="#0D1526"
                                          MinHeight="260"
                                          MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, FallbackValue=700, TargetNullValue=700}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TARİX" Width="88" Binding="{Binding TarixMetni}"/>
                                        <DataGridTextColumn Header="DÖVR" Width="105" Binding="{Binding AyMetni}"/>
                                        <DataGridTextColumn Header="MƏNBƏ" Width="135" Binding="{Binding MenbeNisani}"/>
                                        <DataGridTextColumn Header="AVTOMOBİL" Width="1.5*" Binding="{Binding Avtomobil}"/>
                                        <DataGridTextColumn Header="MÜQAVİLƏ / MÜŞTƏRİ" Width="1.2*" Binding="{Binding SenedMetni}"/>
                                        <DataGridTextColumn Header="TƏRƏFDAŞ" Width="1*" Binding="{Binding Terefdas}"/>
                                        <DataGridTextColumn Header="FAİZ" Width="62" Binding="{Binding FaizMetni}"/>
                                        <DataGridTextColumn Header="XEYİR (BAZA)" Width="115"
                                                            Binding="{Binding Baza, StringFormat=N2}"/>
                                        <DataGridTextColumn Header="PAY (₼)" Width="110"
                                                            Binding="{Binding Mebleg, StringFormat=N2}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Margin="6,0,6,6" Background="#111827" CornerRadius="6" Padding="12,7">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="#34D399"
                                                   Text="{Binding Ledger.Count, StringFormat='Jurnaldaki sətir: {0}'}"/>
                                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding StatusMessage}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>

                </TabItem>

                <!-- ============================================================
                     🌐 VEB SAYT — YALNIZ ADMIN GÖRÜR ✓✓✓
                     (Sahil və Asif HEÇ VAXT görmür ✗ — rol qaydası ✓)
                     ============================================================ -->
                <TabItem Header="🌐 Veb Sayt"
                         Visibility="{Binding VebSaytGoruner, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0F172A" CornerRadius="10"
                                BorderBrush="#1F2937" BorderThickness="1" Padding="14,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="▶ Başlat" Command="{Binding Web.StartCommand}"
                                            Style="{StaticResource iOSButton}" Height="32" Padding="14,0"
                                            Background="#10B981" Foreground="White" Margin="0,0,6,0"/>
                                    <Button Content="⏹ Dayandır" Command="{Binding Web.StopCommand}"
                                            Style="{StaticResource iOSButton}" Height="32" Padding="14,0"
                                            Background="#EF4444" Foreground="White" Margin="0,0,6,0"/>
                                    <Button Content="🔄 Yenidən başlat" Command="{Binding Web.RestartCommand}"
                                            Style="{StaticResource iOSButton}" Height="32" Padding="14,0"
                                            Background="#1F2937" Foreground="#F8FAFC" Margin="0,0,6,0"/>
                                    <Button Content="↻ Yenilə" Command="{Binding Web.ReloadCommand}"
                                            Style="{StaticResource iOSButton}" Height="32" Padding="14,0"
                                            Background="#2563EB" Foreground="White"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="●" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Web.IsRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Web.StatusText}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="{Binding Web.HintText}" FontSize="11.5" Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding Web.ErrorText}" FontSize="11.5" Foreground="#F87171"
                                                   TextWrapping="Wrap" MaxWidth="600"
                                                   Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" BorderBrush="#1F2937"
                                BorderThickness="1" Padding="14,10" Margin="0,10,0,0">
                            <DockPanel>
                                <!-- ========== TELEFON ÜÇÜN QR KOD ==========
                                     Kameranı koda tutmaq kifayətdir — router-də DNS
                                     ayarı olmasa da telefon birbaşa qoşulur. -->
                                <Border DockPanel.Dock="Right" Background="#FFFFFF" CornerRadius="8"
                                        Padding="8,8,8,6" Margin="16,0,0,0" VerticalAlignment="Top"
                                        Visibility="{Binding Web.HasQr, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Image Source="{Binding Web.QrImage}" Width="152" Height="152"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <TextBlock Text="{Binding Web.QrTargetUrl}" FontSize="10.5"
                                                   FontWeight="SemiBold" Foreground="#111827"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel>
                                    <TextBlock Text="GİRİŞ ÜNVANLARI  (klik = brauzerdə aç)"
                                               FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="{Binding Web.DomainUrl}" Command="{Binding Web.OpenDomainCommand}"
                                                Style="{StaticResource iOSButton}" Height="34" Padding="16,0"
                                                Background="#7C3AED" Foreground="White" Margin="0,0,8,8"/>
                                        <Button Content="{Binding Web.LocalUrl}" Command="{Binding Web.OpenLocalCommand}"
                                                Style="{StaticResource iOSButton}" Height="34" Padding="16,0"
                                                Background="#0891B2" Foreground="White" Margin="0,0,8,8"/>
                                        <Button Content="{Binding Web.LanUrl}" Command="{Binding Web.OpenLanCommand}"
                                                Style="{StaticResource iOSButton}" Height="34" Padding="16,0"
                                                Background="#D97706" Foreground="White" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <TextBlock FontSize="12" Foreground="#22C55E" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="540"
                                               Text="📱 TELEFON ÜÇÜN: telefonu EYNİ WiFi-yə qoşun, sonra kameranı ➜ sağdaki QR koda tutun. Sayt dərhal açılır — DNS ayarı LAZIM DEYİL!"/>
                                    <TextBlock FontSize="11.5" Foreground="#9CA3AF" TextWrapping="Wrap" MaxWidth="540" Margin="0,6,0,0"
                                               Text="Əl ilə də yazmaq olar: yuxarıdaki narıncı ünvanı telefonda açın (məs. http://192.168.1.51). Giriş şifrəsi: appsettings.json ➜ AdminPassword"/>
                                    <TextBlock FontSize="11.5" Foreground="#F87171" TextWrapping="Wrap" MaxWidth="540" Margin="0,6,0,0"
                                               Text="⚠ Telefonlar sayta yalnız bu proqram AÇIQ olarkən qoşula bilər!"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Background="#0B0F17" CornerRadius="10" BorderBrush="#1F2937"
                                BorderThickness="1" Margin="0,10,0,0" ClipToBounds="True">
                            <Grid>
                                <wv2:WebView2 x:Name="WebBrowser" Margin="1"/>
                                <TextBlock x:Name="WebBrowserHint" Text="Brauzer hazırlanır…"
                                           Foreground="#6B7280" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ============================================================
                     ⚙️ TƏNZİMLƏMƏLƏR — Asif və Admin görür ✓ (Sahil ✗)
                     Bu, Asifin Sahildən YEGANƏ FƏRQİDİR ✓✓✓
                     ============================================================ -->
                <TabItem Header="⚙️ Tənzimləmələr"
                         Visibility="{Binding TenzimlemelerGoruner, Converter={StaticResource BoolToVis}}">
                    <Border Background="#0B1220" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ============ 👥 İSTİFADƏÇİ İDARƏETMƏSİ ============ -->
                                <Border Grid.Column="0" Background="#111827" CornerRadius="12"
                                        BorderBrush="#8B5CF6" BorderThickness="1" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="👥 İSTİFADƏÇİ İDARƏETMƏSİ" FontSize="12.5" FontWeight="Bold"
                                                   Foreground="#A78BFA" Margin="0,0,0,4"/>
                                        <TextBlock Text="Adı · KODU · rolu görünür ✓ · dəyişilir ✓ · silinir ✓ · yenisi yaradılır ✓"
                                                   FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding IstifadeciSiyahisi}"
                                                  SelectedItem="{Binding SecilmisIstifadeci}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="False" RowHeight="30" ColumnHeaderHeight="34" Height="128"
                                                  ToolTip="✏️ Hüceyrəni dəyişin → «💾 Yadda saxla» basın ✓">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Adı" Binding="{Binding Ad, UpdateSourceTrigger=PropertyChanged}" Width="85"
                                                                    ElementStyle="{StaticResource GridCellText}"
                                                                    EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                                <DataGridTextColumn Header="Giriş adı (login)" Binding="{Binding IstifadeciAdi, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                                    ElementStyle="{StaticResource GridCellText}"
                                                                    EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                                <DataGridTextColumn Header="🔑 KOD (şifrə)" Binding="{Binding Sifre, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                                                    ElementStyle="{StaticResource GridCellText}"
                                                                    EditingElementStyle="{StaticResource GridCellTextBox}"/>
                                                <DataGridTemplateColumn Header="Rol (dəyişilir ✓)" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.Rollar, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                      SelectedItem="{Binding Rol, UpdateSourceTrigger=PropertyChanged}"
                                                                      Height="24" FontSize="11" Margin="1"
                                                                      ToolTip="👑 Admin = tam giriş ✓ · 🛡️ Asif = veb ✗ / tənzimləmə ✓ · 🚗 Sahil = yalnız park ✓"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- ➕ YENİ İSTİFADƏÇİ YARAT — hər sahə ADLI ✓✓✓ -->
                                        <TextBlock Text="➕ YENİ İSTİFADƏÇİ YARAT" FontSize="10" FontWeight="Bold"
                                                   Foreground="#34D399" Margin="0,10,0,4"/>
                                        <TextBlock Text="Adı (görünən ad)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding YeniAd, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="28" Margin="0,0,0,4" ToolTip="Ad (məs. Tural) ✓"/>
                                        <TextBlock Text="Giriş adı (login — girişdə yazılır)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding YeniIstifadeciAdi, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="28" Margin="0,0,0,4" ToolTip="İstifadəçi adı (login) ✓ — təkrarlanmamalıdır ✗"/>
                                        <TextBlock Text="🔑 KOD (şifrə — girişdə yazılır)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding YeniSifre, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="28" Margin="0,0,0,4" ToolTip="🔑 Kod (şifrə) ✓"/>
                                        <TextBlock Text="Rol (icazələr)" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding Rollar}" SelectedItem="{Binding YeniRol}"
                                                  Height="28" Margin="0,0,0,7"
                                                  ToolTip="👑 Admin = tam giriş ✓ · 🛡️ Asif = veb ✗ / tənzimləmə ✓ · 🚗 Sahil = yalnız park ✓"/>

                                        <UniformGrid Columns="2">
                                            <Button Content="➕  Yarat" Style="{StaticResource iOSButton}" Height="30"
                                                    Margin="0,0,4,0" Background="#065F46" Foreground="#D1FAE5" Cursor="Hand"
                                                    Command="{Binding IstifadeciElaveEtCommand}"/>
                                            <Button Content="💾  Yadda saxla" Style="{StaticResource iOSButton}"
                                                    Height="30" Margin="4,0,0,0" Background="#1E3A8A" Foreground="#DBEAFE"
                                                    Cursor="Hand" ToolTip="Seçilmiş istifadəçinin adı · KODU · rolu saxlanılır ✓"
                                                    Command="{Binding IstifadeciYaddaSaxlaCommand}"/>
                                        </UniformGrid>
                                        <UniformGrid Columns="2" Margin="0,6,0,0">
                                            <Button Content="➖  Sil" Style="{StaticResource iOSButton}" Height="30"
                                                    Margin="0,0,4,0" Background="#7F1D1D" Foreground="#FECACA" Cursor="Hand"
                                                    ToolTip="🗑️ SİLMƏ İCAZƏSİ HƏR KƏSDƏ VAR ✓"
                                                    Command="{Binding IstifadeciSilCommand}"/>
                                            <Button Content="♻️  Standart 3" Style="{StaticResource iOSButton}"
                                                    Height="30" Margin="4,0,0,0" Background="#334155" Foreground="#E2E8F0"
                                                    Cursor="Hand" ToolTip="Sahil · Asif · Seccad bərpa olunur ✓"
                                                    Command="{Binding StandartIstifadecilerCommand}"/>
                                        </UniformGrid>

                                        <TextBlock Text="{Binding IstifadeciMesaji}" FontSize="10.5" Foreground="#38BDF8"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <TextBlock FontSize="9" Foreground="#475569" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="{Binding IstifadeciFayli, StringFormat=💾 Saxlanılır: {0}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- ============ 🛠️ ALƏTLƏR ============ -->
                                <Border Grid.Column="1" Background="#111827" CornerRadius="12"
                                        BorderBrush="#334155" BorderThickness="1" Padding="16,13" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🛠️ SİSTEM ALƏTLƏRİ" FontSize="12.5" FontWeight="Bold"
                                                   Foreground="#FBBF24" Margin="0,0,0,10"/>
                                        <Button Content="📂  Proqram qovluğunu aç" Style="{StaticResource iOSButton}"
                                                Height="34" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,7"
                                                Background="#1F2937" Foreground="#F8FAFC" Cursor="Hand"
                                                Command="{Binding QovlugAcCommand}"/>
                                        <Button Content="📄  Loq fayllarını aç" Style="{StaticResource iOSButton}"
                                                Height="34" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,7"
                                                Background="#1F2937" Foreground="#F8FAFC" Cursor="Hand"
                                                Command="{Binding LoglariAcCommand}"/>

                                        <!-- ============================================================
                                             ☁️ BULUD SİNXRON TƏNZİMLƏMƏLƏRİ ✓✓✓
                                             ⚙️ YALNIZ Seccad (BAŞ ADMIN) və Asif (BAŞ İNZİBATÇI) görür ✓
                                             🚗 Sahil → panel tamamilə gizlədilir ✗
                                             ============================================================ -->
                                        <Border Background="#0F172A" CornerRadius="10" BorderBrush="#0EA5E9"
                                                BorderThickness="1" Padding="12,10" Margin="0,10,0,0"
                                                Loaded="BuludAyarPaneli_Loaded">
                                            <StackPanel>
                                                <TextBlock Text="☁️ BULUD SİNXRON TƏNZİMLƏMƏLƏRİ" FontSize="12.5"
                                                           FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,3"/>
                                                 <CheckBox x:Name="BuludAvtomatikQutusu" FontSize="11" Foreground="#E2E8F0"
                                                           Content="☁️ Avtomatik bulud sinxronizasiyası" Margin="0,0,0,8"
                                                           Cursor="Hand"
                                                           ToolTip="✔ Açıq = məlumat buludla sinxronlaşır ✓ · ✗ Bağlı = buluddan HEÇ NƏ oxunmur / yazılmır ✗ (təmiz quraşdırmada standart olaraq BAĞLIDIR ✓ — tətbiq BOŞ açılır ✓)"/>

                                                <TextBlock x:Name="BuludAyarStatusuText" FontSize="10"
                                                           Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                                <TextBlock Text="⏱️ Firebase yazma fasiləsi (SANİYƏ):" FontSize="11"
                                                           Foreground="#E2E8F0" Margin="0,0,0,2"/>
                                                <TextBox x:Name="BuludFbSaniyeQutusu" Width="90" Height="26"
                                                         HorizontalAlignment="Left" Background="#1F2937"
                                                         Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,2"
                                                         ToolTip="Buluda neçə SANİYƏDƏN bir yazılsın? (2 – 3600 ✓)"/>

                                                <TextBlock Text="💾 USB yedək fasiləsi (SANİYƏ):" FontSize="11"
                                                           Foreground="#E2E8F0" Margin="0,8,0,2"/>
                                                <TextBox x:Name="BuludUsbSaniyeQutusu" Width="90" Height="26"
                                                         HorizontalAlignment="Left" Background="#1F2937"
                                                         Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,2"
                                                         ToolTip="USB-yə neçə SANİYƏDƏN bir yazılsın? (5 – 86400 ✓)"/>

                                                <TextBlock Text="🖥️ Kompüterə yedək fasiləsi (SANİYƏ):" FontSize="11"
                                                           Foreground="#E2E8F0" Margin="0,8,0,2"/>
                                                <TextBox x:Name="BuludYerliSaniyeQutusu" Width="90" Height="26"
                                                         HorizontalAlignment="Left" Background="#1F2937"
                                                         Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,2"
                                                         ToolTip="Kompüterə neçə SANİYƏDƏN bir yazılsın? (5 – 86400 ✓)"/>

                                                <Button Content="💾  YADDA SAXLA" Style="{StaticResource iOSButton}"
                                                        Height="32" HorizontalContentAlignment="Center" Padding="12,0"
                                                        Margin="0,10,0,0" Background="#0369A1" Foreground="#E0F2FE"
                                                        Cursor="Hand" Click="BuludAyarSaxla_Click"
                                                        ToolTip="Həm yerli fayla, həm Firebase-ə yazılır ✓ · dərhal qüvvəyə minir ✓"/>

                                                <TextBlock x:Name="BuludAyarNeticeText" FontSize="10.5"
                                                           Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="💾  Ehtiyat nüsxə al (baza)" Style="{StaticResource iOSButton}"
                                                Height="34" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,7"
                                                Background="#065F46" Foreground="#D1FAE5" Cursor="Hand"
                                                ToolTip="Baza faylını istədiyiniz yerə kopyalayır — «hara yadda saxlayım?» soruşur ✓"
                                                Command="{Binding EhtiyatNusxeCommand}"/>
                                        <Button Content="♻️  Ehtiyat nüsxədən BƏRPA ET" Style="{StaticResource iOSButton}"
                                                Height="34" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,7"
                                                Background="#7C2D12" Foreground="#FFEDD5" Cursor="Hand"
                                                ToolTip="Əvvəl saxladığınız .db ehtiyat nüsxəni seçin → bütün məlumatlar (maşınlar · kreditlər · satışlar · xərclər) PROQRAMA YÜKLƏNİR ✓ (cari baza avtomatik surətə götürülür ✓)"
                                                Command="{Binding EhtiyatdanBerpaEtCommand}"/>
                                        <Button Content="🔄  Bütün məlumatları yenilə" Style="{StaticResource iOSButton}"
                                                Height="34" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,7"
                                                Background="#1E3A8A" Foreground="#DBEAFE" Cursor="Hand"
                                                Command="{Binding MelumatlariYenileCommand}"/>
                                        <!-- ============ ⏱️ AVTOMATİK YENİLƏMƏ (5 s) ============ -->
                                        <TextBlock Text="⏱️ AVTOMATİK YENİLƏMƏ" FontSize="11" FontWeight="Bold"
                                                   Foreground="#34D399" Margin="0,14,0,6"/>
                                        <TextBlock Text="{Binding AvtoYenilemeMetni}" FontSize="10.5"
                                                   Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="⏱️  Aç / Bağla" Style="{StaticResource iOSButton}" Height="30"
                                                    Margin="0,0,4,0" Background="#065F46" Foreground="#D1FAE5" Cursor="Hand"
                                                    ToolTip="Avtomatik yeniləməni aç/bağla ✓ — hər 5 saniyədə BÜTÜN məlumatlar yenilənir ✓"
                                                    Command="{Binding AvtoYenilemeToggleCommand}"/>
                                            <Button Content="🔄  İndi yenilə" Style="{StaticResource iOSButton}" Height="30"
                                                    Margin="4,0,0,0" Background="#1E3A8A" Foreground="#DBEAFE" Cursor="Hand"
                                                    ToolTip="Dərhal bütün tabların məlumatını yeniləyir ✓"
                                                    Command="{Binding HamisiniIndiYenileCommand}"/>
                                        </UniformGrid>

                                        <Button Content="⏱️  Avtomatik yeniləməni aç / bağla" Style="{StaticResource iOSButton}"
                                                Height="30" Margin="0,6,0,0" Background="#334155" Foreground="#E2E8F0"
                                                Cursor="Hand" HorizontalContentAlignment="Left" Padding="12,0"
                                                ToolTip="⏱️ Aktivdirsə dayandırır ✗, sönüksə başladır ✓ (hər 5 saniyə ✓)"
                                                Command="{Binding AvtoYenilemeToggleCommand}"/>

                                        <Button Content="🚪  Çıxış et (Sign out)" Style="{StaticResource iOSButton}"
                                                Height="34" HorizontalContentAlignment="Left" Padding="12,0"
                                                Background="#7F1D1D" Foreground="#FECACA" Cursor="Hand"
                                                Command="{Binding CixisEtCommand}"/>

                                        <!-- ============ 💾 DATA USB ============ -->
                                        <TextBlock Text="💾 DATA USB (yalnız SİZİN fləşkartınız ✓)"
                                                   FontSize="11" FontWeight="Bold" Foreground="#38BDF8"
                                                   Margin="0,14,0,6"/>
                                        <TextBlock Text="{Binding UsbStatusu}" FontSize="10.5" Foreground="#FBBF24"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding UsbQeydiyyati}" FontSize="9.5" Foreground="#64748B"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <ComboBox ItemsSource="{Binding UsbSiyahisi}" SelectedItem="{Binding SecilmisUsb}"
                                                  Height="28" Margin="0,0,0,4"
                                                  ToolTip="«F:\|AD|14.9 GB boş|✓ marker var» — bütün hazır disklər ✓"/>

                                        <TextBlock Text="⚠️ USB-ni taxdıqdan SONRA «🔄 Yenilə» basın ✓ (siyahı açılışda doldurulur ✓)"
                                                   FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <UniformGrid Columns="2">
                                            <Button Content="🔄  Yenilə" Style="{StaticResource iOSButton}" Height="30"
                                                    Margin="0,0,4,0" Background="#334155" Foreground="#E2E8F0"
                                                    Cursor="Hand" ToolTip="Taxılı diskləri yenidən skan edir ✓"
                                                    Command="{Binding UsbYenileCommand}"/>
                                            <Button Content="🆕  YENİ USB yarat (qeydiyyat)" Style="{StaticResource iOSButton}" Height="30"
                                                    Margin="4,0,0,0" Background="#065F46" Foreground="#D1FAE5"
                                                    Cursor="Hand"
                                                    ToolTip="Seçilmiş USB-nin kökündə GİZLİ marker faylı yazır ✓ → kompüter bu fləşkartı TANIYIR ✓ (başqalarını yox ✗)"
                                                    Command="{Binding UsbElaveEtCommand}"/>

                    <!-- ============================================================ -->
                    <!-- 📥 MÖVCUD USB-Nİ TAX, OXU VƏ İNTEQRASİYA ET ✓✓✓            -->
                    <!-- 🔑 marker-dən tanıyır ✓ → 📥 bazanı oxuyub əlavə edir ✓    -->
                    <!-- → 💾 bazanı USB-nin ÖZÜNƏ yazır ✓✓✓                        -->
                    <!-- ============================================================ -->
                    <Button Content="📥  Mövcud USB-ni tax · oxu · inteqrasiya et"
                            Style="{StaticResource iOSButton}" Width="370" Height="30"
                            Margin="0,7,0,0" HorizontalAlignment="Left" Cursor="Hand"
                            Background="#0369A1" Foreground="White"
                            ToolTip="Fləşkartı marker-dən AVTOMATİK tanıyır ✓ → içindəki bazanı oxuyub çatışmayan qeydləri proqrama əlavə edir ✓ → sonra bazanın TAM surətini USB-nin özünə yazır ✓✓✓ (internet lazım deyil ✓)"
                            Command="{Binding UsbTaxVeOkuCommand}"/>
                                        </UniformGrid>

                                        <Button Content="💾  Verilənlər bazasını USB-yə kopyala" Style="{StaticResource iOSButton}"
                                                Height="30" Margin="0,6,0,0" Background="#065F46" Foreground="#D1FAE5"
                                                Cursor="Hand" HorizontalContentAlignment="Left" Padding="12,0"
                                                ToolTip="Bazanın TAM surətini USB-yə yazır ✓ → D:\021cars_data.db + D:\data\backup.db ✓ (WAL daxil ✓)"
                                                Command="{Binding UsbBazaKopyalaCommand}"/>

                                        <Button Content="📂  Əl ilə seç (qovluq pəncərəsi)" Style="{StaticResource iOSButton}"
                                                Height="30" Margin="0,6,0,0" Background="#1E3A8A" Foreground="#DBEAFE"
                                                Cursor="Hand" HorizontalContentAlignment="Left" Padding="12,0"
                                                ToolTip="Siyahıda USB görünmürsə ✓ — pəncərədən fləşkartı birbaşa seçin ✓, kök avtomatik tapılır ✓"
                                                Command="{Binding UsbQovluqSecCommand}"/>

                                        <Button Content="➖  DATA USB-ni sil (qeydiyyatdan çıxar)" Style="{StaticResource iOSButton}"
                                                Height="30" Margin="0,6,0,0" Background="#7F1D1D" Foreground="#FECACA"
                                                Cursor="Hand" HorizontalContentAlignment="Left" Padding="12,0"
                                                ToolTip="Qeydiyyatı və gizli marker faylını silir ✓"
                                                Command="{Binding UsbSilCommand}"/>

                                        <TextBlock Text="{Binding UsbMesaji}" FontSize="10.5" Foreground="#34D399"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </TabItem>
                <!-- ============================================================ -->
                <!-- 📜 TAB: SKRİPT İDXALI (JSON) ✓✓✓                             -->
                <!--   ① skripti yapışdır ② «🔎 Yoxla» ③ «📥 İdxal et» ✓          -->
                <!--   Avtomobil · xərc · tarix · qeyd — HAMISI avtomatik ✓✓✓      -->
                <!-- ============================================================ -->
                <TabItem Header="📜 Skript İdxalı">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <!-- 🚀 «*» → pəncərə hündürlüyünə uyğunlaşır ✓ (donma yoxdur ✓) -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ① BAŞLIQ + DÜYMƏLƏR -->
                        <Border Grid.Row="0" Background="#0F172A" CornerRadius="10"
                                BorderBrush="#1F2937" BorderThickness="1" Padding="14,10">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                           VerticalAlignment="Center">
                                    <Button Content="🔎  Yoxla" Command="{Binding Skript.YoxlaCommand}"
                                            Style="{StaticResource iOSButton}" Height="32" Padding="14,0"
                                            Background="#0891B2" Foreground="White" Margin="0,0,6,0"
                                            Cursor="Hand"
                                            ToolTip="YALNIZ yoxlayır ✓ — bazaya heç nə yazılmır ✗ (nə olacağı göstərilir ✓)"/>
                                    <Button Content="📥  İdxal et" Command="{Binding Skript.IdxalEtCommand}"
                                            Style="{StaticResource iOSButton}" Height="32" Padding="18,0"
                                            Background="#10B981" Foreground="White" Margin="0,0,6,0"
                                            Cursor="Hand"
                                            ToolTip="Skriptdəki maşınları · xərcləri · tarixləri · qeydləri proqrama YAZIR ✓✓✓"/>
                                    <Button Content="📋  Nümunə" Command="{Binding Skript.NumuneYukleCommand}"
                                            Style="{StaticResource iOSButton}" Height="32" Padding="12,0"
                                            Background="#1E3A8A" Foreground="#DBEAFE" Margin="0,0,6,0"
                                            Cursor="Hand"
                                            ToolTip="Formatı göstərən nümunə skripti yapışdırır ✓"/>
                                    <Button Content="🧹  Təmizlə" Command="{Binding Skript.TemizleCommand}"
                                            Style="{StaticResource iOSButton}" Height="32" Padding="12,0"
                                            Background="#1F2937" Foreground="#E2E8F0" Cursor="Hand"
                                            ToolTip="Skripti və hesabatı təmizləyir ✓"/>
                                </WrapPanel>

                                <StackPanel>
                                    <TextBlock Text="📜 SKRİPT İDXALI  ·  JSON → maşınlar · xərclər · tarixlər · qeydlər"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="{Binding Skript.StatusMetni}" FontSize="11.5"
                                               Foreground="#9CA3AF" TextWrapping="Wrap" MaxWidth="820"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- ② NƏTİCƏ KARTLARI -->
                        <UniformGrid Grid.Row="1" Columns="5" Margin="0,10,0,0"
                                     Visibility="{Binding Skript.NeticeVar, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#3B82F6">
                                <StackPanel>
                                    <TextBlock Text="🚗 Yazılan maşın" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding Skript.ElaveOlunanMasin}"
                                               Style="{StaticResource StatValue}" Foreground="#60A5FA"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#10B981">
                                <StackPanel>
                                    <TextBlock Text="🧾 Xərc sətri" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding Skript.ElaveOlunanXerc}"
                                               Style="{StaticResource StatValue}" Foreground="#34D399"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#F59E0B">
                                <StackPanel>
                                    <TextBlock Text="➕ Yeni kateqoriya" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding Skript.YeniKateqoriya}"
                                               Style="{StaticResource StatValue}" Foreground="#FBBF24"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#A855F7">
                                <StackPanel>
                                    <TextBlock Text="⏭️ Keçilən (artıq var)" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding Skript.KecirilenMasin}"
                                               Style="{StaticResource StatValue}" Foreground="#C084FC"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" Margin="4" BorderBrush="#06B6D4">
                                <StackPanel>
                                    <TextBlock Text="⛓️ ÜMUMİ MAYA" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding Skript.UmumiMaya, Converter={StaticResource Currency}}"
                                               Style="{StaticResource StatValue}" Foreground="#22D3EE"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <!-- ③ SKRİPT (sol) + HESABAT (sağ) -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0B0F17" CornerRadius="10"
                                    BorderBrush="#1F2937" BorderThickness="1" Padding="10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="📜 SKRİPT  ·  JSON mətnini buraya yapışdırın (Ctrl+V ✓)"
                                               FontSize="12" FontWeight="Bold" Foreground="#6B7280"
                                               Margin="2,0,0,6"/>
                                    <TextBlock DockPanel.Dock="Bottom"
                                               Text="💡 Sahələr: MarkaModel · DovletNomresi · Il · AlisTarixi · AlisQiymeti · Xercler [ Təsvir · Tarix · Məbləğ ] · Qeydler ✓  —  Tarix formatı: 09.07.2023 ✓"
                                               FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap"
                                               Margin="2,6,2,0"/>
                                    <TextBox Text="{Binding Skript.SkriptMetni, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" AcceptsTab="True"
                                             TextWrapping="NoWrap" FontFamily="Consolas"
                                             FontSize="12" Padding="8" MinHeight="240"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             ToolTip="Skripti buraya yapışdırın ✓ — sonra «🔎 Yoxla» basın ✓"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#0B0F17" CornerRadius="10"
                                    BorderBrush="#1F2937" BorderThickness="1" Padding="10"
                                    Margin="10,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="📊 NƏTİCƏ HESABATI  ·  sətir-sətir (maşın · xərc · kateqoriya · qeyd ✓)"
                                               FontSize="12" FontWeight="Bold" Foreground="#6B7280"
                                               Margin="2,0,0,6"/>
                                    <TextBox Text="{Binding Skript.HesabatMetni}"
                                             IsReadOnly="True" AcceptsReturn="True"
                                             TextWrapping="Wrap" FontFamily="Consolas"
                                             FontSize="11.5" Padding="8" MinHeight="240"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Background="#0F172A" Foreground="#CBD5E1"
                                             ToolTip="«🔎 Yoxla» və ya «📥 İdxal et» basdıqdan sonra nəticə burada görünür ✓"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>

        <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" BorderBrush="#1F2937" BorderThickness="1" Padding="16,8" Margin="0,12,0,0">
            <DockPanel>
                <Button x:Name="BtnFullScreen" DockPanel.Dock="Right" Content="⛶ Tam Ekran" Style="{StaticResource iOSButton}"
                        Height="32" Padding="14,0" Background="#1F2937" Foreground="#F8FAFC"
                        Click="BtnFullScreen_Click"/>
                <!-- ============================================================ -->
                <!-- 🚀 GÜNCƏLLƏMƏ DÜYMƏSİ ✓✓✓ — basanda yoxlama pəncərəsi açılır ✓ -->
                <!--    🟢 ən son versiya ✓ · 🟡 yeni versiya var ✓ · 🔴 yoxlanıla bilmədi ✗ -->
                <!-- ============================================================ -->
                <Button x:Name="BtnGuncelleme" DockPanel.Dock="Right" Style="{StaticResource iOSButton}"
                        Height="32" Padding="12,0" Margin="0,0,10,0" Background="#1F2937" Foreground="#F8FAFC"
                        Cursor="Hand" Click="BtnGuncelleme_Click"
                        ToolTip="🚀 GÜNCƏLLƏMƏ — basanda GitHub yoxlanılır ✓ (avtomatik: hər 30 dəqiqədə ✓)">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DaireGuncelleme" Width="11" Height="11" Fill="#64748B"
                                 Stroke="#0B1220" StrokeThickness="1.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GuncellemeMetni" Text="🚀 Güncəlləmə" Margin="7,0,0,0"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock x:Name="VersiyaMetni" DockPanel.Dock="Right" Text="Avtomobil Parkı v6.2.2" Foreground="#6B7280" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- ============================================================ -->
                <!-- 🟢🔴🟠 SİNXRON STATUSU — «Avtomobil Parkı» yazısının SOLUNDA ✓ -->
                <!-- 🖥️ kompüter (sol) · 💾 flash USB (orta) · 🔥 firebase (sağ) ✓ -->
                <!-- 🟢 yaşıl = sinxronlaşıb ✓ · 🔴 qırmızı = əlaqə yoxdur ✗     -->
                <!-- 🟠 narıncı = dəyişiklik var, hələ sinxron olmayıb ✓          -->
                <!-- ============================================================ -->
                <Border DockPanel.Dock="Right" Background="#0B1220" CornerRadius="12" Padding="10,4"
                        BorderBrush="#1F2937" BorderThickness="1" VerticalAlignment="Center"
                        Margin="0,0,4,0" IsHitTestVisible="False">
                    <StackPanel Orientation="Vertical">

                        <StackPanel Orientation="Horizontal">

                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                    ToolTip="🖥️ KOMPÜTER (yerli baza) — 🟢 işləyir ✓ · 🔴 işləmir ✗">
                            <Ellipse x:Name="DaireYerli" Width="14" Height="14" Fill="#22C55E"
                                     Stroke="#0B1220" StrokeThickness="1.5" VerticalAlignment="Center"/>
                            <TextBlock Text="🖥️" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                    ToolTip="💾 FLASH USB — 🟢 yazılıb ✓ · 🟠 yazılır ✓ · 🔴 taxılmayıb ✗">
                            <Ellipse x:Name="DaireUsb" Width="14" Height="14" Fill="#22C55E"
                                     Stroke="#0B1220" StrokeThickness="1.5" VerticalAlignment="Center"/>
                            <TextBlock Text="💾" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    ToolTip="🔥 FIREBASE (bulud) — 🟢 sinxron ✓ · 🟠 dəyişiklik var, hələ sinxron olmayıb ✓ · 🔴 əlaqə yoxdur ✗">
                            <Ellipse x:Name="DaireBulud" Width="14" Height="14" Fill="#22C55E"
                                     Stroke="#0B1220" StrokeThickness="1.5" VerticalAlignment="Center"/>
                            <TextBlock Text="🔥" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="DaireMetni" FontSize="10" Foreground="#94A3B8"
                                   VerticalAlignment="Center" Margin="8,0,2,0"/>
                        </StackPanel>

                        <!-- ============================================================ -->
                        <!-- 📊 NAZİK LOADING BAR (3 piksel ✓) — sinxron gedərkən görünür ✓ -->
                        <!-- ============================================================ -->
                        <ProgressBar x:Name="SinxronZolaq" Height="3" Margin="0,4,0,0"
                                     Minimum="0" Maximum="100" IsIndeterminate="True"
                                     Background="#1F2937" Foreground="#38BDF8" BorderThickness="0"
                                     Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <!-- ℹ️ Saatlı «Yenilənir...» status mətni GÖSTƏRİLMİR ✗✓✓ — əvəzinə sinxron dairələrinin
                         altında NAZİK LOADING BAR var ✓ (yalnız sinxron gedərkən görünür ✓) -->

                    <!-- ================= 🖐️ SOL AŞAĞI: İSTİFADƏÇİ + ÇIXIŞ ✓✓✓ ================= -->
                    <Border Background="#111827" CornerRadius="8" Padding="10,3" Margin="18,0,0,0"
                            VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1"
                            ToolTip="Daxil olmuş istifadəçi və rolu ✓">
                        <TextBlock Text="{Binding IstifadeciMetni}" Foreground="#38BDF8"
                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="🚪 Çıxış et" Style="{StaticResource iOSButton}" Height="30" Padding="14,0"
                            Margin="8,0,0,0" Background="#7F1D1D" Foreground="#FECACA" Cursor="Hand"
                            ToolTip="Çıxış (Sign out) — proqram yenidən açılır və GİRİŞ pəncərəsi gəlir ✓"
                            Command="{Binding CixisEtCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

