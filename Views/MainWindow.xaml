                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource GridCellComboBox}"
                                                          IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName"
                                                          ItemsSource="{Binding DataContext.Expenses.AvailableCars, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
