                                                           FontSize="17" FontWeight="Bold" Foreground="#FB923C"/>
                                                <TextBlock Text="bütün ödənişlər içindəki faiz payı" FontSize="9.5"
                                                           Foreground="#64748B" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
