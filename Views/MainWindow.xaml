                                            BorderBrush="#34D399" BorderThickness="1.5">
                                        <StackPanel>
                                            <TextBlock Text="✅ ÖDƏNİLMİŞ (bütün vaxt)" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                            <TextBlock Text="{Binding Kassa.OdenilmisCem, Converter={StaticResource Currency}}"
                                                       FontSize="19" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                                            <TextBlock FontSize="9.5" Foreground="#64748B" Text="artıq kassaya daxil olub ✓"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- ========== ⏳ GÖZLƏNİLƏN MÖHLƏTLƏR (cədvəl) ========== -->
